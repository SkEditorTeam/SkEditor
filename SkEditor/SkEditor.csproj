<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <ApplicationManifest>Properties/app.manifest</ApplicationManifest>
        <ApplicationIcon>Assets\SkEditor.ico</ApplicationIcon>
        <PublishSingleFile>true</PublishSingleFile>
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
        <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <PublishAot>true</PublishAot>

        <VersionPrefix>3.0.0</VersionPrefix>
        <VersionSuffix>alpha.1</VersionSuffix>
        <AssemblyVersion>2.99.0</AssemblyVersion>
        <FileVersion>$(AssemblyVersion)</FileVersion>

        <InformationalVersion Condition="'$(VersionSuffix)' != ''">$(VersionPrefix)-$(VersionSuffix)</InformationalVersion>
        <InformationalVersion Condition="'$(VersionSuffix)' == ''">$(VersionPrefix)</InformationalVersion>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <InvariantGlobalization>false</InvariantGlobalization>
        <OptimizationPreference>Speed</OptimizationPreference>
        <IlcGenerateStackTraceData>false</IlcGenerateStackTraceData>
    </PropertyGroup>

    <PropertyGroup Condition="'$(PublishAot)' == 'true'">
        <DefineConstants>$(DefineConstants);AOT</DefineConstants>
        <PublishTrimmed>true</PublishTrimmed>
        <TrimMode>full</TrimMode>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release' And '$(PublishAot)' == 'false'">
        <PublishReadyToRun>true</PublishReadyToRun>
        <PublishSingleFile>true</PublishSingleFile>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaXaml Remove="Assets\*.axaml"/>
        <AvaloniaResource Include="Styles\**"/>

        <AvaloniaResource Include="Assets\**"/>
    </ItemGroup>

    <ItemGroup>
        <Content Include="Languages\**" Exclude="Languages\English.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <EmbeddedResource Include="Languages\English.json"/>
        <AdditionalFiles Include="Languages\English.json"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.0.2"/>
        <PackageReference Include="Avalonia.Desktop" Version="12.0.2"/>
        <PackageReference Include="Avalonia.Markup.Xaml.Loader" Version="12.0.2"/>
        <PackageReference Include="Avalonia.Controls.ItemsRepeater" Version="12.0.0"/>
        <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.0.2"/>
        <PackageReference Condition="'$(Configuration)' == 'Debug'" Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.1"/>

        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.2"/>
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.2"/>
        <PackageReference Include="SkFluentIcons.Avalonia.Fluent" Version="2.0.972"/>
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.7"/>
        <PackageReference Include="Xaml.Behaviors.Avalonia" Version="12.0.0"/>
        <PackageReference Include="AsyncImageLoader.Avalonia" Version="3.8.0"/>
        <!--        <PackageReference Include="SkAvaloniaEdit" Version="12.0.0-rc4" />-->
        <!--        <PackageReference Include="SkFluentAvalonia" Version="3.0.0-preview1"/>-->

        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2"/>
        <PackageReference Include="Octokit" Version="14.0.0"/>
        <PackageReference Include="Serilog" Version="4.3.1"/>
        <PackageReference Include="Serilog.Sinks.File" Version="7.0.0"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.7"/>
        <PackageReference Include="SSH.NET" Version="2025.1.0"/>
        <PackageReference Include="Devlooped.CredentialManager" Version="2.7.0"/>

        <PackageReference Include="HotAvalonia" Version="3.1.0" PrivateAssets="All"/>
        <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.116.1" Condition="'$(RuntimeIdentifier)' == 'linux-x64'"/>

        <PackageReference Include="Xaml.Behaviors.SourceGenerators" Version="12.0.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>

        <PackageReference Include="Svg.Controls.Skia.Avalonia" Version="12.0.0.6">
            <ExcludeAssets>none</ExcludeAssets>
        </PackageReference>
        <PackageReference Include="Svg.Skia" Version="4.6.0">
            <ExcludeAssets>none</ExcludeAssets>
        </PackageReference>
        <PackageReference Include="Svg.Animation" Version="4.6.0">
            <IncludeAssets>none</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Svg.JavaScript" Version="4.6.0">
            <IncludeAssets>none</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Jint" Version="4.8.0">
            <IncludeAssets>none</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\External\DiscordRPC\DiscordRPC.csproj"/>
        <ProjectReference Include="..\External\SkFluentAvalonia\src\FluentAvalonia\FluentAvalonia.csproj"/>
        <ProjectReference Include="..\External\SkAvaloniaEdit\src\AvaloniaEdit\AvaloniaEdit.csproj"/>
        <ProjectReference Include="..\External\SkAvaloniaEdit\src\AvaloniaEdit.TextMate\AvaloniaEdit.TextMate.csproj"/>
        <ProjectReference Include="..\SkEditor.SourceGenerators\SkEditor.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" Properties="PublishAot=false"/>
    </ItemGroup>
</Project>