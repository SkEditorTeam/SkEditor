<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <WarningsAsErrors>Nullable</WarningsAsErrors>
        <LangVersion>latest</LangVersion>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <ApplicationManifest>Properties/app.manifest</ApplicationManifest>
        <ApplicationIcon>Assets\SkEditor.ico</ApplicationIcon>
        <PublishSingleFile>true</PublishSingleFile>
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
        <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <PublishAot>true</PublishAot>

        <VersionPrefix>3.0.0</VersionPrefix>
        <VersionSuffix>alpha.22</VersionSuffix>
        <AssemblyVersion>2.99.22</AssemblyVersion>
        <FileVersion>$(AssemblyVersion)</FileVersion>

        <InformationalVersion Condition="'$(VersionSuffix)' != ''">$(VersionPrefix)-$(VersionSuffix)</InformationalVersion>
        <InformationalVersion Condition="'$(VersionSuffix)' == ''">$(VersionPrefix)</InformationalVersion>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <InvariantGlobalization>false</InvariantGlobalization>
        <OptimizationPreference>Speed</OptimizationPreference>
        <IlcGenerateStackTraceData>false</IlcGenerateStackTraceData>
    </PropertyGroup>

    <PropertyGroup Condition="'$(PublishAot)' == 'true'">
        <DefineConstants>$(DefineConstants);AOT</DefineConstants>
        <PublishTrimmed>true</PublishTrimmed>
        <TrimMode>full</TrimMode>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release' And '$(PublishAot)' == 'false'">
        <PublishReadyToRun>true</PublishReadyToRun>
        <PublishSingleFile>true</PublishSingleFile>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaXaml Remove="Assets\*.axaml" />
        <AvaloniaResource Include="Styles\**" />

        <AvaloniaResource Include="Assets\**" Exclude="Assets\SkEditor.svg" />
        <AdditionalFiles Include="Assets\SkEditor.svg" NamespaceName="SkEditor.Assets" ClassName="SkEditor" />
    </ItemGroup>

    <!-- Open Sans is not included in Windows builds -->
    <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('win')) Or $(TargetFramework.Contains('windows'))">
        <AvaloniaResource Remove="Assets/Fonts/OpenSans/**" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="Languages\**" Exclude="Languages\English.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <EmbeddedResource Include="Languages\English.json" />
        <AdditionalFiles Include="Integrations\Publishing\UI\PublishWindow.axaml" />
        <AdditionalFiles Include="Languages\English.json" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.3" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
        <PackageReference Include="Avalonia.Wayland" Version="12.1.3" />
        <PackageReference Include="Avalonia.Controls.ItemsRepeater" Version="12.0.0" />
        <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.3" />
        <PackageReference Condition="'$(Configuration)' == 'Debug'" Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />

        <PackageReference Include="AsyncImageLoader.Avalonia" Version="4.0.0" />
        <PackageReference Include="Skia.Controls.Avalonia" Version="12.0.0.17" />

        <PackageReference Include="System.IO.Hashing" Version="10.0.13" />
        <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
        <PackageReference Include="TestableIO.System.IO.Abstractions.Wrappers" Version="22.3.0" />

        <PackageReference Include="Octokit" Version="14.0.0" />
        <PackageReference Include="SSH.NET" Version="2026.0.0" />
        <PackageReference Include="SkTerminal" Version="1.0.1" />
        <PackageReference Include="SkDiscordRPC" Version="1.0.0" />

        <PackageReference Include="Serilog" Version="4.4.0" />
        <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
        <PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
        <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />

        <PackageReference Include="HotAvalonia" Version="3.1.5" PrivateAssets="All" Publish="True" />
        <PackageReference Include="Avalonia.Markup.Xaml.Loader" Version="12.1.3" PrivateAssets="All" Publish="True" />

        <PackageReference Include="Xaml.Behaviors.Avalonia" Version="12.0.7" />
        <PackageReference Include="Xaml.Behaviors.SourceGenerators" Version="12.0.7">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>

        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <PackageReference Include="R3" Version="1.3.1" />
        <PackageReference Include="R3Extensions.Avalonia" Version="1.3.1" />
        <PackageReference Include="ObservableCollections" Version="3.3.4" />
        <PackageReference Include="ObservableCollections.R3" Version="3.3.4" />

        <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4" Condition="'$(RuntimeIdentifier)' == 'linux-x64'" />

        <PackageReference Include="SkFluentAvalonia" Version="3.1.0" />
        <PackageReference Include="FluentIcons.Avalonia.Fluent" Version="2.1.341" />
        <PackageReference Include="FluentAvaloniaUI" Version="3.0.0" ExcludeAssets="compile;runtime" />

        <PackageReference Include="SkAvaloniaEdit" Version="12.0.0-rc5" />
        <PackageReference Include="SkAvaloniaEdit.TextMate" Version="12.0.0-rc5" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\SkEditor.Matcher\SkEditor.Matcher.csproj" />
        <ProjectReference Include="..\SkEditor.SourceGenerators\SkEditor.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" Properties="PublishAot=false" />
