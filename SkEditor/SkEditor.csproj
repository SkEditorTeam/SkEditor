<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <ApplicationManifest>Properties/app.manifest</ApplicationManifest>
        <ApplicationIcon>Assets\SkEditor.ico</ApplicationIcon>
        <PublishSingleFile>true</PublishSingleFile>
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
        <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <PublishAot>false</PublishAot>

        <VersionPrefix>3.0.0</VersionPrefix>
        <VersionSuffix>alpha.1</VersionSuffix>
        <AssemblyVersion>$(VersionPrefix).0</AssemblyVersion>
        <FileVersion>$(VersionPrefix).0</FileVersion>

        <InformationalVersion Condition="'$(VersionSuffix)' != ''">$(VersionPrefix)-$(VersionSuffix)</InformationalVersion>
        <InformationalVersion Condition="'$(VersionSuffix)' == ''">$(VersionPrefix)</InformationalVersion>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <PublishTrimmed>true</PublishTrimmed>
        <TrimMode>full</TrimMode>
        <InvariantGlobalization>false</InvariantGlobalization>
        <OptimizationPreference>Speed</OptimizationPreference>
        <IlcGenerateStackTraceData>false</IlcGenerateStackTraceData>
    </PropertyGroup>

    <PropertyGroup Condition="'$(PublishAot)' == 'true'">
        <DefineConstants>$(DefineConstants);AOT</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaXaml Remove="Assets\*.axaml"/>
        <AvaloniaResource Include="Assets\**"/>
        <AvaloniaResource Include="Styles\**"/>
    </ItemGroup>

    <ItemGroup>
        <Content Include="Languages\**" Exclude="Languages\English.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <EmbeddedResource Include="Languages\English.json"/>
        <AdditionalFiles Include="Languages\English.json"/>
    </ItemGroup>

    <ItemGroup>
        <!-- Avalonia -->
        <PackageReference Include="Avalonia" Version="11.3.12"/>
        <PackageReference Include="Avalonia.Desktop" Version="11.3.12"/>
        <PackageReference Include="Avalonia.Markup.Xaml.Loader" Version="11.3.12"/>
        <PackageReference Include="Avalonia.Controls.ItemsRepeater" Version="11.1.5"/>
        <PackageReference Include="Avalonia.Controls.ColorPicker" Version="11.3.12"/>
        <PackageReference Condition="'$(Configuration)' == 'Debug'" Include="Avalonia.Diagnostics" Version="11.3.12"/>

        <!-- UI, styling -->
        <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.12"/>
        <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.12"/>
        <PackageReference Include="Devlooped.CredentialManager" Version="2.6.1.1" />
        <PackageReference Include="FluentIcons.Avalonia.Fluent" Version="2.0.319">
            <PrivateAssets>none</PrivateAssets>
            <ExcludeAssets>none</ExcludeAssets>
            <IncludeAssets>runtime; compile; native</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.3" />
        <PackageReference Include="SSH.NET" Version="2025.1.0"/>
        <PackageReference Include="Xaml.Behaviors.Avalonia" Version="11.3.9.5"/>
        <PackageReference Include="AsyncImageLoader.Avalonia" Version="3.6.0"/>
        <PackageReference Include="Avalonia.Svg.Skia" Version="11.3.0"/>
        <PackageReference Include="Svg.Skia" Version="3.4.1"/>
        <PackageReference Include="SkAvaloniaEdit" Version="11.3.3"/>

        <!-- Libraries -->
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0"/>
        <PackageReference Include="Octokit" Version="14.0.0"/>
        <PackageReference Include="Serilog.Sinks.File" Version="7.0.0"/>
        <PackageReference Include="HotAvalonia" Version="3.1.0" PrivateAssets="All"/>
        <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.116.1" Condition="'$(RuntimeIdentifier)' == 'linux-x64'"/>

        <!-- Exclude to use local fork -->
        <PackageReference Include="FluentAvaloniaUI" Version="2.0.0">
            <PrivateAssets>all</PrivateAssets>
            <ExcludeAssets>all</ExcludeAssets>
        </PackageReference>
    </ItemGroup>
    
    <PropertyGroup>
        <HotAvalonia>true</HotAvalonia>
        <HotAvaloniaMode>Minimal</HotAvaloniaMode>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\External\DiscordRPC\DiscordRPC.csproj"/>
        <ProjectReference Include="..\External\SkFluentAvalonia\src\FluentAvalonia\FluentAvalonia.csproj"/>
        <ProjectReference Include="..\SkEditor.SourceGenerators\SkEditor.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
    </ItemGroup>

    <PropertyGroup>
        <AllowedReferenceRelatedFileExtensions>.dll;.exe</AllowedReferenceRelatedFileExtensions>
    </PropertyGroup>
</Project>