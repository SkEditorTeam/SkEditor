<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:icons="clr-namespace:FluentIcons.Avalonia.Fluent.Markup;assembly=FluentIcons.Avalonia.Fluent"
             DataContext="{Binding RelativeSource={RelativeSource Self}}"
             x:Class="SkEditor.Views.Controls.ColorPickerSettingsExpander">

    <ui:FASettingsExpander Header="{Binding ExpanderHeader}" Name="SettingsExpanderObject"
                           IconSource="{icons:SymbolIconSource Symbol=Color}">
        <ui:FASettingsExpander.Footer>
            <ColorPicker Name="ColorPicker" IsAlphaEnabled="{Binding IsAlphaEnabled}"
                         IsAlphaVisible="{Binding IsAlphaEnabled}" />
        </ui:FASettingsExpander.Footer>
    </ui:FASettingsExpander>
</UserControl>