<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:icons="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
             xmlns:converters1="clr-namespace:SkEditor.Appearance.Icons.Converters"
             xmlns:behaviors1="clr-namespace:SkEditor.Appearance.Behaviors"
             xmlns:ui="clr-namespace:SkEditor.Configuration.UI"
             xmlns:converters2="clr-namespace:SkEditor.Configuration.Converters"
             xmlns:models1="clr-namespace:SkEditor.Configuration.Models"
             xmlns:types1="clr-namespace:SkEditor.Configuration.Models.Types"
             mc:Ignorable="d" d:DesignWidth="800"
             x:CompileBindings="True"
             x:DataType="ui:SettingsTabViewModel"
             Focusable="True"
             x:Class="SkEditor.Configuration.UI.SettingsTabView">

    <UserControl.Resources>
        <!-- ReSharper disable Xaml.RedundantResource -->
        <SolidColorBrush x:Key="NavigationViewContentBackground">Transparent</SolidColorBrush>
        <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush">Transparent</SolidColorBrush>
        <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
        <Thickness x:Key="SettingsExpanderPadding">16</Thickness>
        <GridLength x:Key="ToggleSwitchPreContentMargin">2</GridLength>
        <GridLength x:Key="ToggleSwitchPostContentMargin">2</GridLength>
        <!-- ReSharper restore Xaml.RedundantResource -->
        <converters1:StandardIconSourceConverter x:Key="StandardIconSourceConverter" />
        <converters2:InfoBarSeverityConverter x:Key="InfoBarSeverityConverter" />
        <converters2:HorizontalAlignmentConverter x:Key="HorizontalAlignmentConverter" />
        <converters2:OrientationConverter x:Key="OrientationConverter" />

        <converters2:SettingIconConverter x:Key="SettingIconConverter" />
        <converters2:SettingsFontFamilyConverter x:Key="SettingsFontFamilyConverter" />
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="controls|FASettingsExpanderItem /template/ ContentPresenter#FooterPresenter"
               x:DataType="models1:SettingElement">
            <Setter Property="MaxWidth" Value="500" />
            <Setter Property="Width" Value="{Binding Width, FallbackValue=Auto}" />
        </Style>

        <Style Selector="controls|FASettingsExpander /template/ ContentPresenter#FooterPresenter">
            <Setter Property="MaxWidth" Value="500" />
        </Style>

        <Style Selector="controls|FANavigationView /template/ ScrollViewer#MenuItemsScrollViewer">
            <Setter Property="Interaction.Behaviors">
                <BehaviorCollectionTemplate>
                    <BehaviorCollection>
                        <behaviors1:SmoothScrollBehavior />
                    </BehaviorCollection>
                </BehaviorCollectionTemplate>
            </Setter>
        </Style>

        <Style Selector="controls|FANavigationView /template/ ScrollViewer#FooterItemsScrollViewer">
            <Setter Property="Interaction.Behaviors">
                <BehaviorCollectionTemplate>
                    <BehaviorCollection>
                        <behaviors1:SmoothScrollBehavior />
                    </BehaviorCollection>
                </BehaviorCollectionTemplate>
            </Setter>
        </Style>
    </UserControl.Styles>

    <UserControl.DataTemplates>
        <DataTemplate DataType="{x:Type types1:ToggleSetting}">
            <ToggleSwitch IsChecked="{Binding IsToggled.Value}" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type types1:IFontChoiceSetting}">
            <ComboBox ItemsSource="{Binding Options}"
                      Width="{Binding Width, FallbackValue=NaN}"
                      MaxWidth="{Binding MaxWidth, FallbackValue=NaN}"
                      SelectedItem="{Binding SelectedItem}">
                <ComboBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type types1:OptionItem}">
                        <TextBlock Text="{Binding Display.Value}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>

                <ComboBox.Styles>
                    <Style Selector="ComboBox /template/ Popup#PART_Popup">
                        <Setter Property="Width" Value="{Binding $parent[ComboBox].MaxWidth}" />
                    </Style>

                    <Style Selector="ComboBox ComboBoxItem" x:DataType="types1:OptionItem">
                        <Setter Property="FontFamily"
                                Value="{Binding Value, Converter={StaticResource SettingsFontFamilyConverter}}" />
                        <Setter Property="Height" Value="32" />
                        <Setter Property="Padding" Value="12,0" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                    </Style>
                </ComboBox.Styles>
            </ComboBox>
        </DataTemplate>

        <DataTemplate DataType="{x:Type types1:IChoiceSetting}">
            <ComboBox ItemsSource="{Binding Options}"
                      Width="{Binding Width, FallbackValue=NaN}"
                      MaxWidth="{Binding MaxWidth, FallbackValue=NaN}"
                      SelectedItem="{Binding SelectedItem}">
                <ComboBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type types1:OptionItem}">
                        <TextBlock Text="{Binding Display.Value}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>

                <ComboBox.Styles>
                    <Style Selector="ComboBox /template/ Popup#PART_Popup">
                        <Setter Property="Width" Value="{Binding $parent[ComboBox].MaxWidth}" />
                    </Style>

                    <Style Selector="ComboBox ComboBoxItem" x:DataType="types1:OptionItem">
                        <Setter Property="Height" Value="32" />
                        <Setter Property="Padding" Value="12,0" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                    </Style>
                </ComboBox.Styles>
            </ComboBox>
        </DataTemplate>

        <DataTemplate DataType="{x:Type types1:INumberSetting}">
            <NumericUpDown Minimum="{Binding MinValue}"
                           Maximum="{Binding MaxValue}"
                           FormatString="{Binding FormatString}"
                           Value="{Binding Value, Mode=TwoWay}" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type types1:TextSetting}">
            <TextBox Text="{Binding Text, Mode=TwoWay}" PasswordChar="{Binding PasswordChar}"
                     PlaceholderText="{Binding Placeholder.Value, FallbackValue={x:Null}}"
                     Width="{Binding Width, FallbackValue=96}"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Center" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type types1:ActionSetting}">
            <Button Command="{Binding Command}"
                    IsVisible="{Binding IsButtonVisible.Value}">
                <StackPanel Spacing="6" Orientation="Horizontal">
                    <TextBlock Text="{Binding Text}" FontSize="14" />
                    <icons:SymbolIcon Symbol="Open" FontSize="13" IsVisible="{Binding IsExternal}"
                                      VerticalAlignment="Center" Margin="0,1,0,0" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <DataTemplate DataType="{x:Type types1:CompoundSetting}">
            <ItemsControl ItemsSource="{Binding Children}">
                <ItemsControl.Styles>
                    <Style Selector="ContentControl > :is(Control)">
                        <Setter Property="HorizontalAlignment"
                                Value="{Binding $parent[ItemsControl].((types1:CompoundSetting)DataContext).IsVertical, Converter={StaticResource HorizontalAlignmentConverter}, FallbackValue=Right}" />
                    </Style>
                </ItemsControl.Styles>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="{Binding IsVertical, Converter={StaticResource OrientationConverter}}"
                                    Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="models1:SettingElement">
                        <ContentControl Content="{Binding}" IsVisible="{Binding IsVisible.Value}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>
    </UserControl.DataTemplates>

    <controls:FANavigationView Name="NavigationView" VerticalAlignment="Stretch" Margin="16,24,0,16"
                               PaneDisplayMode="Auto" OpenPaneLength="250"
                               ExpandedModeThresholdWidth="800"
                               CompactModeThresholdWidth="250"
                               MaxWidth="1080"
                               MenuItemsSource="{Binding SettingsCategories}"
                               SelectedItem="{Binding CurrentSection, Mode=TwoWay}"
                               IsSettingsVisible="False" IsPaneToggleButtonVisible="False">
        <controls:FANavigationView.MenuItemTemplate>
            <DataTemplate DataType="models1:SettingSection">
                <controls:FANavigationViewItem Content="{Binding Name.Value}"
                                               IsExpanded="{Binding IsExpanded.Value, Mode=TwoWay}"
                                               IsVisible="{Binding IsVisible.Value}"
                                               SelectsOnInvoked="{Binding Selectable}"
                                               IconSource="{Binding Icon, Converter={StaticResource StandardIconSourceConverter}}"
                                               MenuItemsSource="{Binding Subsections}" />
            </DataTemplate>
        </controls:FANavigationView.MenuItemTemplate>

        <controls:FANavigationView.Content>
            <ScrollViewer Name="ScrollViewer" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                          Padding="24,4,24,24" VerticalScrollBarVisibility="Auto">
                <Interaction.Behaviors>
                    <behaviors1:SmoothScrollBehavior />
                </Interaction.Behaviors>
                <ItemsRepeater ItemsSource="{Binding CurrentSection.Settings, FallbackValue={x:Null}}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="8" Orientation="Vertical" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <ui:SettingElementTemplateFactory>
                            <ui:SettingElementTemplateFactory.Templates>
                                <DataTemplate x:Key="StandardTemplate" x:DataType="models1:SettingElement">
                                    <controls:FASettingsExpander
                                        Header="{Binding Name.Value.Value}"
                                        IsVisible="{Binding IsVisible.Value}" IsEnabled="{Binding IsEnabled.Value}"
                                        Description="{Binding Description.Value.Value, FallbackValue='{x:Null}'}"
                                        Footer="{Binding}">
                                        <controls:FASettingsExpander.IconSource>
                                            <MultiBinding Converter="{StaticResource SettingIconConverter}">
                                                <Binding Path="Status.Value" />
                                                <Binding Path="Icon" />
                                            </MultiBinding>
                                        </controls:FASettingsExpander.IconSource>
                                    </controls:FASettingsExpander>
                                </DataTemplate>

                                <DataTemplate x:Key="ClickableTemplate" x:DataType="types1:ClickableActionSetting">
                                    <controls:FASettingsExpander
                                        Header="{Binding Name.Value.Value}"
                                        IsVisible="{Binding IsVisible.Value}" IsEnabled="{Binding IsEnabled.Value}"
                                        ActionIconSource="{Binding ActionIcon, Converter={StaticResource StandardIconSourceConverter}}"
                                        Description="{Binding Description.Value.Value, FallbackValue='{x:Null}'}"
                                        IsClickEnabled="True"
                                        Command="{Binding Command}">
                                        <controls:FASettingsExpander.IconSource>
                                            <MultiBinding Converter="{StaticResource SettingIconConverter}">
                                                <Binding Path="Status.Value" />
                                                <Binding Path="Icon" />
                                            </MultiBinding>
                                        </controls:FASettingsExpander.IconSource>
                                    </controls:FASettingsExpander>
                                </DataTemplate>

                                <DataTemplate x:Key="InfoTemplate" x:DataType="types1:InfoSetting">
                                    <controls:FAInfoBar
                                        Title="{Binding Name.Value.Value}"
                                        IsVisible="{Binding IsVisible.Value}" IsEnabled="{Binding IsEnabled.Value}"
                                        Message="{Binding Description.Value.Value, FallbackValue='{x:Null}'}"
                                        IsOpen="True" IsClosable="False"
                                        Severity="{Binding Type, Converter={StaticResource InfoBarSeverityConverter}}">
                                        <controls:FASettingsExpander.IconSource>
                                            <MultiBinding Converter="{StaticResource SettingIconConverter}">
                                                <Binding Path="Status.Value" />
                                                <Binding Path="Icon" />
                                            </MultiBinding>
                                        </controls:FASettingsExpander.IconSource>
                                    </controls:FAInfoBar>
                                </DataTemplate>

                                <DataTemplate x:Key="ExpandableTemplate" x:DataType="types1:ExpandableSetting">
                                    <controls:FASettingsExpander
                                        Header="{Binding Name.Value.Value}"
                                        IsVisible="{Binding IsVisible.Value}" IsEnabled="{Binding IsEnabled.Value}"
                                        IsExpanded="{Binding IsExpanded.Value, Mode=TwoWay}"
                                        Description="{Binding Description.Value.Value, FallbackValue='{x:Null}'}"
                                        ItemsSource="{Binding Children}">
                                        <controls:FASettingsExpander.IconSource>
                                            <MultiBinding Converter="{StaticResource SettingIconConverter}">
                                                <Binding Path="Status.Value" />
                                                <Binding Path="Icon" />
                                            </MultiBinding>
                                        </controls:FASettingsExpander.IconSource>

                                        <controls:FASettingsExpander.ItemTemplate>
                                            <ui:ExpanderItemTemplateFactory>
                                                <ui:ExpanderItemTemplateFactory.Templates>
                                                    <DataTemplate x:Key="StandardExpanderItemTemplate"
                                                                  DataType="models1:SettingElement">
                                                        <controls:FASettingsExpanderItem
                                                            Content="{Binding Name.Value.Value}"
                                                            IsVisible="{Binding IsVisible.Value}"
                                                            IsEnabled="{Binding IsEnabled.Value}"
                                                            Description="{Binding Description.Value.Value, FallbackValue='{x:Null}'}"
                                                            Footer="{Binding}">
                                                            <controls:FASettingsExpanderItem.IconSource>
                                                                <MultiBinding
                                                                    Converter="{StaticResource SettingIconConverter}">
                                                                    <Binding Path="Status.Value" />
                                                                    <Binding Path="Icon" />
                                                                </MultiBinding>
                                                            </controls:FASettingsExpanderItem.IconSource>
                                                            <controls:FASettingsExpanderItem.Resources>
                                                                <x:Double x:Key="SettingsExpanderItemIconSize">20</x:Double>
                                                                <Thickness x:Key="SettingsExpanderItemPadding">22,10,16,10</Thickness>
                                                                <Thickness x:Key="SettingsExpanderItemContentMargin">37,0,0,0</Thickness>
                                                            </controls:FASettingsExpanderItem.Resources>
                                                        </controls:FASettingsExpanderItem>
                                                    </DataTemplate>

                                                    <DataTemplate x:Key="ClickableExpanderItemTemplate"
                                                                  DataType="types1:ClickableActionSetting">
                                                        <controls:FASettingsExpanderItem
                                                            Content="{Binding Name.Value.Value}"
                                                            IsVisible="{Binding IsVisible.Value}"
                                                            IsEnabled="{Binding IsEnabled.Value}"
                                                            Description="{Binding Description.Value.Value, FallbackValue='{x:Null}'}"
                                                            ActionIconSource="{Binding ActionIcon, Converter={StaticResource StandardIconSourceConverter}}"
                                                            IsClickEnabled="True"
                                                            Command="{Binding Command}">
                                                            <controls:FASettingsExpanderItem.IconSource>
                                                                <MultiBinding
                                                                    Converter="{StaticResource SettingIconConverter}">
                                                                    <Binding Path="Status.Value" />
                                                                    <Binding Path="Icon" />
                                                                </MultiBinding>
                                                            </controls:FASettingsExpanderItem.IconSource>
                                                            <controls:FASettingsExpanderItem.Resources>
                                                                <x:Double x:Key="SettingsExpanderItemIconSize">20</x:Double>
                                                                <Thickness x:Key="SettingsExpanderItemPadding">22,10,16,10</Thickness>
                                                                <Thickness x:Key="SettingsExpanderItemContentMargin">37,0,0,0</Thickness>
                                                            </controls:FASettingsExpanderItem.Resources>
                                                        </controls:FASettingsExpanderItem>
                                                    </DataTemplate>

                                                    <DataTemplate x:Key="InfoExpanderItemTemplate"
                                                                  DataType="types1:InfoSetting">
                                                        <controls:FASettingsExpanderItem
                                                            Content="{Binding Name.Value.Value}"
                                                            IsVisible="{Binding IsVisible.Value}"
                                                            IsEnabled="{Binding IsEnabled.Value}"
                                                            Description="{Binding Description.Value.Value, FallbackValue='{x:Null}'}">
                                                            <controls:FASettingsExpanderItem.IconSource>
                                                                <MultiBinding
                                                                    Converter="{StaticResource SettingIconConverter}">
                                                                    <Binding Path="Status.Value" />
                                                                    <Binding Path="Icon" />
                                                                </MultiBinding>
                                                            </controls:FASettingsExpanderItem.IconSource>
                                                            <controls:FASettingsExpanderItem.Resources>
                                                                <x:Double x:Key="SettingsExpanderItemIconSize">20</x:Double>
                                                                <Thickness x:Key="SettingsExpanderItemPadding">22,10,16,10</Thickness>
                                                                <Thickness x:Key="SettingsExpanderItemContentMargin">37,0,0,0</Thickness>
                                                            </controls:FASettingsExpanderItem.Resources>
                                                        </controls:FASettingsExpanderItem>
                                                    </DataTemplate>
                                                </ui:ExpanderItemTemplateFactory.Templates>
                                            </ui:ExpanderItemTemplateFactory>
                                        </controls:FASettingsExpander.ItemTemplate>
                                    </controls:FASettingsExpander>
                                </DataTemplate>
                            </ui:SettingElementTemplateFactory.Templates>
                        </ui:SettingElementTemplateFactory>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
        </controls:FANavigationView.Content>
    </controls:FANavigationView>
</UserControl>