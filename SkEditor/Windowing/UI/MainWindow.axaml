<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:notifs="clr-namespace:SkEditor.Core.Notifications.UI"
        xmlns:converters="clr-namespace:SkEditor.Layout.Sidebar.UI.Converters"
        xmlns:menu="clr-namespace:SkEditor.Layout.Menu.UI"
        xmlns:sidebar="clr-namespace:SkEditor.Layout.Sidebar.UI"
        xmlns:statusbar="clr-namespace:SkEditor.Layout.StatusBar.UI"
        xmlns:windows="clr-namespace:SkEditor.Windowing.UI"
        xmlns:platform="clr-namespace:SkEditor.Windowing.UI.Platform"
        xmlns:tabs="clr-namespace:SkEditor.Workspace.Tabs.UI"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="SkEditor.Windowing.UI.MainWindow"
        x:DataType="windows:MainWindowViewModel"
        x:Name="Root"
        Background="{DynamicResource BackgroundColor}"
        Icon="/Assets/SkEditor.ico" MinWidth="450" MinHeight="250"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="{Binding TitleBarHeight}"
        platform:MacOsTitleBar.IsThick="{Binding UseThickTitleBar}"
        platform:NativeMenuBridge.ItemsSource="{Binding NativeMenuItems}"
        platform:DwmMaximizeFix.EnableFix="True"
        Focusable="True"
        Title="SkEditor" WindowStartupLocation="Manual" DragDrop.AllowDrop="True">

    <Window.Resources>
        <converters:DoubleToGridLengthConverter x:Key="DoubleToGridLengthConverter" />
        <converters:SidebarColumnMinWidthConverter x:Key="SidebarColumnMinWidthConverter" />
        <converters:BottomDrawerMinWidthConverter x:Key="BottomDrawerMinWidthConverter" />
    </Window.Resources>

    <LayoutTransformControl Name="LayoutTransform">
        <Grid RowDefinitions="Auto,*">
            <Border Name="TitleBarBorder" Grid.Row="0" Padding="5" VerticalAlignment="Top"
                    HorizontalAlignment="Stretch" Height="{Binding TitleBarHeight}"
                    Margin="{Binding TitleBarMargin}"
                    Background="{DynamicResource TitleBarBackground}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"
                            IsVisible="{Binding ShowInAppMenu}">
                    <Image Source="{StaticResource SkEditorLogo}" IsVisible="{OnPlatform macOS=False, Default=True}"
                           Margin="12,0,0,0" Height="20" Width="20" />
                    <menu:MainMenuControl DataContext="{Binding MainMenu}" Name="MainMenu" Margin="15,0,0,0"
                                              WindowDecorationProperties.ElementRole="User" />
                </StackPanel>
            </Border>
            <Separator Grid.Row="0" Height="1" Margin="0,1,0,0" VerticalAlignment="Bottom"
                       IsVisible="{Binding ShowInAppMenu}"
                       Background="{DynamicResource WindowBorderBrush}" />

            <Border Grid.Row="1" Padding="10,12,10,10" Background="{DynamicResource MainWindowGridBackground}">
                <Grid Name="CoreGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition
                            Width="{Binding Sidebar.ColumnWidth, TargetNullValue=NaN, Mode=TwoWay, Converter={StaticResource DoubleToGridLengthConverter}}"
                            MinWidth="{Binding Sidebar.ColumnWidth, Converter={StaticResource SidebarColumnMinWidthConverter}}"
                            MaxWidth="800" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="300" />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition
                            Height="{Binding BottomDrawer.DrawerHeight, Mode=TwoWay, Converter={StaticResource DoubleToGridLengthConverter}}"
                            MinHeight="{Binding BottomDrawer.IsDrawerOpen, Converter={StaticResource BottomDrawerMinWidthConverter}}"
                            MaxHeight="400" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <sidebar:SidebarControl Name="Sidebar" DataContext="{Binding Sidebar}" Grid.Column="0" Grid.Row="0"
                                            Grid.RowSpan="3" />

                    <GridSplitter Name="Splitter" Grid.Column="1" Grid.Row="0" Grid.RowSpan="3"
                                  Background="Transparent"
                                  ResizeDirection="Columns"
                                  Width="10"
                                  IsHitTestVisible="{Binding Sidebar.Sidebar.SelectedPanel, Converter={x:Static ObjectConverters.IsNotNull}}" />

                    <statusbar:BottomDrawer Name="Drawer" DataContext="{Binding BottomDrawer}"
                                            Grid.Column="2" Grid.Row="2"
                                            IsVisible="{Binding IsDrawerOpen}" />

                    <statusbar:StatusBarControl DataContext="{Binding StatusBar}" Grid.Column="0" Grid.Row="3"
                                              Margin="0,10,0,0"
                                              Grid.ColumnSpan="3" />

                    <GridSplitter Name="RowSplitter" Grid.Column="2" Grid.Row="1" Background="Transparent"
                                  ResizeDirection="Rows"
                                  IsVisible="{Binding BottomDrawer.IsDrawerOpen}"
                                  Height="10" />

                    <tabs:MainTabView Grid.Column="2" Grid.Row="0" VerticalAlignment="Stretch" />
                </Grid>
            </Border>

            <notifs:SkEditorNotificationManager
                x:Name="NotificationManager"
                Grid.Row="1"
                Position="BottomRight"
                MaxItems="6"
                Margin="0,0,0,48"
                ClipToBounds="False"
                ZIndex="1000" />
        </Grid>
    </LayoutTransformControl>
</Window>