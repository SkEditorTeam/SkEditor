<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="SkEditor.Views.Windows.SplashScreen"
        Icon="/Assets/SkEditor.ico"
        Title="SkEditor">

    <Grid RowDefinitions="*, Auto" Margin="20">
        <Image Source="{StaticResource SkEditorLogo}" Grid.Row="0" Width="150" Height="150"
               HorizontalAlignment="Center">
            <Image.Effect>
                <DropShadowEffect Color="#64000000" BlurRadius="15" OffsetX="0" OffsetY="5" />
            </Image.Effect>
        </Image>
        <TextBlock x:Name="StatusText" Grid.Row="1" Text="Initializing..." TextAlignment="Center" Margin="0, 5, 0, 0" />
    </Grid>
</Window>