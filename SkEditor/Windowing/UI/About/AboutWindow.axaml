<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:icons="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
        xmlns:localization="clr-namespace:SkEditor.Core.Localization"
        xmlns:about="clr-namespace:SkEditor.Windowing.UI.About"
        mc:Ignorable="d" d:DesignWidth="180" d:DesignHeight="100"
        x:Class="SkEditor.Windowing.UI.About.AboutWindow" Icon="/Assets/SkEditor.ico"
        x:DataType="about:AboutWindowViewModel"
        Title="{localization:Translate AboutTitle}" Height="336" Width="580" CanResize="False"
        WindowStartupLocation="CenterOwner">

    <Grid Name="AboutGrid" Margin="24,8,24,24" RowDefinitions="*,Auto">
        <Grid.Styles>
            <Style Selector="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource ForegroundSecondaryColor}" />
                <Setter Property="FontSize" Value="14" />
            </Style>
        </Grid.Styles>

        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="32">
            <Image Source="{StaticResource SkEditorLogo}" Height="96" Width="96"
                   HorizontalAlignment="Left" VerticalAlignment="Top" />

            <StackPanel Grid.Column="1" VerticalAlignment="Top" Spacing="4" Margin="0,2,0,0">
                <TextBlock Text="SkEditor" FontSize="26" FontWeight="DemiBold"
                           Foreground="{DynamicResource ForegroundColor}" />
                <TextBlock Text="{localization:Translate AboutDescription}" TextWrapping="Wrap" Margin="0,0,0,12" />

                <StackPanel Spacing="2">
                    <TextBlock Text="{Binding VersionString}" />
                    <TextBlock Text="{Binding DateString}" FontSize="12" />
                </StackPanel>

                <StackPanel Spacing="2" Margin="0,12,0,0">
                    <TextBlock Text="{localization:Translate AboutRunningOn}" />
                    <TextBlock>
                        <Run>•</Run>
                        <Run Text="{Binding FrameworkDescription}" />
                    </TextBlock>
                    <TextBlock>
                        <Run>•</Run>
                        <Run Text="{Binding OperatingSystem}" />
                    </TextBlock>
                </StackPanel>

                <HyperlinkButton Margin="0,16,0,0" Padding="0" Command="{Binding OpenAuthorCommand}">
                    <TextBlock Text="{Binding AuthorString}" FontSize="12" />
                </HyperlinkButton>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,24,0,0">

            <Button Command="{Binding CopySystemInfoCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <icons:SymbolIcon Symbol="DocumentCopy" FontSize="16"
                                      Foreground="{DynamicResource ForegroundColor}" />
                    <TextBlock Text="{localization:Translate AboutCopySystemInfo}"
                               Foreground="{DynamicResource ForegroundColor}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button Command="{Binding OpenSupportCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <icons:SymbolIcon Symbol="Heart" FontSize="16" IconVariant="Color" />
                    <TextBlock Text="{localization:Translate AboutSupportUs}" VerticalAlignment="Center"
                               Foreground="{DynamicResource ForegroundColor}" />
                </StackPanel>
            </Button>

        </StackPanel>
    </Grid>
</Window>