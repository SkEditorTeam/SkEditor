<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:behaviors="clr-namespace:SkEditor.Appearance.Behaviors"
             xmlns:ui="clr-namespace:SkEditor.Configuration.UI"
             xmlns:models="clr-namespace:SkEditor.Welcome.Models"
             xmlns:converters="clr-namespace:SkEditor.Appearance.Icons.Converters"
             xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:localization="clr-namespace:SkEditor.Core.Localization"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="750"
             x:CompileBindings="True"
             x:DataType="ui:WhatsNewPageViewModel"
             Focusable="True"
             x:Class="SkEditor.Configuration.UI.WhatsNewPage">
    
    <UserControl.Resources>
        <converters:StandardIconSourceConverter x:Key="StandardIconSourceConverter" />
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Border.feature-card">
            <Setter Property="Background" Value="#06FFFFFF" />
            <Setter Property="BorderBrush" Value="#0EFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Duration="0:0:0.1" Property="Background" />
                    <BrushTransition Duration="0:0:0.1" Property="BorderBrush" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Border.icon-box">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="#0DFFFFFF" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Interaction.Behaviors>
            <BehaviorCollection>
                <behaviors:SmoothScrollBehavior />
            </BehaviorCollection>
        </Interaction.Behaviors>

        <StackPanel MaxWidth="860"
                    Margin="32,40,32,40"
                    Spacing="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <StackPanel Orientation="Vertical" Spacing="16" HorizontalAlignment="Center">
                <Image Source="{StaticResource SkEditorLogo}" Height="72" Width="72">
                    <Image.Effect>
                        <DropShadowEffect Color="#64000000" BlurRadius="15" OffsetX="0" OffsetY="5" />
                    </Image.Effect>
                </Image>

                <StackPanel Spacing="4">
                    <TextBlock Text="{localization:Translate WhatsNewPageHeader}"
                               HorizontalAlignment="Center"
                               FontSize="28"
                               FontWeight="DemiBold" />

                    <TextBlock Text="{localization:Translate WhatsNewPageDescription}"
                               HorizontalAlignment="Center"
                               FontSize="14"
                               Foreground="{DynamicResource ForegroundSecondaryColor}" />
                </StackPanel>
            </StackPanel>

            <ItemsControl ItemsSource="{Binding FeaturedItems}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" ColumnSpacing="14" RowSpacing="14" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:WhatsNewFeaturedItem">
                        <Border Classes="feature-card">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                <Border Grid.Column="0" Classes="icon-box">
                                    <controls:FAIconSourceElement
                                        Width="20" Height="20"
                                        IconSource="{Binding Icon, Converter={StaticResource StandardIconSourceConverter}}" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="{Binding Title}"
                                               TextTrimming="CharacterEllipsis"
                                               FontSize="15" FontWeight="SemiBold"
                                               Foreground="{DynamicResource ForegroundColor}" />
                                    <TextBlock Text="{Binding Description}"
                                               FontSize="13" TextWrapping="Wrap"
                                               Foreground="{DynamicResource ForegroundSecondaryColor}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>