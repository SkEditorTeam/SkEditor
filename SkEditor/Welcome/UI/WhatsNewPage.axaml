<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:icons="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
             xmlns:behaviors="clr-namespace:SkEditor.Appearance.Behaviors"
             xmlns:ui="clr-namespace:SkEditor.Configuration.UI"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="750"
             x:CompileBindings="True"
             x:DataType="ui:WhatsNewPageViewModel"
             Focusable="True"
             x:Class="SkEditor.Configuration.UI.WhatsNewPage">

    <UserControl.Styles>
        <Style Selector="Border.feature-card">
            <Setter Property="Background" Value="#06FFFFFF" />
            <Setter Property="BorderBrush" Value="#0EFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Duration="0:0:0.1" Property="Background" />
                    <BrushTransition Duration="0:0:0.1" Property="BorderBrush" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Border.icon-box">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="#0DFFFFFF" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Interaction.Behaviors>
            <BehaviorCollection>
                <behaviors:SmoothScrollBehavior />
            </BehaviorCollection>
        </Interaction.Behaviors>

        <StackPanel MaxWidth="860"
                    Margin="32,40,32,40"
                    Spacing="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            
            <StackPanel Orientation="Vertical" Spacing="16" HorizontalAlignment="Center">
                <Image Source="{StaticResource SkEditorLogo}" Height="72" Width="72">
                    <Image.Effect>
                        <DropShadowEffect Color="#64000000" BlurRadius="15" OffsetX="0" OffsetY="5" />
                    </Image.Effect>
                </Image>

                <StackPanel Spacing="4">
                    <TextBlock Text="What's new in SkEditor"
                               HorizontalAlignment="Center"
                               FontSize="28"
                               FontWeight="DemiBold" />

                    <TextBlock Text="Rewritten from scratch with native speed, modern features, and a fresh new look."
                               HorizontalAlignment="Center"
                               FontSize="14"
                               Foreground="{DynamicResource ForegroundSecondaryColor}" />
                </StackPanel>
            </StackPanel>

            <UniformGrid Columns="2" ColumnSpacing="14" RowSpacing="14">

                <Border Classes="feature-card">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Border Grid.Column="0" Classes="icon-box">
                            <icons:SymbolIcon Symbol="Flash" FontSize="20"
                                              Foreground="{DynamicResource AccentButtonBackground}" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Natively compiled"
                            TextTrimming="CharacterEllipsis"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundColor}" />
                            <TextBlock Text="Instant startup, lower memory usage, and a much better architecture built on the latest .NET"
                                       FontSize="13" TextWrapping="Wrap"
                                       Foreground="{DynamicResource ForegroundSecondaryColor}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Classes="feature-card">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Border Grid.Column="0" Classes="icon-box">
                            <controls:FAIconSourceElement Width="20" Height="20" IconSource="{StaticResource RemoteDesktopIcon}" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="SFTP Remote Explorer"
                            TextTrimming="CharacterEllipsis"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundColor}" />
                            <TextBlock Text="Connect directly to your remote server, browse files, and edit scripts without external software"
                                       FontSize="13" TextWrapping="Wrap"
                                       Foreground="{DynamicResource ForegroundSecondaryColor}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Classes="feature-card">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Border Grid.Column="0" Classes="icon-box">
                            <icons:SymbolIcon Symbol="History" FontSize="20"
                                              Foreground="{DynamicResource AccentButtonBackground}" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Session restore you can trust"
                            TextTrimming="CharacterEllipsis"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundColor}" />
                            <TextBlock Text="Session restore is now fully reliable, so you can pick up where you left off without worry"
                                       FontSize="13" TextWrapping="Wrap"
                                       Foreground="{DynamicResource ForegroundSecondaryColor}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Classes="feature-card">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Border Grid.Column="0" Classes="icon-box">
                            <icons:SymbolIcon Symbol="Book" FontSize="20"
                                              Foreground="{DynamicResource AccentButtonBackground}" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Redesigned documentation"
                            TextTrimming="CharacterEllipsis"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundColor}" />
                            <TextBlock Text="Browse SkDocs and skUnity syntaxes blazingly fast without leaving the editor"
                                       FontSize="13" TextWrapping="Wrap"
                                       Foreground="{DynamicResource ForegroundSecondaryColor}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Classes="feature-card">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Border Grid.Column="0" Classes="icon-box">
                            <icons:SymbolIcon Symbol="CodeTextEdit" FontSize="20"
                                              Foreground="{DynamicResource AccentButtonBackground}" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="New syntax highlighting"
                            TextTrimming="CharacterEllipsis"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundColor}" />
                            <TextBlock Text="Full TextMate grammar and theme support for Skript and dozens of other file formats"
                                       FontSize="13" TextWrapping="Wrap"
                                       Foreground="{DynamicResource ForegroundSecondaryColor}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Classes="feature-card">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Border Grid.Column="0" Classes="icon-box">
                            <icons:SymbolIcon Symbol="DocumentSearch" FontSize="20"
                                              Foreground="{DynamicResource AccentButtonBackground}" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="The new Analyzer"
                            TextTrimming="CharacterEllipsis"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundColor}" />
                            <TextBlock Text="Check your scripts for errors and warnings with the new Analyzer, now built directly into SkEditor"
                                       FontSize="13" TextWrapping="Wrap"
                                       Foreground="{DynamicResource ForegroundSecondaryColor}" />
                        </StackPanel>
                    </Grid>
                </Border>

            </UniformGrid>
            
        </StackPanel>
    </ScrollViewer>
</UserControl>