<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:behaviors="clr-namespace:SkEditor.Behaviors"
             xmlns:statusBar="clr-namespace:SkEditor.Views.Controls.StatusBar"
             xmlns:vm="clr-namespace:SkEditor.ViewModels.Controls.Panes"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SkEditor.Views.Controls.StatusBar.Panes.ErrorListPaneView"
             x:DataType="vm:ErrorListPaneViewModel">
    <Grid RowDefinitions="Auto,*" Margin="8,4,0,8">
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                      Margin="0,0,-6,0">
            <Interaction.Behaviors>
                <BehaviorCollection>
                    <behaviors:SmoothScrollBehavior />
                </BehaviorCollection>
            </Interaction.Behaviors>
            <StackPanel Spacing="6" Margin="0,0,14,0">
                <statusBar:DrawerErrorEntry
                    ErrorMessage="Can't understand this condition/effect: set yaml value &quot;log&quot; from file &quot;spigot.yml&quot; to false"
                    Type="Error" ErrorLine="54" ErrorSource="login.sk"
                    ErrorClickCommand="{Binding ErrorClickCommand}" />
                <statusBar:DrawerErrorEntry
                    ErrorMessage="Can't understand this condition: 'file &quot;plugins/Skript/scripts/players/%the sender%.yml&quot; exists'"
                    Type="Error" ErrorLine="67" ErrorSource="login.sk"
                    ErrorClickCommand="{Binding ErrorClickCommand}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>