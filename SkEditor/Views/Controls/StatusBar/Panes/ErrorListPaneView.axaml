<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:behaviors="clr-namespace:SkEditor.Behaviors"
             xmlns:statusBar="clr-namespace:SkEditor.Views.Controls.StatusBar"
             xmlns:vm="clr-namespace:SkEditor.ViewModels.Controls.StatusBar.Panes"
             xmlns:analyzer="clr-namespace:SkEditor.Models.Analyzer"
             xmlns:icons="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SkEditor.Views.Controls.StatusBar.Panes.ErrorListPaneView"
             Name="Root"
             x:DataType="vm:ErrorListPaneViewModel">
    <Grid RowDefinitions="Auto,*" Margin="8,2,0,0">
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                      Margin="0,0,-6,0">
            <Interaction.Behaviors>
                <BehaviorCollection>
                    <behaviors:SmoothScrollBehavior />
                </BehaviorCollection>
            </Interaction.Behaviors>
            <Panel>
                <ItemsControl ItemsSource="{Binding Errors}" Margin="0,0,14,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <statusBar:DrawerErrorEntry x:DataType="analyzer:AnalyzerError"
                                                        ErrorMessage="{Binding Message}"
                                                        ErrorType="{Binding Type}" ErrorLine="{Binding Line}"
                                                        ErrorSource="script"
                                                        ErrorClickCommand="{Binding #Root.((vm:ErrorListPaneViewModel)DataContext)?.ErrorClickCommand}"
                                                        ErrorClickCommandParameter="{Binding .}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel VerticalAlignment="Center" Spacing="6"
                            IsVisible="{Binding !Errors.Count}">
                    <Viewbox Height="32" Opacity="0.5">
                        <icons:SymbolIcon Symbol="WeatherSqualls" HorizontalAlignment="Center" />
                    </Viewbox>
                    <StackPanel Spacing="2">
                        <TextBlock Text="No problems found"
                                   HorizontalAlignment="Center" FontSize="16" Opacity="0.75" />
                        <TextBlock Text="Your code is clean and free of errors, good job!"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   FontSize="12" MaxWidth="300" Opacity="0.6" />
                    </StackPanel>
                </StackPanel>
            </Panel>
        </ScrollViewer>
    </Grid>
</UserControl>