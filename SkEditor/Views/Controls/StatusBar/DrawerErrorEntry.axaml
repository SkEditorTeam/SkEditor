<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:icons="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SkEditor.Views.Controls.StatusBar.DrawerErrorEntry"
             DataContext="{Binding RelativeSource={RelativeSource Self}}">
    <Border Background="#05FFFFFF" BorderBrush="#10FFFFFF" BorderThickness="1" CornerRadius="5"
            Padding="8,4">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
            <Viewbox Grid.Column="0" Height="18" Width="18">
                <icons:SymbolIcon Symbol="{Binding ErrorIcon}" Foreground="{Binding ErrorColor}" Height="24" Width="24" />
            </Viewbox>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource ForegroundColor}"
                           Text="{Binding ErrorMessage}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="24">
                <TextBlock FontSize="11" Foreground="{DynamicResource ForegroundSecondaryColor}"
                           VerticalAlignment="Center" FontWeight="Medium" Text="{Binding ErrorSource}" />
                <TextBlock FontSize="11" Foreground="{DynamicResource ForegroundSecondaryColor}"
                           VerticalAlignment="Center" TextAlignment="Right">
                    <Run Text="Line " />
                    <Run Text="{Binding ErrorLine}" />
                </TextBlock>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>