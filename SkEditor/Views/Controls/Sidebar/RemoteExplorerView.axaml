<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="300"
             xmlns:icons="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
             xmlns:projects="clr-namespace:SkEditor.Views.Controls.Projects"
             xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:panes="clr-namespace:SkEditor.ViewModels.Controls.Sidebar.Panes"
             xmlns:primitives="clr-namespace:Avalonia.Controls.Primitives"
             xmlns:localization="clr-namespace:SkEditor.Utilities.Localization"
             xmlns:converters="clr-namespace:SkEditor.Converters"
             x:DataType="panes:RemoteExplorerViewModel"
             x:Class="SkEditor.Views.Controls.Sidebar.RemoteExplorerView">

    <UserControl.Styles>
        <Style Selector="Button.barButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
        </Style>

        <Style Selector="projects|FileTreeView TextBlock">
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>
    </UserControl.Styles>

    <UserControl.Resources>
        <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter" />
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*" Margin="4,12,4,8">
        <DockPanel Grid.Row="0" Margin="12,0,12,0" HorizontalSpacing="8">
            <Button Classes="barButton" Command="{Binding NewRemoteConnectionCommand}" DockPanel.Dock="Right"
                    ToolTip.Tip="{localization:Translate RemoteConnectionNewWindowTitle}"
                    VerticalAlignment="Center">
                <Viewbox Height="14">
                    <icons:SymbolIcon Symbol="Add" />
                </Viewbox>
            </Button>

            <ComboBox Theme="{DynamicResource LiteComboBox}" HorizontalAlignment="Stretch"
                      VerticalContentAlignment="Center"
                      PlaceholderText="{localization:Translate RemoteConnectionSelectConnection}"
                      SelectedItem="{Binding SelectedConnection, Mode=TwoWay}"
                      DisplayMemberBinding="{Binding Name}"
                      ToolTip.Tip="{localization:Translate RemoteConnectionNoConnectionTooltip}"
                      ToolTip.ShowOnDisabled="True"
                      ToolTip.ServiceEnabled="{Binding !RemoteConnections.Count}"
                      IsEnabled="{Binding !!RemoteConnections.Count}"
                      ItemsSource="{Binding RemoteConnections}">
                <Interaction.Behaviors>
                    <primitives:SelectingItemsControlSelectionChangedEventCommandTrigger
                        Command="{Binding ConnectCommand}" />
                </Interaction.Behaviors>
            </ComboBox>
        </DockPanel>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="12">
            <StackPanel.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="!FileTree.IsLoading" />
                    <Binding Path="SelectedConnection" Converter="{x:Static ObjectConverters.IsNull}" />
                </MultiBinding>
            </StackPanel.IsVisible>
            <Viewbox Height="64" Opacity="0.5">
                <icons:SymbolIcon Symbol="CloudOff" HorizontalAlignment="Center" />
            </Viewbox>
            <StackPanel Spacing="4">
                <TextBlock Text="{localization:Translate RemoteConnectionNoConnectionTitle}"
                           HorizontalAlignment="Center" FontSize="18" Opacity="0.75" />
                <TextBlock Text="{localization:Translate RemoteConnectionNoConnectionMessage}"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           FontSize="13" MaxWidth="250" Opacity="0.6" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="12"
                    IsVisible="{Binding FileTree.IsLoading}">
            <Viewbox Height="64" Opacity="0.5" OpacityMask="White">
                <controls:FAProgressRing HorizontalAlignment="Center" />
            </Viewbox>
            <TextBlock Text="{localization:Translate RemoteConnectionConnecting}" HorizontalAlignment="Center"
                       FontSize="18" Opacity="0.75" />
        </StackPanel>

        <projects:FileTreeView Grid.Row="1" DataContext="{Binding FileTree}" Margin="0,12,0,0"
                               IsVisible="{Binding $parent.((panes:RemoteExplorerViewModel)DataContext)?.SelectedConnection, Converter={x:Static ObjectConverters.IsNotNull}}"
                               Opacity="{Binding !IsLoading, Converter={StaticResource BoolToOpacityConverter}}" />
    </Grid>
</UserControl>