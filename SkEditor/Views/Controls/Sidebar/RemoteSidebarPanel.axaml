<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="300"
             xmlns:icons="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
             xmlns:projects="clr-namespace:SkEditor.Views.Controls.Projects"
             xmlns:sidebar="clr-namespace:SkEditor.Views.Controls.Sidebar"
             DataContext="{Binding RelativeSource={RelativeSource Self}}"
             x:DataType="sidebar:RemoteSidebarPanel"
             x:Class="SkEditor.Views.Controls.Sidebar.RemoteSidebarPanel">

    <UserControl.Styles>
        <Style Selector="Button.barButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Separator">
            <Setter Property="Margin" Value="8,4" />
        </Style>
        <Style Selector="TreeViewItem">
            <Setter Property="FontWeight" Value="Regular" />
        </Style>

        <Style Selector="icons|SymbolIcon">
            <Setter Property="FontSize" Value="18.5" />
        </Style>
    </UserControl.Styles>

    <Border MinWidth="250" Name="ExtendedSideBar" Background="{DynamicResource SkEditorBorderBackground}"
            CornerRadius="7">

        <Grid RowDefinitions="auto,auto,*">
            <TextBlock Grid.Row="0" Text="Remote Connections" FontWeight="DemiBold"
                       Margin="20,10,20,10" />
            <Separator Grid.Row="1" Margin="0,0,0,10" />

            <Grid Grid.Row="2" RowDefinitions="*,Auto" Margin="10,0,0,10">
                <projects:FileTreeView Grid.Row="0" DataContext="{Binding FileTree}" />

                <Button Name="NewRemoteConnectionButton" Grid.Row="1" HorizontalAlignment="Stretch"
                        Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <icons:SymbolIcon Symbol="Add" FontSize="18" />
                        <TextBlock Text="Add Remote Connection" FontSize="14" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>