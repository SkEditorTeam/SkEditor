<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="300"
             xmlns:icons="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
             xmlns:projects="clr-namespace:SkEditor.Views.Controls.Projects"
             xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:panes="clr-namespace:SkEditor.ViewModels.Controls.Sidebar.Panes"
             x:DataType="panes:RemoteSidebarViewModel"
             x:Class="SkEditor.Views.Controls.Sidebar.RemoteSidebarPanel">

    <UserControl.Styles>
        <Style Selector="Button.barButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">
        <DockPanel Grid.Row="0" Margin="12,0,12,0" HorizontalSpacing="8">
            <Button Classes="barButton" Command="{Binding NewRemoteConnectionCommand}" DockPanel.Dock="Right"
                    ToolTip.Tip="Add Remote Connection"
                    VerticalAlignment="Center">
                <Viewbox Height="14">
                    <icons:SymbolIcon Symbol="Add" />
                </Viewbox>
            </Button>

            <ComboBox Theme="{DynamicResource LiteComboBox}" HorizontalAlignment="Stretch"
                      VerticalContentAlignment="Center"
                      PlaceholderText="Select connection..."
                      SelectedItem="{Binding SelectedConnection, Mode=TwoWay}"
                      ToolTip.Tip="Add a connection first!"
                      ToolTip.ShowOnDisabled="True"
                      ToolTip.ServiceEnabled="{Binding !RemoteConnections.Count}"
                      IsEnabled="{Binding !!RemoteConnections.Count}"
                      ItemsSource="{Binding RemoteConnections}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </DockPanel>

        <StackPanel Grid.Row="1" Orientation="Vertical" VerticalAlignment="Center" Spacing="12"
                    IsVisible="{Binding NoSelectedConnection}">
            <Viewbox Height="64" Opacity="0.5">
                <icons:SymbolIcon Symbol="CloudOff" HorizontalAlignment="Center" />
            </Viewbox>
            <StackPanel Orientation="Vertical" Spacing="4">
                <TextBlock Text="No remote connection" HorizontalAlignment="Center" FontSize="18" Opacity="0.75" />
                <TextBlock Text="Create a remote connection to view and edit files on a remote server."
                           HorizontalAlignment="Center" TextAlignment="Center"
                           FontSize="13" TextWrapping="Wrap" Width="250" Opacity="0.6" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Vertical" VerticalAlignment="Center" Spacing="12"
                    IsVisible="{Binding FileTree.IsLoading}">
            <Viewbox Height="64" Opacity="0.5" OpacityMask="White">
                <controls:FAProgressRing HorizontalAlignment="Center" />
            </Viewbox>
            <TextBlock Text="Connecting..." HorizontalAlignment="Center" FontSize="18" Opacity="0.75" />
        </StackPanel>

        <projects:FileTreeView Grid.Row="1" DataContext="{Binding FileTree}"
                               Margin="4,12,4,8" />
    </Grid>
</UserControl>