<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:elements="clr-namespace:SkEditor.Utilities.Projects.Elements"
             xmlns:localization="clr-namespace:SkEditor.Utilities.Localization"
             xmlns:icons="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
             x:Class="SkEditor.Views.Controls.Sidebar.RemoteSidebarPanel">

    <UserControl.Styles>
        <Style Selector="Button.barButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Separator">
            <Setter Property="Margin" Value="8,4" />
        </Style>
        <Style Selector="TreeViewItem">
            <Setter Property="FontWeight" Value="Regular" />
        </Style>

        <Style Selector="icons|SymbolIcon">
            <Setter Property="FontSize" Value="18.5" />
        </Style>
    </UserControl.Styles>

    <Border MinWidth="250" Name="ExtendedSideBar" Background="{DynamicResource SkEditorBorderBackground}"
            CornerRadius="7">

        <Grid RowDefinitions="auto,auto,*">
            <TextBlock Grid.Row="0" Text="Remote Connections" FontWeight="DemiBold"
                       Margin="20,10,20,10" />
            <Separator Grid.Row="1" Margin="0,0,0,10" />

            <Grid Grid.Row="2" RowDefinitions="*,Auto" Margin="10,0,10,10">
                <ListBox Grid.Row="0" Background="Transparent" BorderThickness="0">
                    <ListBoxItem VerticalContentAlignment="Stretch">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Viewbox Height="18" Width="18">
                                <icons:SymbolIcon Symbol="Desktop" Foreground="White" />
                            </Viewbox>
                            <TextBlock Grid.Column="1" Text="Survival" FontFamily="14" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="Sync z Git" FontSize="12" Opacity="0.6"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </ListBoxItem>
                </ListBox>

                <Button Name="NewRemoteConnectionButton" Grid.Row="1" HorizontalAlignment="Stretch"
                        Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <icons:SymbolIcon Symbol="Add" FontSize="18" />
                        <TextBlock Text="Add Remote Connection" FontSize="14" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>