<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:icons="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
             xmlns:vms="clr-namespace:SkEditor.ViewModels.Controls"
             xmlns:converters="clr-namespace:SkEditor.Converters"
             xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SkEditor.Views.Controls.Sidebar.SidebarControl"
             x:DataType="vms:SidebarViewModel">

    <UserControl.Styles>
        <Style Selector="Grid#GridPanels > Border">
            <Setter Property="Padding" Value="8" />
            </Style>
        
        <Style Selector="Button.barButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#CCFFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Width" Value="32" />
        </Style>
        <Style Selector="Separator">
            <Setter Property="Margin" Value="0,1" />
        </Style>
        <Style Selector="TreeViewItem">
            <Setter Property="FontWeight" Value="Regular" />
        </Style>
    </UserControl.Styles>

    <UserControl.Resources>
        <converters:StandardIconSourceConverter x:Key="StandardIconSourceConverter" />
    </UserControl.Resources>

    <Grid Name="GridPanels" ColumnDefinitions="auto,auto" RowDefinitions="*">
        <Border Grid.Column="0" Width="48" Background="{DynamicResource SkEditorBorderBackground}" CornerRadius="7">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="4" HorizontalAlignment="Center" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Classes="barButton" Command="{Binding Command}">
                            <Viewbox>
                                <controls:FAIconSourceElement
                                    IconSource="{Binding Icon, Converter={StaticResource StandardIconSourceConverter}}" />
                            </Viewbox>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </Grid>
</UserControl>