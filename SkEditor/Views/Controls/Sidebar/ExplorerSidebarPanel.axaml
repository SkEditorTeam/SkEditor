<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:elements="clr-namespace:SkEditor.Utilities.Projects.Elements"
             xmlns:localization="clr-namespace:SkEditor.Utilities.Localization"
             xmlns:icons="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
             x:Class="SkEditor.Views.Controls.Sidebar.ExplorerSidebarPanel">

    <UserControl.Styles>
        <Style Selector="Button.barButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Separator">
            <Setter Property="Margin" Value="8,4" />
        </Style>
        <Style Selector="TreeViewItem">
            <Setter Property="FontWeight" Value="Regular" />
        </Style>

        <Style Selector="icons|SymbolIcon">
            <Setter Property="FontSize" Value="18.5" />
        </Style>
    </UserControl.Styles>

    <Border MinWidth="250" Name="ExtendedSideBar" Background="{DynamicResource SkEditorBorderBackground}"
            CornerRadius="7">

        <Grid RowDefinitions="auto,auto,auto,*">
            <TextBlock Grid.Row="0" Text="{localization:Translate ProjectExplorerTitle}" FontWeight="DemiBold"
                       Margin="20,10,20,10" />
            <Separator Grid.Row="1" Margin="0,0,0,10" />
            <TreeView Grid.Row="3" Name="FileTreeView" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="4,4,0,4" Padding="0,0,12,0">
                <TreeView.Styles>
                    <Style Selector="TreeViewItem">
                        <Setter Property="IsExpanded" x:DataType="elements:StorageElement"
                                Value="{Binding IsExpanded, Mode=TwoWay}" />

                        <Setter Property="ContextFlyout" x:DataType="elements:StorageElement">
                            <MenuFlyout>
                                <MenuItem IsVisible="{Binding !IsFile}"
                                          Header="{localization:Translate MenuHeaderNewFile}"
                                          Command="{Binding CreateNewFileCommand}" InputGesture="Ctrl+N">
                                    <MenuItem.Icon>
                                        <icons:SymbolIcon Symbol="DocumentAdd" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem IsVisible="{Binding !IsFile}"
                                          Header="{localization:Translate MenuHeaderNewFolder}"
                                          Command="{Binding CreateNewFolderCommand}" InputGesture="Ctrl+Shift+N">
                                    <MenuItem.Icon>
                                        <icons:SymbolIcon Symbol="FolderAdd" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem IsVisible="{Binding IsRootFolder}"
                                          Header="{localization:Translate MenuHeaderCloseProject}"
                                          Command="{Binding CloseProjectCommand}">
                                    <MenuItem.Icon>
                                        <icons:SymbolIcon Symbol="FolderProhibited" />
                                    </MenuItem.Icon>
                                </MenuItem>

                                <Separator IsVisible="{Binding !IsFile}" />

                                <MenuItem Header="{localization:Translate MenuHeaderCopyPath}"
                                          Command="{Binding CopyPathCommand}">
                                    <MenuItem.Icon>
                                        <icons:SymbolIcon Symbol="Copy" />
                                    </MenuItem.Icon>
                                </MenuItem>

                                <MenuItem Header="{localization:Translate MenuHeaderCopyAbsolutePath}"
                                          Command="{Binding CopyAbsolutePathCommand}">
                                    <MenuItem.Icon>
                                        <icons:SymbolIcon Symbol="ClipboardLink" />
                                    </MenuItem.Icon>
                                </MenuItem>

                                <Separator />

                                <MenuItem Header="{localization:Translate MenuHeaderOpenInExplorer}"
                                          Command="{Binding OpenInExplorerCommand}">
                                    <MenuItem.Icon>
                                        <icons:SymbolIcon Symbol="FolderOpen" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{localization:Translate MenuHeaderRename}"
                                          Command="{Binding RenameCommand}"
                                          InputGesture="F2">
                                    <MenuItem.Icon>
                                        <icons:SymbolIcon Symbol="Rename" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{localization:Translate MenuHeaderDeleteFromDisk}"
                                          Command="{Binding DeleteCommand}" InputGesture="Delete">
                                    <MenuItem.Icon>
                                        <icons:SymbolIcon Symbol="Delete" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </MenuFlyout>
                        </Setter>
                    </Style>
                </TreeView.Styles>
                <TreeView.ItemTemplate>
                    <TreeDataTemplate x:DataType="elements:StorageElement" ItemsSource="{Binding Children}">
                        <Grid ColumnSpacing="10" ColumnDefinitions="Auto,*" VerticalAlignment="Stretch"
                              ToolTip.Tip="{Binding Name}"
                              HorizontalAlignment="Left" Background="Transparent">
                            <Interaction.Behaviors>
                                <EventTriggerBehavior EventName="DoubleTapped">
                                    <EventTriggerBehavior.Actions>
                                        <InvokeCommandAction Command="{Binding DoubleClickCommand}" />
                                    </EventTriggerBehavior.Actions>
                                </EventTriggerBehavior>
                                <EventTriggerBehavior EventName="Tapped">
                                    <EventTriggerBehavior.Actions>
                                        <InvokeCommandAction Command="{Binding SingleClickCommand}" />
                                    </EventTriggerBehavior.Actions>
                                </EventTriggerBehavior>
                            </Interaction.Behaviors>
                            <Viewbox Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                     IsVisible="{Binding IsFile}"
                                     Width="18"
                                     Height="18">
                                <ui:IconSourceElement IconSource="{Binding Icon}" />
                            </Viewbox>
                            <TextBlock Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                        </Grid>
                    </TreeDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
            <StackPanel Name="NoFolderMessage" VerticalAlignment="Center" Grid.Row="3" Margin="8" Spacing="16">
                <TextBlock HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                           Text="{localization:Translate ProjectExplorerInfoText}" />
                <Button Name="OpenFolderButton" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <icons:SymbolIcon Symbol="FolderOpen" FontSize="18" />
                        <TextBlock Text="{localization:Translate ProjectExplorerInfoButton}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>