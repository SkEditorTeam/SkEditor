<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:SkEditor.ViewModels.Controls"
             xmlns:projects="clr-namespace:SkEditor.Models.Projects"
             xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:behaviors="clr-namespace:SkEditor.Behaviors"
             xmlns:converters="clr-namespace:SkEditor.Converters"
             xmlns:fluent="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="controls:FileTreeViewModel"
             x:Class="SkEditor.Views.Controls.Projects.FileTreeView">

    <UserControl.Resources>
        <converters:NodeToIconConverter x:Key="NodeToIconConverter" />
        <converters:NodeToColorConverter x:Key="NodeToColorConverter" />
    </UserControl.Resources>

    <TreeView Name="FileTree" ItemsSource="{Binding RootItems}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <TreeView.Styles>
            <Style Selector="TreeViewItem" x:DataType="projects:FileSystemNode">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            </Style>

            <Style Selector="TextBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="#1EFFFFFF" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Padding" Value="4,2" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="MinHeight" Value="24" />
            </Style>
        </TreeView.Styles>
        <TreeView.ItemTemplate>
            <TreeDataTemplate ItemsSource="{Binding Children}" DataType="projects:FileSystemNode">
                <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center" ColumnSpacing="8"
                      ToolTip.Tip="{Binding Name}" ToolTip.ShowDelay="750">
                    <Panel>
                        <Viewbox Width="17" Height="17">
                            <fluent:SymbolIcon
                                Foreground="{Binding ., Converter={StaticResource NodeToColorConverter}}">
                                <fluent:SymbolIcon.Symbol>
                                    <MultiBinding Converter="{StaticResource NodeToIconConverter}">
                                        <Binding Path="." />
                                        <Binding Path="IsExpanded" />
                                    </MultiBinding>
                                </fluent:SymbolIcon.Symbol>
                            </fluent:SymbolIcon>
                        </Viewbox>
                    </Panel>
                    <Panel Grid.Column="1">
                        <TextBlock IsVisible="{Binding !IsRenaming}" Text="{Binding Name}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />

                        <TextBox IsVisible="{Binding IsRenaming}"
                                 Text="{Binding Name}"
                                 Margin="-5,-3">
                            <Interaction.Behaviors>
                                <behaviors:FileTreeRenameBehavior />
                            </Interaction.Behaviors>
                        </TextBox>
                    </Panel>

                    <fa:ProgressRing Grid.Column="2" IsActive="{Binding IsLoadingChildren}" Width="16" Height="16"
                                     VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
            </TreeDataTemplate>
        </TreeView.ItemTemplate>
    </TreeView>
</UserControl>