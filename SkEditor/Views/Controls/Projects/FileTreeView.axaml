<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:SkEditor.ViewModels.Controls"
             xmlns:projects="clr-namespace:SkEditor.Models.Projects"
             xmlns:icons="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
             xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="controls:FileTreeViewModel"
             x:Class="SkEditor.Views.Controls.Projects.FileTreeView">
    <TreeView ItemsSource="{Binding RootItems}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <TreeView.Styles>
            <Style Selector="TreeViewItem" x:DataType="projects:FileSystemNode">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            </Style>
        </TreeView.Styles>
        <TreeView.ItemTemplate>
            <TreeDataTemplate ItemsSource="{Binding Children}" DataType="projects:FileSystemNode">
                <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center" ColumnSpacing="8"
                      ToolTip.Tip="{Binding Name}" ToolTip.ShowDelay="750">
                    <Panel>
                        <Viewbox Width="17" Height="17"
                                 IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <icons:SymbolIcon Symbol="{Binding Icon}"
                                              Foreground="{Binding IconColor}" />
                        </Viewbox>
                        <Viewbox Width="20" Height="20"
                                 IsVisible="{Binding IconImage, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <Image Source="{Binding IconImage}" />
                        </Viewbox>
                    </Panel>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />

                    <fa:ProgressRing Grid.Column="2" IsActive="{Binding IsLoadingChildren}" Width="16" Height="16"
                                     VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
            </TreeDataTemplate>
        </TreeView.ItemTemplate>
    </TreeView>
</UserControl>