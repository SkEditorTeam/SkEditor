<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:SkEditor.ViewModels.Controls"
             xmlns:projects="clr-namespace:SkEditor.Models.Projects"
             xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:behaviors="clr-namespace:SkEditor.Behaviors"
             xmlns:converters="clr-namespace:SkEditor.Converters"
             xmlns:icons="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
             xmlns:markup="clr-namespace:FluentIcons.Avalonia.Fluent.Markup;assembly=FluentIcons.Avalonia.Fluent"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="controls:FileTreeViewModel"
             x:Class="SkEditor.Views.Controls.Projects.FileTreeView">

    <UserControl.Resources>
        <converters:NodeToIconConverter x:Key="NodeToIconConverter" />
        <converters:NodeToColorConverter x:Key="NodeToColorConverter" />
    </UserControl.Resources>

    <TreeView Name="FileTree" ItemsSource="{Binding RootItems}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <TreeView.Styles>
            <Style Selector="Separator">
                <Setter Property="IsVisible" Value="False" />
            </Style>

            <Style Selector="TreeViewItem" x:DataType="projects:FileSystemNode">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                <Setter Property="ContextFlyout">
                    <MenuFlyout>
                        <MenuItem Header="Open"
                                  Icon="{markup:SymbolIcon Symbol=Open}"
                                  IsVisible="{Binding CanOpen}"
                                  Command="{Binding OpenCommand}" />

                        <MenuItem Header="Download"
                                  Icon="{markup:SymbolIcon Symbol=ArrowDownload}"
                                  IsVisible="{Binding CanDownload}"
                                  Command="{Binding $parent[UserControl].((controls:FileTreeViewModel)DataContext)?.DownloadCommand}"
                                  CommandParameter="{Binding}" />

                        <MenuItem Header="-" IsVisible="{Binding IsDirectory}" />

                        <MenuItem Header="New..."
                                  Icon="{markup:SymbolIcon Symbol=Add}"
                                  IsVisible="{Binding IsDirectory}">
                            <MenuItem Header="File"
                                      Icon="{markup:SymbolIcon Symbol=DocumentAdd}"
                                      Command="{Binding $parent[UserControl].((controls:FileTreeViewModel)DataContext)?.NewFileCommand}"
                                      CommandParameter="{Binding}" />
                            <MenuItem Header="Folder"
                                      Icon="{markup:SymbolIcon Symbol=FolderAdd}"
                                      Command="{Binding $parent[UserControl].((controls:FileTreeViewModel)DataContext)?.NewFolderCommand}"
                                      CommandParameter="{Binding}" />
                        </MenuItem>

                        <MenuItem Header="-" IsVisible="{Binding CanRenameDelete}" />
                        <MenuItem Header="Rename"
                                  Icon="{markup:SymbolIcon Symbol=Rename}"
                                  IsVisible="{Binding CanRenameDelete}"
                                  HotKey="F2" InputGesture="F2"
                                  Command="{Binding $parent[UserControl].((controls:FileTreeViewModel)DataContext)?.RenameCommand}"
                                  CommandParameter="{Binding}" />

                        <MenuItem Header="Delete"
                                  Icon="{markup:SymbolIcon Symbol=Delete}"
                                  IsVisible="{Binding CanRenameDelete}"
                                  HotKey="Delete" InputGesture="Delete"
                                  Command="{Binding $parent[UserControl].((controls:FileTreeViewModel)DataContext)?.DeleteCommand}"
                                  CommandParameter="{Binding}" />

                        <MenuItem Header="-" />

                        <MenuItem Header="Copy Path"
                                  Icon="{markup:SymbolIcon Symbol=Copy}"
                                  Command="{Binding $parent[UserControl].((controls:FileTreeViewModel)DataContext)?.CopyPathCommand}"
                                  CommandParameter="{Binding}" />

                        <MenuItem Header="Copy Relative Path"
                                  Icon="{markup:SymbolIcon Symbol=Link}"
                                  IsVisible="{Binding CanCopyRelativePath}"
                                  Command="{Binding $parent[UserControl].((controls:FileTreeViewModel)DataContext)?.CopyRelativePathCommand}"
                                  CommandParameter="{Binding}" />

                        <MenuItem Header="Open in Explorer"
                                  Icon="{markup:SymbolIcon Symbol=FolderOpen}"
                                  IsVisible="{Binding CanOpenInExplorer}"
                                  Command="{Binding $parent[UserControl].((controls:FileTreeViewModel)DataContext)?.OpenInExplorerCommand}"
                                  CommandParameter="{Binding}" />

                        <MenuItem Header="-" IsVisible="{Binding IsRoot}" />

                        <MenuItem Header="Refresh"
                                  Icon="{markup:SymbolIcon Symbol=ArrowClockwise}"
                                  IsVisible="{Binding CanRefresh}"
                                  Command="{Binding $parent[UserControl].((controls:FileTreeViewModel)DataContext)?.RefreshCommand}"
                                  CommandParameter="{Binding}" />

                        <MenuItem Header="Edit Connection"
                                  Icon="{markup:SymbolIcon Symbol=Server}"
                                  IsVisible="{Binding CanEditConnection}"
                                  Command="{Binding $parent[UserControl].((controls:FileTreeViewModel)DataContext)?.EditConnectionCommand}"
                                  CommandParameter="{Binding}" />

                        <MenuItem Header="Close Workspace"
                                  IsVisible="{Binding CanCloseWorkspace}"
                                  Command="{Binding $parent[UserControl].((controls:FileTreeViewModel)DataContext)?.CloseWorkspaceCommand}"
                                  CommandParameter="{Binding}">
                            <MenuItem.Icon>
                                <fa:FAIconSourceElement IconSource="{StaticResource FolderDismissIcon}" />
                            </MenuItem.Icon>
                        </MenuItem>

                        <MenuItem Header="Disconnect"
                                  Icon="{markup:SymbolIcon Symbol=PlugDisconnected}"
                                  IsVisible="{Binding CanDisconnect}"
                                  Command="{Binding $parent[UserControl].((controls:FileTreeViewModel)DataContext)?.DisconnectCommand}"
                                  CommandParameter="{Binding}" />
                    </MenuFlyout>
                </Setter>
            </Style>

            <Style Selector="TextBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="#1EFFFFFF" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Padding" Value="4,2" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="MinHeight" Value="24" />
            </Style>

            <Style Selector="TreeView /template/ ScrollViewer">
                <Setter Property="Interaction.Behaviors">
                    <BehaviorCollection>
                        <behaviors:VerticalScrollViewerAnimatedBehavior />
                    </BehaviorCollection>
                </Setter>
            </Style>
        </TreeView.Styles>
        <TreeView.ItemTemplate>
            <TreeDataTemplate ItemsSource="{Binding Children}" DataType="projects:FileSystemNode">
                <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center" ColumnSpacing="8"
                      ToolTip.Tip="{Binding Name}" ToolTip.ShowDelay="750">
                    <Panel>
                        <Viewbox Width="17" Height="17">
                            <icons:SymbolIcon
                                Foreground="{Binding ., Converter={StaticResource NodeToColorConverter}}">
                                <icons:SymbolIcon.Symbol>
                                    <MultiBinding Converter="{StaticResource NodeToIconConverter}">
                                        <Binding Path="." />
                                        <Binding Path="IsExpanded" />
                                    </MultiBinding>
                                </icons:SymbolIcon.Symbol>
                            </icons:SymbolIcon>
                        </Viewbox>
                    </Panel>
                    <Panel Grid.Column="1">
                        <TextBlock IsVisible="{Binding !IsRenaming}" Text="{Binding Name}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />

                        <TextBox IsVisible="{Binding IsRenaming}"
                                 Text="{Binding Name}"
                                 Margin="-5,-3">
                            <Interaction.Behaviors>
                                <behaviors:FileTreeRenameBehavior />
                            </Interaction.Behaviors>
                        </TextBox>
                    </Panel>

                    <fa:FAProgressRing Grid.Column="2" IsActive="{Binding IsLoadingChildren}" Width="16" Height="16"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
            </TreeDataTemplate>
        </TreeView.ItemTemplate>
    </TreeView>
</UserControl>