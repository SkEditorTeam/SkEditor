<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:local="clr-namespace:SkEditor.Views.Controls"
             mc:Ignorable="d" d:DesignWidth="1800" d:DesignHeight="900"
             DataContext="{Binding RelativeSource={RelativeSource Self}}"
             x:CompileBindings="True"
             x:Class="SkEditor.Views.Controls.WelcomeTabControl">

    <UserControl.Resources>
        <DropShadowEffect x:Key="WelcomeScreenTextShadowEffect" Color="#64000000" BlurRadius="6" />
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button">
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource AccentButtonBackground}" />
            <Setter Property="Effect" Value="{StaticResource WelcomeScreenTextShadowEffect}" />

            <Style Selector="^:pointerover">
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="7" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="Foreground" Value="{DynamicResource AccentButtonBackgroundPointerOver}" />

            </Style>

            <Style Selector="^:pointerover TextBlock, ^:pressed TextBlock, ^:disabled TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource AccentButtonBackgroundPointerOver}" />
            </Style>

            <Style
                Selector="^:pointerover ui|IconSourceElement, ^:pressed ui|IconSourceElement, ^:disabled ui|IconSourceElement">
                <Setter Property="Foreground" Value="{DynamicResource AccentButtonBackgroundPointerOver}" />
            </Style>

            <Style Selector="^ TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Style>
    </UserControl.Styles>

    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="8">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="48">
                <Svg Name="SkEditorIcon" Path="/Assets/SkEditor.svg" Height="200" Width="200"/>
                <!-- <ui:IconSourceElement Name="SkEditorIcon" IconSource="{StaticResource SkEditorIcon}" Height="200" Width="200" /> -->
                <StackPanel Margin="0,0,0,20" VerticalAlignment="Center">
                    <TextBlock Text="SkEditor" FontSize="40" FontWeight="DemiBold"
                               Effect="{StaticResource WelcomeScreenTextShadowEffect}" />
                    <TextBlock Text="{Binding Version}" FontSize="26" FontWeight="Normal" Foreground="#ccffffff" />
                </StackPanel>
            </StackPanel>

            <ItemsRepeater ItemsSource="{Binding WelcomeSections}" VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Margin="50">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="100" Orientation="Horizontal" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate DataType="local:WelcomeTabControl+WelcomeScreenSection">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold"
                                       Effect="{StaticResource WelcomeScreenTextShadowEffect}" />
                            <ItemsRepeater ItemsSource="{Binding Entries}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="4" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate DataType="local:WelcomeTabControl+WelcomeScreenElement">
                                        <Button Command="{Binding Command}" Padding="5" HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left">
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <Viewbox Width="24" Height="24">
                                                    <ui:IconSourceElement IconSource="{Binding Icon}" />
                                                </Viewbox>
                                                <TextBlock Text="{Binding Name}" FontSize="16" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </StackPanel>
    </Viewbox>
</UserControl>