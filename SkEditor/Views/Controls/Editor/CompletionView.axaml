<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:editor="clr-namespace:SkEditor.ViewModels.Controls.Editor"
             xmlns:behaviors="clr-namespace:SkEditor.Behaviors"
             xmlns:fluent="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
             xmlns:completions="clr-namespace:SkEditor.Converters.Completions"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="editor:CompletionViewModel"
             Name="Root"
             x:Class="SkEditor.Views.Controls.Editor.CompletionView">

    <UserControl.Resources>
        <completions:CompletionIconConverter x:Key="CompletionIconConverter" />
        <completions:CompletionIconColorConverter x:Key="CompletionIconColorConverter" />
    </UserControl.Resources>
    
    <Border Background="{DynamicResource MenuFlyoutPresenterBackground}" BorderThickness="1"
            BorderBrush="{DynamicResource MenuFlyoutPresenterBorderBrush}"
            MaxHeight="140"
            Padding="2" Margin="0,4,0,0" CornerRadius="7">
        <ScrollViewer>
            <Interaction.Behaviors>
                <BehaviorCollection>
                    <behaviors:SmoothScrollBehavior />
                </BehaviorCollection>
            </Interaction.Behaviors>

            <ListBox SelectionMode="AlwaysSelected"
                     ItemsSource="{Binding CompletionList}"
                     SelectedItem="{Binding SelectedCompletion.Value, Mode=TwoWay}"
                     ItemContainerTheme="{DynamicResource CompletionListBoxItemTheme}">

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="2,0">

                            <fluent:SymbolIcon Grid.Column="0"
                                               Symbol="{Binding Type, Converter={StaticResource CompletionIconConverter}}"
                                               Foreground="{Binding Type, Converter={StaticResource CompletionIconColorConverter}}"
                                               FontSize="14"
                                               Margin="0,0,8,0" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding MatchedPrefix}" Foreground="#6587FF" />
                                <TextBlock Text="{Binding Remainder}" />
                            </StackPanel>

                            <TextBlock Grid.Column="2"
                                       Text="{Binding Description}"
                                       Foreground="{DynamicResource ForegroundColor}"
                                       FontSize="12"
                                       Margin="16,0,0,0"
                                       VerticalAlignment="Center" />

                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>
    </Border>
</UserControl>