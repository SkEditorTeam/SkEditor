<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:avaloniaedit="using:AvaloniaEdit"
             xmlns:tabs="clr-namespace:SkEditor.Models.Tabs"
             xmlns:pages="clr-namespace:SkEditor.Views.Pages"
             xmlns:converters="clr-namespace:SkEditor.Converters"
             xmlns:behaviors="clr-namespace:SkEditor.Behaviors"
             xmlns:windows="clr-namespace:SkEditor.Views.Windows"
             xmlns:vms="clr-namespace:SkEditor.ViewModels.Windows"
             x:Class="SkEditor.Views.Controls.MainTabView"
             x:DataType="vms:MainWindowViewModel">

    <UserControl.Resources>
        <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter" />
        <converters:EditorFontFamilyConverter x:Key="EditorFontFamilyConverter" />
        <converters:SymbolIconSourceConverter x:Key="SymbolIconSourceConverter" />
    </UserControl.Resources>

    <Panel VerticalAlignment="Stretch">
        <ui:TabView
            Opacity="{Binding !!Tabs.Count, Converter={StaticResource BoolToOpacityConverter}}"
            IsHitTestVisible="{Binding !!Tabs.Count}"
            Margin="0,-10,0,0" CanDragTabs="True"
            CanReorderTabs="True" VerticalAlignment="Stretch"
            TabItems="{Binding Tabs}" SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
            AddTabButtonCommand="{Binding NewTabCommand}">
            <ui:TabView.DataTemplates>
                <DataTemplate DataType="{x:Type tabs:FileTab}">
                    <avaloniaedit:TextEditor Document="{Binding Document}"
                                             ShowLineNumbers="True"
                                             Foreground="{DynamicResource EditorTextColor}"
                                             Background="{DynamicResource EditorBackgroundColor}"
                                             LineNumbersForeground="{DynamicResource LineNumbersColor}"
                                             FontSize="{Binding FontSize}"
                                             WordWrap="{Binding WordWrap}"
                                             ScrollOffset="{Binding ScrollOffset, Mode=TwoWay}"
                                             FontFamily="{Binding AppSettings.EditorFontFamily, Converter={StaticResource EditorFontFamilyConverter}}">
                        <Interaction.Behaviors>
                            <behaviors:TextEditorLoadBehavior />
                        </Interaction.Behaviors>
                    </avaloniaedit:TextEditor>
                </DataTemplate>

                <DataTemplate DataType="{x:Type tabs:SettingsTab}">
                    <pages:SettingsPage />
                </DataTemplate>
            </ui:TabView.DataTemplates>
            <ui:TabView.TabItemTemplate>
                <DataTemplate x:DataType="tabs:Tab">
                    <ui:TabViewItem Content="{Binding .}"
                                    IconSource="{Binding Icon, Converter={StaticResource SymbolIconSourceConverter}}">
                        <ui:TabViewItem.Header>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock Text="{Binding Header.Value}"
                                           ToolTip.Tip="{Binding Header.Value}"
                                           TextTrimming="CharacterEllipsis" />
                                <Ellipse
                                    Grid.Column="1"
                                    IsVisible="{Binding !IsSaved}"
                                    Width="4" Height="4"
                                    Fill="{Binding $parent[ContentPresenter].Foreground}"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </ui:TabViewItem.Header>
                        <Interaction.Behaviors>
                            <ui:TabViewItemCloseRequestedEventCommandTrigger
                                Command="{Binding CloseCommand}" />
                        </Interaction.Behaviors>
                    </ui:TabViewItem>
                </DataTemplate>
            </ui:TabView.TabItemTemplate>
        </ui:TabView>

        <pages:WelcomePage VerticalAlignment="Stretch" DataContext="{Binding WelcomePage}"
                           IsVisible="{Binding !$parent[windows:MainWindow].((vms:MainWindowViewModel)DataContext).Tabs.Count}" />
    </Panel>
</UserControl>