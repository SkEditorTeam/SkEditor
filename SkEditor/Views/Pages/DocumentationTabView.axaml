<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:tabs="clr-namespace:SkEditor.ViewModels.Tabs"
             xmlns:behaviors="clr-namespace:SkEditor.Behaviors"
             xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:avaloniaEdit="https://github.com/avaloniaui/avaloniaedit"
             xmlns:documentation="clr-namespace:SkEditor.Converters.Documentation"
             xmlns:fluent="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
             mc:Ignorable="d" d:DesignWidth="800"
             x:CompileBindings="True"
             x:DataType="tabs:DocumentationTabViewModel"
             Focusable="True"
             x:Class="SkEditor.Views.Pages.DocumentationTabView">

    <UserControl.Resources>
        <documentation:DocumentationSyntaxIconConverter x:Key="SyntaxIconConverter" />
        <documentation:DocumentationSyntaxTypeNameConverter x:Key="SyntaxTypeNameConverter" />
        <documentation:DocumentationSyntaxTypeBrushConverter x:Key="SyntaxTypeColorConverter" />
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*" Margin="16" RowSpacing="32" ColumnSpacing="32">

        <!-- Filters and search -->
        <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="12" HorizontalAlignment="Center">
            <ComboBox ItemsSource="{Binding SyntaxTypes}"
                      SelectedItem="{Binding SelectedSyntaxType, Mode=TwoWay}"
                      Width="150" Padding="16,8">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Viewbox Height="18">
                                <controls:FAIconSourceElement
                                    IconSource="{Binding ., Converter={StaticResource SyntaxIconConverter}}"
                                    Foreground="{Binding ., Converter={StaticResource SyntaxTypeColorConverter}}" />
                            </Viewbox>
                            <TextBlock Text="{Binding ., Converter={StaticResource SyntaxTypeNameConverter}}"
                                       Margin="0,-1,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBox Grid.Column="1" Width="400" PlaceholderText="Type your query..."
                     Text="{Binding SearchText, Mode=TwoWay}" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="32"
              IsVisible="{Binding SelectedEntry, Converter={x:Static ObjectConverters.IsNotNull}}">
            <!-- List of all elements -->
            <ListBox Grid.Column="0" ItemsSource="{Binding FilteredEntries}" Width="300"
                     HorizontalAlignment="Left" SelectionMode="AlwaysSelected"
                     SelectedItem="{Binding SelectedEntry, Mode=TwoWay}">
                <ListBox.Styles>
                    <Style Selector="ListBox /template/ ScrollViewer">
                        <Setter Property="Interaction.Behaviors">
                            <BehaviorCollection>
                                <behaviors:SmoothScrollBehavior />
                            </BehaviorCollection>
                        </Setter>
                    </Style>
                </ListBox.Styles>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <controls:FAIconSourceElement
                                IconSource="{Binding Type, Converter={StaticResource SyntaxIconConverter}}"
                                Foreground="{Binding Type, Converter={StaticResource SyntaxTypeColorConverter}}"
                                Width="24" Height="24" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Name}" FontSize="16" TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MaxWidth="240" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Selected item view -->
            <Border Grid.Column="1"
                    Background="{DynamicResource SkEditorBorderBackground}" CornerRadius="7"
                    Padding="24,24,0,24">
                <ScrollViewer Padding="0,0,24,0">
                    <Interaction.Behaviors>
                        <behaviors:SmoothScrollBehavior />
                    </Interaction.Behaviors>
                    <DockPanel VerticalSpacing="24" LastChildFill="False">
                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="16" DockPanel.Dock="Top">
                            <Viewbox Height="28" VerticalAlignment="Center">
                                <controls:FAIconSourceElement
                                    Foreground="{Binding SelectedEntry?.Type, Converter={StaticResource SyntaxTypeColorConverter}}"
                                    IconSource="{Binding SelectedEntry?.Type, Converter={StaticResource SyntaxIconConverter}}" />
                            </Viewbox>
                            <TextBlock Grid.Column="1" Text="{Binding SelectedEntry?.Name}" FontSize="24"
                                       FontWeight="DemiBold"
                                       VerticalAlignment="Center" Margin="0,-1,0,0" />

                            <StackPanel Grid.Column="2" HorizontalAlignment="Right" Orientation="Horizontal"
                                        Spacing="8">
                                <Border Background="{DynamicResource SkEditorBorderBackground}" CornerRadius="7"
                                        Padding="20,8">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Viewbox Height="18" VerticalAlignment="Center">
                                            <fluent:SymbolIcon Symbol="PuzzlePiece" />
                                        </Viewbox>
                                        <TextBlock Text="{Binding SelectedEntry?.Addon}" FontSize="16"
                                                   VerticalAlignment="Center" Padding="0,0,0,1" />
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource SkEditorBorderBackground}" CornerRadius="7"
                                        Padding="20,8">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Viewbox Height="18" VerticalAlignment="Center">
                                            <fluent:SymbolIcon Symbol="History" />
                                        </Viewbox>
                                        <TextBlock Text="{Binding SelectedEntry?.Version}" FontSize="16"
                                                   VerticalAlignment="Center" Padding="0,0,0,1" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding SelectedEntry?.Description}" FontSize="16" TextWrapping="Wrap"
                                   DockPanel.Dock="Top"
                                   IsVisible="{Binding SelectedEntry?.Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                        <Border Background="{DynamicResource SkEditorBorderBackground}" CornerRadius="7"
                                Padding="20,12"
                                DockPanel.Dock="Top">
                            <avaloniaEdit:TextEditor Name="PatternEditor" ShowLineNumbers="False"
                                                     IsReadOnly="True"
                                                     WordWrap="True"
                                                     Document="{Binding PatternDocument}"
                                                     Foreground="{DynamicResource EditorTextColor}"
                                                     Background="Transparent"
                                                     LineNumbersForeground="{DynamicResource LineNumbersColor}"
                                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     FontSize="16"
                                                     FontFamily="{DynamicResource JetBrainsFont}" />
                        </Border>
                    </DockPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.5"
                    Spacing="16" IsVisible="{Binding SelectedEntry, Converter={x:Static ObjectConverters.IsNull}}">
            <fluent:SymbolIcon Symbol="WeatherSqualls" FontSize="64" />
            <TextBlock Text="No results found" FontSize="24" />
        </StackPanel>
    </Grid>
</UserControl>