<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:tabs="clr-namespace:SkEditor.ViewModels.Tabs"
             xmlns:behaviors="clr-namespace:SkEditor.Behaviors"
             xmlns:iconverters="clr-namespace:SkEditor.Converters.Icons"
             xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             mc:Ignorable="d" d:DesignWidth="800"
             x:CompileBindings="True"
             x:DataType="tabs:DocumentationTabViewModel"
             Focusable="True"
             x:Class="SkEditor.Views.Pages.DocumentationTabView">

    <UserControl.Resources>
        <iconverters:StandardIconSourceConverter x:Key="StandardIconSourceConverter" />
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*" Margin="16" RowSpacing="32">
        <Button HorizontalAlignment="Center" VerticalAlignment="Top" Command="{Binding TestDocsCommand}" Content="Test" />

        <ListBox Grid.Row="1" ItemsSource="{Binding DocumentationEntries}" Width="300" HorizontalAlignment="Left">
            <ListBox.Styles>
                <Style Selector="ListBox /template/ ScrollViewer">
                    <Setter Property="Interaction.Behaviors">
                        <BehaviorCollection>
                            <behaviors:SmoothScrollBehavior />
                        </BehaviorCollection>
                    </Setter>
                </Style>
            </ListBox.Styles>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <controls:FAIconSourceElement
                            IconSource="{Binding Icon, Converter={StaticResource StandardIconSourceConverter}}"
                            Width="24" Height="24" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="DemiBold" TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>