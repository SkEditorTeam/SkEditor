<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:icons="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             xmlns:vms="clr-namespace:SkEditor.ViewModels.Pages"
             xmlns:viewModels="clr-namespace:SkEditor.ViewModels"
             xmlns:converters="clr-namespace:SkEditor.Converters"
             xmlns:localization="clr-namespace:SkEditor.Utilities.Localization"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             DataContext="{x:Static viewModels:ViewModelLocator.WelcomePageViewModel}"
             x:DataType="vms:WelcomePageViewModel"
             x:CompileBindings="True"
             x:Class="SkEditor.Views.Pages.WelcomePage">

    <UserControl.Resources>
        <system:TimeSpan x:Key="ButtonTransitionDuration">0:0:0.1</system:TimeSpan>

        <converters:WidthToVisibilityConverter x:Key="WidthToVisibilityConverter" />
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button">
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Background" Value="#08FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Foreground" Value="#E8E8E8" />

            <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Transitions">
                    <Transitions>
                        <BrushTransition Duration="{StaticResource ButtonTransitionDuration}" Property="Background" />
                        <BrushTransition Duration="{StaticResource ButtonTransitionDuration}" Property="Foreground" />
                    </Transitions>
                </Setter>
            </Style>

            <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="#15FFFFFF" />
                <Setter Property="Foreground" Value="{DynamicResource AccentButtonBackground}" />
            </Style>

            <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="#20FFFFFF" />
                <Setter Property="Foreground" Value="{DynamicResource AccentButtonBackground}" />
            </Style>
        </Style>
    </UserControl.Styles>

    <Grid Name="MainGrid" ColumnDefinitions="450, *" Margin="24">
        <StackPanel Grid.Column="0" Margin="16" Spacing="48" VerticalAlignment="Top">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="24">
                <Svg Name="SkEditorIcon" Path="/Assets/SkEditor.svg" Height="100" Width="100" />
                <StackPanel VerticalAlignment="Center" Margin="0,0,0,8">
                    <TextBlock Text="SkEditor" FontSize="36" FontWeight="DemiBold"
                               Effect="{StaticResource WelcomeScreenTextShadowEffect}" />
                    <TextBlock TextAlignment="Center" Text="{Binding Version}" FontSize="18" FontWeight="Normal"
                               Foreground="#ccffffff" />
                </StackPanel>
            </StackPanel>

            <ItemsRepeater ItemsSource="{Binding WelcomeSections}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="32" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate DataType="vms:WelcomePageViewModel+WelcomeScreenSection">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{Binding Title.Value}"
                                       TextAlignment="Center"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,0" />

                            <ItemsRepeater ItemsSource="{Binding Entries}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="6" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate DataType="vms:WelcomePageViewModel+WelcomeScreenElement">
                                        <Button HorizontalContentAlignment="Stretch" Command="{Binding Command}">
                                            <StackPanel Orientation="Horizontal" Spacing="16"
                                                        VerticalAlignment="Center">
                                                <Viewbox Width="24" Height="24">
                                                    <ui:IconSourceElement IconSource="{Binding Icon}" />
                                                </Viewbox>

                                                <TextBlock Text="{Binding Name.Value}"
                                                           VerticalAlignment="Center"
                                                           FontSize="16"
                                                           FontWeight="Normal" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </StackPanel>

        <Border Grid.Column="1"
                Name="RecentItemsPanel"
                Margin="24,16,16,16"
                Background="#01FFFFFF"
                BorderBrush="#0CFFFFFF"
                BorderThickness="2"
                CornerRadius="8"
                Padding="24,24,6,24"
                VerticalAlignment="Stretch"
                IsVisible="{Binding Bounds.Width, 
                                   RelativeSource={RelativeSource AncestorType=Grid}, 
                                   Converter={StaticResource WidthToVisibilityConverter}, 
                                   ConverterParameter=650}">
            <Grid RowDefinitions="Auto,*" RowSpacing="24">
                <TextBlock Text="{localization:Translate WelcomePageRecentTitle}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Grid.Row="0"
                           Margin="0,0,0,0" />

                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.5"
                            Spacing="10" IsVisible="{Binding !RecentItems.Count}">
                    <icons:SymbolIcon Symbol="History" FontSize="48" />
                    <TextBlock Text="{DynamicResource WelcomePageRecentEmpty}" />
                </StackPanel>
                <ScrollViewer Grid.Row="1" Padding="0,0,18,0" VerticalAlignment="Stretch" HorizontalAlignment="Center"
                              VerticalScrollBarVisibility="Auto" IsVisible="{Binding !!RecentItems.Count}">
                    <ItemsRepeater ItemsSource="{Binding RecentItems}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate DataType="vms:WelcomePageViewModel+WelcomeScreenRecentItem">
                                <Button HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Center">
                                    <DockPanel LastChildFill="True">
                                        <Viewbox Width="20" Height="20"
                                                 DockPanel.Dock="Left"
                                                 Margin="0,0,16,0">
                                            <icons:SymbolIcon Symbol="{Binding IconSymbol}" />
                                        </Viewbox>

                                        <TextBlock Text="{Binding PrettyLastOpened.Value}"
                                                   DockPanel.Dock="Right"
                                                   Opacity="0.8"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Right"
                                                   IsVisible="{Binding Bounds.Width, 
                                                       RelativeSource={RelativeSource AncestorType={x:Type Button}}, 
                                                       Converter={StaticResource WidthToVisibilityConverter}, 
                                                       ConverterParameter=450}" />

                                        <Grid RowDefinitions="Auto,Auto" Margin="0,0,12,0">
                                            <TextBlock Grid.Row="0"
                                                       Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis"
                                                       FontSize="14"
                                                       VerticalAlignment="Center" />

                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding DisplayPath}"
                                                       TextTrimming="CharacterEllipsis"
                                                       FontSize="12"
                                                       Opacity="0.5"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </DockPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>