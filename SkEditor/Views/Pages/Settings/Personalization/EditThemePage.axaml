<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:SkEditor.Views.Controls"
             xmlns:localization="clr-namespace:SkEditor.Utilities.Localization"
             mc:Ignorable="d" d:DesignWidth="800"
             x:Class="SkEditor.Views.Pages.Settings.Personalization.EditThemePage"
             x:CompileBindings="True">

    <Grid RowDefinitions="auto,*" Margin="20, 10, 20, 20">
        <controls:SettingsTitle Name="Title" Title="Edit theme" Grid.Row="0" />
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="8">
                <controls:ColorPickerSettingsExpander Name="WindowBackgroundExpander"
                                                      ExpanderHeader="{localization:Translate ThemeEditorWindowBackground}"
                                                      IsAlphaEnabled="False" />
                <controls:ColorPickerSettingsExpander Name="SmallWindowBackgroundExpander"
                                                      ExpanderHeader="{localization:Translate ThemeEditorSmallWindowBackground}"
                                                      IsAlphaEnabled="False" />
                <controls:ColorPickerSettingsExpander Name="EditorBackgroundExpander"
                                                      ExpanderHeader="{localization:Translate ThemeEditorEditorBackground}" />
                <controls:ColorPickerSettingsExpander Name="EditorForegroundExpander"
                                                      ExpanderHeader="{localization:Translate ThemeEditorEditorText}" />
                <controls:ColorPickerSettingsExpander Name="LineNumbersExpander"
                                                      ExpanderHeader="{localization:Translate ThemeEditorLineNumber}" />
                <controls:ColorPickerSettingsExpander Name="SelectionExpander"
                                                      ExpanderHeader="{localization:Translate ThemeEditorSelection}" />
                <controls:ColorPickerSettingsExpander Name="SelectedTabItemBackgroundExpander"
                                                      ExpanderHeader="{localization:Translate ThemeEditorSelectedTabBackground}" />
                <controls:ColorPickerSettingsExpander Name="SelectedTabItemBorderExpander"
                                                      ExpanderHeader="{localization:Translate ThemeEditorSelectedTabBorder}" />
                <controls:ColorPickerSettingsExpander Name="MenuBackgroundExpander"
                                                      ExpanderHeader="{localization:Translate ThemeEditorMenuBackground}" />
                <controls:ColorPickerSettingsExpander Name="MenuBorderExpander"
                                                      ExpanderHeader="{localization:Translate ThemeEditorMenuBorder}" />
                <controls:ColorPickerSettingsExpander Name="TextBoxFocusedBackgroundExpander"
                                                      ExpanderHeader="{localization:Translate ThemeEditorFocusedTextBoxBackground}" />
                <controls:ColorPickerSettingsExpander Name="CurrentLineBackgroundExpander"
                                                      ExpanderHeader="{localization:Translate ThemeEditorCurrentLineBackground}" />
                <controls:ColorPickerSettingsExpander Name="CurrentLineBorderExpander"
                                                      ExpanderHeader="{localization:Translate ThemeEditorCurrentLineBorder}" />
                <controls:ColorPickerSettingsExpander Name="SidebarIconForegroundExpander"
                                                      ExpanderHeader="{localization:Translate ThemeEditorSidebarIconForeground}" />
                <controls:ColorPickerSettingsExpander Name="SidebarIconSelectedForegroundExpander"
                                                      ExpanderHeader="{localization:Translate ThemeEditorSidebarIconSelectedForeground}" />
                <controls:ColorPickerSettingsExpander Name="AccentColorExpander"
                                                      ExpanderHeader="{localization:Translate ThemeEditorAccentColor}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>