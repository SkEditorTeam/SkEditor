<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:controls="clr-namespace:SkEditor.Views.Controls"
             xmlns:vms="clr-namespace:SkEditor.ViewModels"
             xmlns:icons="clr-namespace:FluentIcons.Avalonia.Fluent.Markup;assembly=FluentIcons.Avalonia.Fluent"
             xmlns:configs="clr-namespace:SkEditor.Utilities.Settings.Configs"
             xmlns:localization="clr-namespace:SkEditor.Utilities.Localization"
             mc:Ignorable="d" d:DesignWidth="800"
             x:CompileBindings="True"
             x:DataType="configs:AppSettings"
             DataContext="{x:Static vms:ViewModelLocator.AppSettings}"
             x:Class="SkEditor.Views.Pages.Settings.AboutPage">

    <UserControl.Resources>
        <vms:SettingsViewModel x:Key="SettingsViewModel" />
    </UserControl.Resources>

    <Grid RowDefinitions="auto,*" Margin="20, 10, 20, 20">
        <controls:SettingsTitle Name="Title" Title="{localization:Translate SettingsAboutTitle}" Grid.Row="0" />
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="8">

                <ui:SettingsExpander IconSource="{StaticResource AppIcon}"
                                     Description="{localization:Translate SettingsAboutSkEditorDescription}">
                    <ui:SettingsExpander.Header>
                        <Binding Source="{StaticResource SettingsViewModel}" Path="SkEditorString" />
                    </ui:SettingsExpander.Header>
                </ui:SettingsExpander>

                <ui:SettingsExpander Name="SupportSkEditorItem" Header="Support SkEditor"
                                     IconSource="{icons:SymbolIconSource Symbol=Heart}"
                                     Description="If you enjoy using SkEditor, consider supporting its development by buying me a coffee! Your support helps keep the project alive and thriving."
                                     IsClickEnabled="True" />

                <ui:SettingsExpander Name="DocumentationItem" Header="{localization:Translate SettingsAboutDocumentation}"
                                     IconSource="{icons:SymbolIconSource Symbol=Book}"
                                     Description="{localization:Translate SettingsAboutDocumentationDescription}"
                                     IsClickEnabled="True" />

                <ui:SettingsExpander Name="GitHubItem" Header="{localization:Translate SettingsAboutGithub}"
                                     IconSource="{StaticResource GitHubIcon}"
                                     Description="{localization:Translate SettingsAboutGithubDescription}"
                                     IsClickEnabled="True" />

                <ui:SettingsExpander Name="DiscordItem" Header="{localization:Translate SettingsAboutDiscord}"
                                     IconSource="{StaticResource DiscordIcon}"
                                     Description="{localization:Translate SettingsAboutDiscordDescription}"
                                     IsClickEnabled="True" />

                <ui:SettingsExpander Header="{localization:Translate SettingsAboutDevMode}"
                                     Description="{localization:Translate SettingsAboutDevModeDescription}"
                                     IconSource="{icons:SymbolIconSource Symbol=Flash}">
                    <ui:SettingsExpander.Footer>
                        <ToggleSwitch Name="DevModeToggleSwitch" IsChecked="{Binding IsDevModeEnabled}" />
                    </ui:SettingsExpander.Footer>
                </ui:SettingsExpander>

                <ui:SettingsExpander Name="AppDataItem" Header="{localization:Translate SettingsAboutAppdata}"
                                     IconSource="{icons:SymbolIconSource Symbol=Folder}"
                                     IsClickEnabled="True" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>