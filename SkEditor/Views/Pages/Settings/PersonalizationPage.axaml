<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:controls="clr-namespace:SkEditor.Views.Controls"
             xmlns:vms="clr-namespace:SkEditor.ViewModels"
             xmlns:icons="clr-namespace:FluentIcons.Avalonia.Fluent.Markup;assembly=FluentIcons.Avalonia.Fluent"
             xmlns:configs="clr-namespace:SkEditor.Utilities.Settings.Configs"
             xmlns:localization="clr-namespace:SkEditor.Utilities.Localization"
             mc:Ignorable="d" d:DesignWidth="800"
             x:CompileBindings="True"
             x:DataType="configs:AppSettings"
             DataContext="{x:Static vms:ViewModelLocator.AppSettings}"
             x:Class="SkEditor.Views.Pages.Settings.PersonalizationPage">

    <UserControl.Resources>
        <vms:SettingsViewModel x:Key="SettingsViewModel" />
    </UserControl.Resources>

    <Grid RowDefinitions="auto,*" Margin="20, 10, 20, 20">
        <controls:SettingsTitle Name="Title" Title="{localization:Translate SettingsPersonalizationTitle}" Grid.Row="0" />
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="8">
                <ui:SettingsExpander Name="ThemePageButton"
                                     Header="{localization:Translate SettingsPersonalizationTheme}"
                                     IconSource="{icons:SymbolIconSource Symbol=Color}"
                                     Description="{localization:Translate SettingsPersonalizationThemeDescription}"
                                     IsClickEnabled="True" />

                <ui:SettingsExpander Name="SyntaxPageButton"
                                     Header="{localization:Translate SettingsPersonalizationSyntax}"
                                     IconSource="{icons:SymbolIconSource Symbol=Code}"
                                     Description="{localization:Translate SettingsPersonalizationSyntaxDescription}"
                                     IsClickEnabled="True" />

                <ui:SettingsExpander Name="FontButton" Header="{localization:Translate SettingsPersonalizationFont}"
                                     IconSource="{icons:SymbolIconSource Symbol=TextFont}" IsClickEnabled="True">
                    <ui:SettingsExpander.Description>
                        <Binding Source="{StaticResource SettingsViewModel}" Path="CurrentFont" />
                    </ui:SettingsExpander.Description>
                </ui:SettingsExpander>

                <ui:SettingsExpander Header="{localization:Translate SettingsPersonalizationHighlightCurrentLine}"
                                     IconSource="{icons:SymbolIconSource Symbol=Highlight}">
                    <ui:SettingsExpander.Footer>
                        <ToggleSwitch Name="HighlightCurrentLineSwitch" IsChecked="{Binding HighlightCurrentLine}" />
                    </ui:SettingsExpander.Footer>
                </ui:SettingsExpander>

                <ui:SettingsExpander Header="{localization:Translate SettingsPersonalizationSidebarAnimations}"
                                     IconSource="{icons:SymbolIconSource Symbol=SlideTransition}"
                                     Description="{localization:Translate SettingsPersonalizationSidebarAnimationsDescription}">
                    <ui:SettingsExpander.Footer>
                        <ToggleSwitch Name="SidebarAnimationsToggleSwitch"
                                      IsChecked="{Binding IsSidebarAnimationEnabled}" />
                    </ui:SettingsExpander.Footer>
                </ui:SettingsExpander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>