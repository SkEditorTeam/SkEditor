<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:controls="clr-namespace:SkEditor.Views.Controls"
             xmlns:icons="clr-namespace:FluentIcons.Avalonia.Fluent.Markup;assembly=FluentIcons.Avalonia.Fluent"
             xmlns:localization="clr-namespace:SkEditor.Utilities.Localization"
             mc:Ignorable="d" d:DesignWidth="800"
             x:Class="SkEditor.Views.Pages.Settings.HomePage"
             x:CompileBindings="True">

    <Grid RowDefinitions="auto,*" Margin="20, 10, 20, 20">
        <controls:SettingsTitle Name="Title" Title="{localization:Translate SettingsHomeTitle}" HasBackButton="False"
                                Grid.Row="0" />
        <ScrollViewer Grid.Row="1">
            <StackPanel Name="ItemStackPanel" Spacing="8">
                <ui:SettingsExpander Name="GeneralItem" Header="{localization:Translate SettingsHomeGeneral}"
                                     IconSource="{icons:SymbolIconSource Symbol=Wrench}"
                                     Description="{localization:Translate SettingsHomeGeneralDescription}"
                                     IsClickEnabled="True" />

                <ui:SettingsExpander Name="PersonalizationItem"
                                     Header="{localization:Translate SettingsHomePersonalization}"
                                     IconSource="{icons:SymbolIconSource Symbol=PaintBrush}"
                                     Description="{localization:Translate SettingsHomePersonalizationDescription}"
                                     IsClickEnabled="True" />

                <ui:SettingsExpander Name="ExperimentsItem" Header="{localization:Translate SettingsHomeExperiments}"
                                     IconSource="{icons:SymbolIconSource Symbol=Beaker}"
                                     Description="{localization:Translate SettingsHomeExperimentsDescription}"
                                     IsClickEnabled="True" />

                <ui:SettingsExpander Name="ConnectionsItem" Header="{localization:Translate SettingsHomeConnections}"
                                     IconSource="{icons:SymbolIconSource Symbol=PlugConnected}"
                                     Description="{localization:Translate SettingsHomeConnectionsDescription}"
                                     IsClickEnabled="True" />

                <ui:SettingsExpander Name="AddonsItem" Header="{localization:Translate SettingsHomeAddons}"
                                     IconSource="{icons:SymbolIconSource Symbol=PuzzlePiece}"
                                     Description="{localization:Translate SettingsHomeAddonsDescription}"
                                     IsClickEnabled="True" />

                <ui:SettingsExpander Name="FileTypesItem" Header="{localization:Translate SettingsHomeFileTypes}"
                                     IconSource="{icons:SymbolIconSource Symbol=DocumentSettings}"
                                     Description="{localization:Translate SettingsHomeFileTypesDescription}"
                                     IsClickEnabled="True" />

                <ui:SettingsExpander Name="AboutItem" Header="{localization:Translate SettingsHomeAbout}"
                                     IconSource="{icons:SymbolIconSource Symbol=Info}"
                                     IsClickEnabled="True" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>