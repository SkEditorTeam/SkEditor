<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:behaviors="clr-namespace:SkEditor.Behaviors"
             xmlns:converters="clr-namespace:SkEditor.Converters"
             xmlns:dataTemplates="clr-namespace:SkEditor.DataTemplates"
             xmlns:models="clr-namespace:SkEditor.Models.Settings"
             xmlns:types="clr-namespace:SkEditor.Models.Settings.Types"
             xmlns:lconverters="clr-namespace:SkEditor.Converters.Layout"
             xmlns:iconverters="clr-namespace:SkEditor.Converters.Icons"
             xmlns:tabs="clr-namespace:SkEditor.ViewModels.Tabs"
             mc:Ignorable="d" d:DesignWidth="800"
             x:CompileBindings="True"
             x:DataType="tabs:SettingsTabViewModel"
             Focusable="True"
             x:Class="SkEditor.Views.Pages.SettingsTabView">

    <UserControl.Resources>
        <!-- ReSharper disable Xaml.RedundantResource -->
        <SolidColorBrush x:Key="NavigationViewContentBackground">Transparent</SolidColorBrush>
        <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush">Transparent</SolidColorBrush>
        <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
        <Thickness x:Key="SettingsExpanderPadding">16</Thickness>
        <GridLength x:Key="ToggleSwitchPreContentMargin">2</GridLength>
        <GridLength x:Key="ToggleSwitchPostContentMargin">2</GridLength>
        <!-- ReSharper restore Xaml.RedundantResource -->
        <iconverters:StandardIconSourceConverter x:Key="StandardIconSourceConverter" />
        <converters:InfoBarSeverityConverter x:Key="InfoBarSeverityConverter" />
        <lconverters:HorizontalAlignmentConverter x:Key="HorizontalAlignmentConverter" />
        <lconverters:OrientationConverter x:Key="OrientationConverter" />
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="controls|FASettingsExpanderItem /template/ ContentPresenter#FooterPresenter"
               x:DataType="models:SettingElement">
            <Setter Property="MaxWidth" Value="500" />
            <Setter Property="Width" Value="{Binding Width, FallbackValue=Auto}" />
        </Style>

        <Style Selector="controls|FANavigationView /template/ ScrollViewer#MenuItemsScrollViewer">
            <Setter Property="Interaction.Behaviors">
                <BehaviorCollectionTemplate>
                    <BehaviorCollection>
                        <behaviors:SmoothScrollBehavior />
                    </BehaviorCollection>
                </BehaviorCollectionTemplate>
            </Setter>
        </Style>

        <Style Selector="controls|FANavigationView /template/ ScrollViewer#FooterItemsScrollViewer">
            <Setter Property="Interaction.Behaviors">
                <BehaviorCollectionTemplate>
                    <BehaviorCollection>
                        <behaviors:SmoothScrollBehavior />
                    </BehaviorCollection>
                </BehaviorCollectionTemplate>
            </Setter>
        </Style>
    </UserControl.Styles>

    <UserControl.DataTemplates>
        <DataTemplate DataType="{x:Type types:ToggleSetting}">
            <ToggleSwitch IsChecked="{Binding IsToggled.Value}" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type types:IChoiceSetting}">
            <ComboBox ItemsSource="{Binding Options}"
                      SelectedItem="{Binding SelectedItem}"
                      DisplayMemberBinding="{Binding Display.Value}" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type types:INumberSetting}">
            <NumericUpDown Minimum="{Binding MinValue}"
                           Maximum="{Binding MaxValue}"
                           FormatString="{Binding FormatString}"
                           Value="{Binding Value, Mode=TwoWay}" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type types:TextSetting}">
            <TextBox Text="{Binding Text, Mode=TwoWay}" PasswordChar="{Binding PasswordChar}"
                     PlaceholderText="{Binding Placeholder.Value, FallbackValue={x:Null}}" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type types:ActionSetting}">
            <Button Content="{Binding Text}" Command="{Binding Command}" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type types:CompoundSetting}">
            <ItemsControl ItemsSource="{Binding Children}">
                <ItemsControl.Styles>
                    <Style Selector="ContentControl > :is(Control)">
                        <Setter Property="HorizontalAlignment"
                                Value="{Binding $parent[ItemsControl].((types:CompoundSetting)DataContext).IsVertical, Converter={StaticResource HorizontalAlignmentConverter}, FallbackValue=Right}" />
                    </Style>
                </ItemsControl.Styles>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="{Binding IsVertical, Converter={StaticResource OrientationConverter}}"
                                    Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="models:SettingElement">
                        <ContentControl Content="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>
    </UserControl.DataTemplates>

    <controls:FANavigationView Name="NavigationView" VerticalAlignment="Stretch" Margin="16,24,0,16"
                               PaneDisplayMode="Auto" OpenPaneLength="250"
                               ExpandedModeThresholdWidth="800"
                               CompactModeThresholdWidth="250"
                               MaxWidth="1080"
                               MenuItemsSource="{Binding SettingsCategories}"
                               SelectedItem="{Binding CurrentSection, Mode=TwoWay}"
                               IsSettingsVisible="False" IsPaneToggleButtonVisible="False">
        <controls:FANavigationView.MenuItemTemplate>
            <DataTemplate DataType="models:SettingSection">
                <controls:FANavigationViewItem Content="{Binding Name.Value}"
                                               IsExpanded="{Binding IsExpanded.Value, Mode=TwoWay}"
                                               IsVisible="{Binding IsVisible.Value}"
                                               SelectsOnInvoked="{Binding Selectable}"
                                               IconSource="{Binding Icon, Converter={StaticResource StandardIconSourceConverter}}"
                                               MenuItemsSource="{Binding Subsections}" />
            </DataTemplate>
        </controls:FANavigationView.MenuItemTemplate>

        <controls:FANavigationView.Content>
            <ScrollViewer Name="ScrollViewer" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                          Padding="24,4,24,24" VerticalScrollBarVisibility="Auto">
                <Interaction.Behaviors>
                    <behaviors:SmoothScrollBehavior />
                </Interaction.Behaviors>
                <ItemsRepeater ItemsSource="{Binding CurrentSection.Settings, FallbackValue={x:Null}}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="8" Orientation="Vertical" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <dataTemplates:SettingElementTemplateFactory>
                            <dataTemplates:SettingElementTemplateFactory.Templates>
                                <DataTemplate x:Key="StandardTemplate" x:DataType="models:SettingElement">
                                    <controls:FASettingsExpander
                                        Header="{Binding Name.Value}"
                                        IsVisible="{Binding IsVisible.Value}" IsEnabled="{Binding IsEnabled.Value}"
                                        IconSource="{Binding Icon, Converter={StaticResource StandardIconSourceConverter}}"
                                        Description="{Binding Description.Value, FallbackValue='{x:Null}'}"
                                        Footer="{Binding}" />
                                </DataTemplate>

                                <DataTemplate x:Key="ClickableTemplate" x:DataType="types:ClickableActionSetting">
                                    <controls:FASettingsExpander
                                        Header="{Binding Name.Value}"
                                        IsVisible="{Binding IsVisible.Value}" IsEnabled="{Binding IsEnabled.Value}"
                                        IconSource="{Binding Icon, Converter={StaticResource StandardIconSourceConverter}}"
                                        Description="{Binding Description.Value, FallbackValue='{x:Null}'}"
                                        IsClickEnabled="True"
                                        Command="{Binding Command}" />
                                </DataTemplate>

                                <DataTemplate x:Key="InfoTemplate" x:DataType="types:InfoSetting">
                                    <controls:FAInfoBar
                                        Title="{Binding Name.Value}"
                                        IsVisible="{Binding IsVisible.Value}" IsEnabled="{Binding IsEnabled.Value}"
                                        IconSource="{Binding Icon, Converter={StaticResource StandardIconSourceConverter}}"
                                        Message="{Binding Description.Value, FallbackValue='{x:Null}'}"
                                        IsOpen="True" IsClosable="False"
                                        Severity="{Binding Type, Converter={StaticResource InfoBarSeverityConverter}}" />
                                </DataTemplate>

                                <DataTemplate x:Key="ExpandableTemplate" x:DataType="types:ExpandableSetting">
                                    <controls:FASettingsExpander
                                        Header="{Binding Name.Value}"
                                        IsVisible="{Binding IsVisible.Value}" IsEnabled="{Binding IsEnabled.Value}"
                                        IconSource="{Binding Icon, Converter={StaticResource StandardIconSourceConverter}}"
                                        Description="{Binding Description.Value, FallbackValue='{x:Null}'}"
                                        ItemsSource="{Binding Children}">
                                        <controls:FASettingsExpander.ItemTemplate>
                                            <dataTemplates:ExpanderItemTemplateFactory>
                                                <dataTemplates:ExpanderItemTemplateFactory.Templates>
                                                    <DataTemplate x:Key="StandardExpanderItemTemplate"
                                                                  DataType="models:SettingElement">
                                                        <controls:FASettingsExpanderItem
                                                            Content="{Binding Name.Value}"
                                                            IsVisible="{Binding IsVisible.Value}"
                                                            IsEnabled="{Binding IsEnabled.Value}"
                                                            Description="{Binding Description.Value, FallbackValue='{x:Null}'}"
                                                            IconSource="{Binding Icon, Converter={StaticResource StandardIconSourceConverter}}"
                                                            Footer="{Binding}" />
                                                    </DataTemplate>

                                                    <DataTemplate x:Key="ClickableExpanderItemTemplate"
                                                                  DataType="types:ClickableActionSetting">
                                                        <controls:FASettingsExpanderItem
                                                            Content="{Binding Name.Value}"
                                                            IsVisible="{Binding IsVisible.Value}"
                                                            IsEnabled="{Binding IsEnabled.Value}"
                                                            Description="{Binding Description.Value, FallbackValue='{x:Null}'}"
                                                            IconSource="{Binding Icon, Converter={StaticResource StandardIconSourceConverter}}"
                                                            IsClickEnabled="True"
                                                            Command="{Binding Command}" />
                                                    </DataTemplate>

                                                    <DataTemplate x:Key="InfoExpanderItemTemplate"
                                                                  DataType="types:InfoSetting">
                                                        <controls:FASettingsExpanderItem Content="{Binding Name.Value}"
                                                                IsVisible="{Binding IsVisible.Value}"
                                                                IsEnabled="{Binding IsEnabled.Value}"
                                                                Description="{Binding Description.Value, FallbackValue='{x:Null}'}"
                                                                IconSource="{Binding Icon, Converter={StaticResource StandardIconSourceConverter}}">
                                                            <controls:FASettingsExpanderItem.Resources>
                                                                <x:Double x:Key="SettingsExpanderItemIconSize">20</x:Double>
                                                                <Thickness x:Key="SettingsExpanderItemPadding">22,10,16,10</Thickness>
                                                                <Thickness x:Key="SettingsExpanderItemContentMargin">37,0,0,0</Thickness>
                                                            </controls:FASettingsExpanderItem.Resources>
                                                        </controls:FASettingsExpanderItem>
                                                    </DataTemplate>
                                                </dataTemplates:ExpanderItemTemplateFactory.Templates>
                                            </dataTemplates:ExpanderItemTemplateFactory>
                                        </controls:FASettingsExpander.ItemTemplate>
                                    </controls:FASettingsExpander>
                                </DataTemplate>
                            </dataTemplates:SettingElementTemplateFactory.Templates>
                        </dataTemplates:SettingElementTemplateFactory>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
        </controls:FANavigationView.Content>
    </controls:FANavigationView>
</UserControl>