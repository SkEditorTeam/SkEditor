<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:avaloniaEdit="https://github.com/avaloniaui/avaloniaedit"
             xmlns:behaviors="clr-namespace:SkEditor.Behaviors"
             xmlns:converters="clr-namespace:SkEditor.Converters"
             xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:localization="clr-namespace:SkEditor.Utilities.Localization"
             xmlns:tabs1="clr-namespace:SkEditor.ViewModels.Tabs"
             xmlns:input="clr-namespace:Avalonia.Input"
             mc:Ignorable="d" d:DesignWidth="800"
             x:CompileBindings="True"
             x:DataType="{x:Type tabs1:FileTabViewModel}"
             x:Class="SkEditor.Views.Pages.FileTabView">

    <UserControl.Resources>
        <converters:EditorFontFamilyConverter x:Key="EditorFontFamilyConverter" />
    </UserControl.Resources>

    <Panel>
        <avaloniaEdit:TextEditor x:Name="Editor"
                                 Opacity="{Binding !IsLoading}"
                                 IsHitTestVisible="{Binding !IsLoading}"
                                 Focusable="{Binding !IsLoading}"
                                 Document="{Binding Document}"
                                 ShowLineNumbers="True"
                                 Foreground="{DynamicResource EditorTextColor}"
                                 Background="{DynamicResource EditorBackgroundColor}"
                                 LineNumbersForeground="{DynamicResource LineNumbersColor}"
                                 FontSize="{Binding FontSize}"
                                 WordWrap="{Binding WordWrap}"
                                 ScrollOffset="{Binding ScrollOffset, Mode=TwoWay}"
                                 CaretOffset="{Binding CaretOffset, Mode=TwoWay}"
                                 FontFamily="{Binding AppSettings.EditorFontFamily, Converter={StaticResource EditorFontFamilyConverter}}">
            <Interaction.Behaviors>
                <behaviors:TextEditorLoadBehavior />
                <input:InputElementGotFocusEventCommandTrigger Command="{Binding FocusCommand}" />
            </Interaction.Behaviors>
            <avaloniaEdit:TextEditor.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity"
                                      Duration="0:0:0.2"
                                      Easing="CubicEaseOut" />
                </Transitions>
            </avaloniaEdit:TextEditor.Transitions>
            <avaloniaEdit:TextEditor.Styles>
                <Style Selector="avaloniaEdit|TextEditor[IsHitTestVisible=False]">
                    <Setter Property="RenderTransform" Value="translateY(10px)" />
                </Style>
                <Style Selector="avaloniaEdit|TextEditor[IsHitTestVisible=True]">
                    <Setter Property="RenderTransform" Value="translateY(0px)" />
                    <Setter Property="Transitions">
                        <Transitions>
                            <TransformOperationsTransition Property="RenderTransform"
                                                           Duration="0:0:0.2"
                                                           Easing="CubicEaseOut" />
                        </Transitions>
                    </Setter>
                </Style>
                <Style Selector="avaloniaEdit|TextEditor avaloniaEdit|TextArea">
                    <Setter Property="Focusable"
                            Value="{Binding IsHitTestVisible, RelativeSource={RelativeSource AncestorType=avaloniaEdit:TextEditor}}" />
                </Style>
            </avaloniaEdit:TextEditor.Styles>
        </avaloniaEdit:TextEditor>

        <StackPanel Opacity="{Binding IsLoading}"
                    IsHitTestVisible="{Binding IsLoading}"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="16">

            <StackPanel.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity"
                                      Duration="0:0:0.15" />
                </Transitions>
            </StackPanel.Transitions>

            <controls:FAProgressRing IsIndeterminate="True"
                                     Width="32" Height="32"
                                     HorizontalAlignment="Center" />

            <TextBlock Text="{localization:Translate FileExplorerLoading}"
                       FontSize="18"
                       HorizontalAlignment="Center" />
        </StackPanel>
    </Panel>
</UserControl>