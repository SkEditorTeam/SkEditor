<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:icons="clr-namespace:FluentIcons.Avalonia.Fluent.Markup;assembly=FluentIcons.Avalonia.Fluent"
             xmlns:local="clr-namespace:SkEditor.Views.Pages"
             mc:Ignorable="d" d:DesignWidth="800"
             x:CompileBindings="True"
             DataContext="{Binding RelativeSource={RelativeSource Self}}"
             x:Class="SkEditor.Views.Pages.SettingsPage">

    <UserControl.Resources>
        <!-- ReSharper disable Xaml.RedundantResource -->
        <SolidColorBrush x:Key="NavigationViewContentBackground">Transparent</SolidColorBrush>
        <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush">Transparent</SolidColorBrush>
        <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
        <!-- ReSharper restore Xaml.RedundantResource -->
    </UserControl.Resources>
    
    <UserControl.DataTemplates>
        <DataTemplate DataType="{x:Type local:ToggleSetting}">
            <ToggleSwitch IsChecked="{Binding IsEnabled}" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:ActionSetting}">
            <Button Content="{Binding ButtonText}" />
        </DataTemplate>
    </UserControl.DataTemplates>

    <controls:NavigationView Name="NavigationView" VerticalAlignment="Stretch" PaneDisplayMode="Auto"
                             MaxWidth="1080"
                             IsSettingsVisible="False"
                             BorderBrush="Red" OpenPaneLength="280"
                             IsPaneToggleButtonVisible="False" Margin="16,16,0,16">
        <controls:NavigationView.MenuItems>
            <controls:NavigationViewItem Content="{DynamicResource SettingsHomeGeneral}" IsSelected="True"
                                         IconSource="{icons:SymbolIconSource Symbol=Wrench}" />
            <controls:NavigationViewItem Content="{DynamicResource SettingsHomePersonalization}"
                                         IconSource="{icons:SymbolIconSource Symbol=PaintBrush}" />
            <controls:NavigationViewItem Content="{DynamicResource SettingsHomeExperiments}"
                                         IconSource="{icons:SymbolIconSource Symbol=Beaker}" />
            <controls:NavigationViewItem Content="{DynamicResource SettingsHomeConnections}"
                                         IconSource="{icons:SymbolIconSource Symbol=PlugConnected}" />
            <controls:NavigationViewItem Content="{DynamicResource SettingsHomeAddons}"
                                         IconSource="{icons:SymbolIconSource Symbol=PuzzlePiece}" />
            <controls:NavigationViewItem Content="{DynamicResource SettingsHomeFileTypes}"
                                         IconSource="{icons:SymbolIconSource Symbol=DocumentSettings}" />
            <controls:NavigationViewItem Content="{DynamicResource SettingsHomeAbout}"
                                         IconSource="{icons:SymbolIconSource Symbol=Info}" />
        </controls:NavigationView.MenuItems>

        <controls:NavigationView.Content>
            <ScrollViewer Name="ScrollViewer" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                          Padding="24,4,24,24" VerticalScrollBarVisibility="Hidden">
                <ItemsRepeater ItemsSource="{Binding CurrentSection}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="8"
                                     Orientation="Vertical" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <controls:SettingsExpander Header="{Binding Name}"
                                                       IconSource="{Binding Icon}"
                                                       Description="{Binding Description}"
                                                       Footer="{Binding}">
                            </controls:SettingsExpander>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
        </controls:NavigationView.Content>
    </controls:NavigationView>
</UserControl>