<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:vms="clr-namespace:SkEditor.ViewModels.Pages"
             xmlns:viewModels="clr-namespace:SkEditor.ViewModels"
             xmlns:types="clr-namespace:SkEditor.Utilities.Settings.Models.Types"
             xmlns:models="clr-namespace:SkEditor.Utilities.Settings.Models"
             mc:Ignorable="d" d:DesignWidth="800"
             x:CompileBindings="True"
             DataContext="{x:Static viewModels:ViewModelLocator.SettingsPageViewModel}"
             x:DataType="vms:SettingsPageViewModel"
             x:Class="SkEditor.Views.Pages.SettingsPage">

    <UserControl.Resources>
        <!-- ReSharper disable Xaml.RedundantResource -->
        <SolidColorBrush x:Key="NavigationViewContentBackground">Transparent</SolidColorBrush>
        <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush">Transparent</SolidColorBrush>
        <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
        <Thickness x:Key="SettingsExpanderPadding">16</Thickness>
        <!-- ReSharper restore Xaml.RedundantResource -->
    </UserControl.Resources>

    <UserControl.DataTemplates>
        <DataTemplate DataType="{x:Type types:ToggleSetting}">
            <ToggleSwitch IsChecked="{Binding IsEnabled}" />
        </DataTemplate>
        
        <DataTemplate DataType="{x:Type types:IChoiceSetting}">
            <ComboBox ItemsSource="{Binding Options}" 
                      SelectedItem="{Binding SelectedItem}" />
        </DataTemplate>

        <!-- <DataTemplate DataType="{x:Type vms:ActionSetting}"> -->
        <!--     <Button Content="{Binding ButtonText}" /> -->
        <!-- </DataTemplate> -->
        <!-- -->
    </UserControl.DataTemplates>

    <controls:NavigationView Name="NavigationView" VerticalAlignment="Stretch" Margin="16,16,0,16"
                             PaneDisplayMode="Auto" OpenPaneLength="280"
                             MaxWidth="1080"
                             MenuItemsSource="{Binding SettingsCategories}"
                             SelectedItem="{Binding CurrentSection, Mode=TwoWay}"
                             IsSettingsVisible="False" IsPaneToggleButtonVisible="False">
        <controls:NavigationView.MenuItemTemplate>
            <DataTemplate DataType="models:SettingSection">
                <controls:NavigationViewItem Content="{Binding Name.Value}" IconSource="{Binding Icon}"
                                             MenuItemsSource="{Binding Subsections}" />
            </DataTemplate>
        </controls:NavigationView.MenuItemTemplate>

        <controls:NavigationView.Content>
            <ScrollViewer Name="ScrollViewer" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                          Padding="24,4,24,24" VerticalScrollBarVisibility="Hidden">
                <ItemsRepeater ItemsSource="{Binding CurrentSection.Settings}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="8"
                                     Orientation="Vertical" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate DataType="models:SettingElement">
                            <controls:SettingsExpander Header="{Binding Name.Value}"
                                                       IconSource="{Binding Icon}"
                                                       Description="{Binding Description.Value, FallbackValue='{x:Null}'}"
                                                       Footer="{Binding}" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
        </controls:NavigationView.Content>
    </controls:NavigationView>
</UserControl>