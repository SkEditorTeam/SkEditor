<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:icons="clr-namespace:FluentIcons.Avalonia.Fluent.Markup;assembly=FluentIcons.Avalonia.Fluent"
             xmlns:configs="clr-namespace:SkEditor.Utilities.Settings.Configs"
             xmlns:vms="clr-namespace:SkEditor.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800"
             x:CompileBindings="True"
             x:DataType="configs:AppSettings"
             DataContext="{x:Static vms:ViewModelLocator.AppSettings}"
             x:Class="SkEditor.Views.Pages.SettingsPage">

    <UserControl.Resources>
        <!-- ReSharper disable Xaml.RedundantResource -->
        <SolidColorBrush x:Key="NavigationViewContentBackground">Transparent</SolidColorBrush>
        <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush">Transparent</SolidColorBrush>
        <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
        <!-- ReSharper restore Xaml.RedundantResource -->
    </UserControl.Resources>

    <controls:NavigationView Name="NavigationView" VerticalAlignment="Stretch" PaneDisplayMode="Auto"
                             MaxWidth="1080"
                             IsSettingsVisible="False"
                             BorderBrush="Red" OpenPaneLength="280"
                             IsPaneToggleButtonVisible="False" Margin="16,16,0,16">
        <controls:NavigationView.MenuItems>
            <controls:NavigationViewItem Content="{DynamicResource SettingsHomeGeneral}" IsSelected="True"
                                         IconSource="{icons:SymbolIconSource Symbol=Wrench}" />
            <controls:NavigationViewItem Content="{DynamicResource SettingsHomePersonalization}"
                                         IconSource="{icons:SymbolIconSource Symbol=PaintBrush}" />
            <controls:NavigationViewItem Content="{DynamicResource SettingsHomeExperiments}"
                                         IconSource="{icons:SymbolIconSource Symbol=Beaker}" />
            <controls:NavigationViewItem Content="{DynamicResource SettingsHomeConnections}"
                                         IconSource="{icons:SymbolIconSource Symbol=PlugConnected}" />
            <controls:NavigationViewItem Content="{DynamicResource SettingsHomeAddons}"
                                         IconSource="{icons:SymbolIconSource Symbol=PuzzlePiece}" />
            <controls:NavigationViewItem Content="{DynamicResource SettingsHomeFileTypes}"
                                         IconSource="{icons:SymbolIconSource Symbol=DocumentSettings}" />
            <controls:NavigationViewItem Content="{DynamicResource SettingsHomeAbout}"
                                         IconSource="{icons:SymbolIconSource Symbol=Info}" />
        </controls:NavigationView.MenuItems>

        <controls:NavigationView.Content>
            <ScrollViewer VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Padding="24,4,24,24">
                <StackPanel Spacing="8">
                    <controls:SettingsExpander Header="{DynamicResource SettingsGeneralLanguage}"
                                               IconSource="{icons:SymbolIconSource Symbol=Earth}">
                        <controls:SettingsExpander.Footer>
                            <ComboBox Name="LanguageComboBox" />
                        </controls:SettingsExpander.Footer>
                    </controls:SettingsExpander>

                    <controls:SettingsExpander Header="{DynamicResource SettingsGeneralRpc}"
                                               IconSource="{StaticResource DiscordIcon}"
                                               Description="{DynamicResource SettingsGeneralRpcDescription}">
                        <controls:SettingsExpander.Footer>
                            <ToggleSwitch Name="RpcToggleSwitch"
                                          IsChecked="{Binding IsDiscordRichPresenceEnabled, Mode=OneTime}" />
                        </controls:SettingsExpander.Footer>
                    </controls:SettingsExpander>

                    <controls:SettingsExpander Header="{DynamicResource SettingsGeneralCheckForUpdates}"
                                               IconSource="{icons:SymbolIconSource Symbol=CloudSync}"
                                               Description="{DynamicResource SettingsGeneralCheckForUpdatesDescription}">
                        <controls:SettingsExpander.Footer>
                            <ToggleSwitch Name="CheckForUpdatesToggleSwitch"
                                          IsChecked="{Binding CheckForAppUpdates}" />
                        </controls:SettingsExpander.Footer>
                    </controls:SettingsExpander>

                    <controls:SettingsExpander Header="{DynamicResource SettingsGeneralWrapping}"
                                               IconSource="{icons:SymbolIconSource Symbol=TextWrap}"
                                               Description="{DynamicResource SettingsGeneralWrappingDescription}">
                        <controls:SettingsExpander.Footer>
                            <ToggleSwitch Name="WrappingToggleSwitch"
                                          IsChecked="{Binding IsWordWrapEnabled, Mode=OneTime}" />
                        </controls:SettingsExpander.Footer>
                    </controls:SettingsExpander>

                    <controls:SettingsExpander Header="{DynamicResource SettingsGeneralZoomSync}"
                                               IconSource="{icons:SymbolIconSource Symbol=ZoomIn}"
                                               Description="{DynamicResource SettingsGeneralZoomSyncDescription}">
                        <controls:SettingsExpander.Footer>
                            <ToggleSwitch Name="ZoomSyncToggleSwitch"
                                          IsChecked="{Binding IsEditorZoomLevelSyncEnabled, Mode=OneTime}" />
                        </controls:SettingsExpander.Footer>
                    </controls:SettingsExpander>
                    <controls:SettingsExpander Header="{DynamicResource SettingsGeneralSidebarWidthSync}"
                                               IconSource="{icons:SymbolIconSource Symbol=ColumnArrowRight}"
                                               Description="{DynamicResource SettingsGeneralSidebarWidthSyncDescription}">
                        <controls:SettingsExpander.Footer>
                            <ToggleSwitch Name="SidebarWidthSyncToggleSwitch"
                                          IsChecked="{Binding IsSidebarWidthSyncEnabled}" />
                        </controls:SettingsExpander.Footer>
                    </controls:SettingsExpander>

                    <controls:SettingsExpander Header="{DynamicResource SettingsGeneralTabType}"
                                               IconSource="{icons:SymbolIconSource Symbol=TextIndentIncrease}"
                                               Description="{DynamicResource SettingsGeneralTabTypeDescription}">
                        <controls:SettingsExpander.Footer>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <ComboBox Name="IndentationTypeComboBox">
                                    <ComboBoxItem Tag="tabs" Content="{DynamicResource SettingsGeneralTabTypeTabs}" />
                                    <ComboBoxItem Tag="spaces"
                                                  Content="{DynamicResource SettingsGeneralTabTypeSpaces}" />
                                </ComboBox>
                                <ComboBox Name="IndentationAmountComboBox">
                                    <ComboBoxItem Tag="1">1</ComboBoxItem>
                                    <ComboBoxItem Tag="2">2</ComboBoxItem>
                                    <ComboBoxItem Tag="3">3</ComboBoxItem>
                                    <ComboBoxItem Tag="4">4</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>
                        </controls:SettingsExpander.Footer>
                    </controls:SettingsExpander>

                    <controls:SettingsExpander Header="{DynamicResource SettingsGeneralAutoIndent}"
                                               IconSource="{icons:SymbolIconSource Symbol=ArrowAutofitWidth}"
                                               Description="{DynamicResource SettingsGeneralAutoIndentDescription}">
                        <controls:SettingsExpander.Footer>
                            <ToggleSwitch Name="AutoIndentToggleSwitch" IsChecked="{Binding IsAutoIndentEnabled}" />
                        </controls:SettingsExpander.Footer>
                    </controls:SettingsExpander>

                    <controls:SettingsExpander Header="{DynamicResource SettingsGeneralAutoPairing}"
                                               IconSource="{icons:SymbolIconSource Symbol=TextQuote}"
                                               Description="{DynamicResource SettingsGeneralAutoPairingDescription}">
                        <controls:SettingsExpander.Footer>
                            <ToggleSwitch Name="AutoPairingToggleSwitch" IsChecked="{Binding IsAutoPairingEnabled}" />
                        </controls:SettingsExpander.Footer>
                    </controls:SettingsExpander>

                    <controls:SettingsExpander Header="{DynamicResource SettingsGeneralPasteIndent}"
                                               IconSource="{icons:SymbolIconSource Symbol=ClipboardTextEdit}"
                                               Description="{DynamicResource SettingsGeneralPasteIndentDescription}">
                        <controls:SettingsExpander.Footer>
                            <ToggleSwitch Name="PasteIndentToggleSwitch"
                                          IsChecked="{Binding IsPasteIndentationEnabled}" />
                        </controls:SettingsExpander.Footer>
                    </controls:SettingsExpander>

                    <controls:SettingsExpander Header="{DynamicResource SettingsGeneralAutoSave}"
                                               IconSource="{icons:SymbolIconSource Symbol=SaveSync}"
                                               Description="{DynamicResource SettingsGeneralAutoSaveDescription}">
                        <controls:SettingsExpander.Footer>
                            <ToggleSwitch Name="AutoSaveToggleSwitch" IsChecked="{Binding IsAutoSaveEnabled}" />
                        </controls:SettingsExpander.Footer>
                    </controls:SettingsExpander>

                    <controls:SettingsExpander Header="{DynamicResource SettingsGeneralChangeChecker}"
                                               IconSource="{icons:SymbolIconSource Symbol=DocumentSync}"
                                               Description="{DynamicResource SettingsGeneralChangeCheckerDescription}">
                        <controls:SettingsExpander.Footer>
                            <ToggleSwitch Name="CheckForChangesToggleSwitch"
                                          IsChecked="{Binding CheckForExternalFileChanges}" />
                        </controls:SettingsExpander.Footer>
                    </controls:SettingsExpander>

                    <controls:SettingsExpander Header="{DynamicResource SettingsGeneralProjectSingleFolderClick}"
                                               IconSource="{icons:SymbolIconSource Symbol=FolderArrowRight}"
                                               Description="{DynamicResource SettingsGeneralProjectSingleFolderClickDescription}">
                        <controls:SettingsExpander.Footer>
                            <ToggleSwitch Name="ProjectSingleClickToggleSwitch"
                                          IsChecked="{Binding IsProjectSingleClickEnabled, Mode=OneTime}" />
                        </controls:SettingsExpander.Footer>
                    </controls:SettingsExpander>

                    <controls:SettingsExpander Header="{DynamicResource SettingsGeneralUseSplashScreen}"
                                               IconSource="{icons:SymbolIconSource Symbol=Image}"
                                               Description="{DynamicResource SettingsGeneralUseSplashScreenDescription}">
                        <controls:SettingsExpander.Footer>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <ComboBox
                                    SelectedIndex="{Binding SplashScreenModeIndex, Source={x:Static vms:ViewModelLocator.BinarySettings}}">
                                    <ComboBoxItem Content="{DynamicResource SettingsGeneralUseSplashScreenAuto}" />
                                    <ComboBoxItem Content="{DynamicResource SettingsGeneralUseSplashScreenEnabled}" />
                                    <ComboBoxItem
                                        Content="{DynamicResource SettingsGeneralUseSplashScreenDisabled}" />
                                </ComboBox>
                            </StackPanel>
                        </controls:SettingsExpander.Footer>
                    </controls:SettingsExpander>
                </StackPanel>
            </ScrollViewer>
        </controls:NavigationView.Content>
    </controls:NavigationView>
</UserControl>