<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:icons="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
             xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:pages="clr-namespace:SkEditor.ViewModels.Pages"
             xmlns:ia="using:Xaml.Behaviors.Interactions.Animated"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="1100"
             x:Class="SkEditor.Views.Pages.WhatsNewPage"
             x:DataType="pages:WhatsNewPageViewModel">

    <UserControl.Styles>
        <Style Selector="Border.feature-card">
            <Setter Property="Background" Value="#08FFFFFF" />
            <Setter Property="BorderBrush" Value="#0AFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="24" />
        </Style>

        <Style Selector="Border.change-item">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,10" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Interaction.Behaviors>
            <ia:VerticalScrollViewerAnimatedBehavior />
        </Interaction.Behaviors>
        <DockPanel MaxWidth="780"
                   HorizontalAlignment="Center"
                   Margin="48,48,48,0"
                   VerticalSpacing="32">

            <StackPanel HorizontalAlignment="Center" Spacing="12" DockPanel.Dock="Top">
                <Svg Path="/Assets/SkEditor.svg"
                     Height="80" Width="80"
                     HorizontalAlignment="Center">
                    <Svg.Effect>
                        <DropShadowEffect Color="#40000000"
                                          BlurRadius="20"
                                          OffsetX="0" OffsetY="4" />
                    </Svg.Effect>
                </Svg>

                <StackPanel Spacing="4" HorizontalAlignment="Center">
                    <TextBlock Text="What's New"
                               FontSize="36"
                               FontWeight="DemiBold"
                               HorizontalAlignment="Center" />

                    <TextBlock TextAlignment="Center" Text="{Binding Version}" FontSize="24" FontWeight="Normal"
                               Foreground="#ccffffff" />
                </StackPanel>
            </StackPanel>

            <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding FeaturedItems}"
                          IsVisible="{Binding FeaturedItems.Count}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" ItemSpacing="16" LineSpacing="16" ItemWidth="380" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="pages:WhatsNewPageViewModel+FeaturedItem">
                        <Border
                            Classes="feature-card">
                            <StackPanel Spacing="16">
                                <Border Background="#12FFFFFF"
                                        CornerRadius="10"
                                        Width="44" Height="44"
                                        HorizontalAlignment="Left">
                                    <Viewbox Height="20" Width="20">
                                        <controls:IconSourceElement IconSource="{Binding Icon}"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center" />
                                    </Viewbox>
                                </Border>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="16"
                                               FontWeight="SemiBold" />
                                    <TextBlock
                                        Text="{Binding Description}"
                                        FontSize="13"
                                        Foreground="#80FFFFFF"
                                        TextWrapping="Wrap"
                                        LineHeight="20" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Spacing="20" DockPanel.Dock="Top">
                <TextBlock Text="Also in this release" IsVisible="{Binding FeaturedItems.Count}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Foreground="#BBFFFFFF" />

                <Border HorizontalAlignment="Center">
                    <ItemsControl ItemsSource="{Binding Changes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Classes="change-item" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal" Spacing="14">
                                        <Viewbox Height="16" Width="16">
                                            <icons:SymbolIcon Symbol="CheckmarkCircle"
                                                              Foreground="{DynamicResource AccentButtonBackground}"
                                                              VerticalAlignment="Center"
                                                              Opacity="0.8" />
                                        </Viewbox>
                                        <TextBlock Text="{Binding .}"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"
                                                   Foreground="#AAFFFFFF" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>

            <Button FontSize="15"
                    Padding="16,8"
                    Margin="0,0,0,24"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" DockPanel.Dock="Bottom">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="Continue to SkEditor"
                               VerticalAlignment="Center" />
                    <Viewbox Height="16" Width="16">
                        <icons:SymbolIcon Symbol="ArrowRight"
                                          VerticalAlignment="Center" />
                    </Viewbox>
                </StackPanel>
            </Button>
        </DockPanel>
    </ScrollViewer>

</UserControl>