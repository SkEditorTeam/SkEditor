<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:SkEditor.Views.Controls"
        xmlns:notifications="clr-namespace:SkEditor.Views.Controls.Notifications"
        xmlns:windows="clr-namespace:SkEditor.ViewModels.Windows"
        xmlns:sidebar="clr-namespace:SkEditor.Views.Controls.Sidebar"
        xmlns:layout="clr-namespace:SkEditor.Converters.Layout"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="SkEditor.Views.Windows.MainWindow"
        x:DataType="windows:MainWindowViewModel"
        x:Name="Root"
        Background="{DynamicResource BackgroundColor}"
        Icon="/Assets/SkEditor.ico" MinWidth="450" MinHeight="250"
        Title="SkEditor" WindowStartupLocation="Manual" DragDrop.AllowDrop="True">

    <Window.Resources>
        <layout:DoubleToGridLengthConverter x:Key="DoubleToGridLengthConverter" />
        <layout:SidebarColumnMinWidthConverter x:Key="SidebarColumnMinWidthConverter" />
    </Window.Resources>

    <LayoutTransformControl Name="LayoutTransform">
        <Grid RowDefinitions="Auto,*">
            <Border Grid.Row="0" Padding="5" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                    Background="{DynamicResource TitleBarBackground}" WindowDecorationProperties.ElementRole="TitleBar">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Image Source="{StaticResource SkEditorLogo}" Margin="12,0,0,0" Height="20" Width="20" />
                    <controls:MainMenuControl DataContext="{Binding MainMenu}" Name="MainMenu" Margin="15,0,0,0"
                                              WindowDecorationProperties.ElementRole="User" />
                </StackPanel>
            </Border>
            <Separator Grid.Row="0" Height="1" Margin="0,1,0,0" VerticalAlignment="Bottom"
                       Background="{DynamicResource WindowBorderBrush}" />

            <Border Grid.Row="1" Padding="10,12,10,10" Background="{DynamicResource MainWindowGridBackground}">
                <Grid Name="CoreGrid" RowDefinitions="*,Auto" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition
                            Width="{Binding Sidebar.ColumnWidth, Mode=TwoWay, Converter={StaticResource DoubleToGridLengthConverter}}"
                            MinWidth="{Binding Sidebar.ColumnWidth, Converter={StaticResource SidebarColumnMinWidthConverter}}"
                            MaxWidth="800" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="300" />
                    </Grid.ColumnDefinitions>

                    <sidebar:SidebarControl Name="Sidebar" DataContext="{Binding Sidebar}" Grid.Column="0" Grid.Row="0" />

                    <sidebar:StatusBarControl DataContext="{Binding StatusBar}" Grid.Column="0" Grid.Row="1"
                                              Grid.ColumnSpan="3" />

                    <GridSplitter Name="Splitter" Grid.Column="1" Grid.Row="0" Background="Transparent"
                                  ResizeDirection="Columns"
                                  Width="10"
                                  IsHitTestVisible="{Binding Sidebar.SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}" />

                    <controls:MainTabView Grid.Column="2" Grid.Row="0" VerticalAlignment="Stretch" />
                </Grid>
            </Border>

            <notifications:SkEditorNotificationManager
                x:Name="NotificationManager"
                Grid.Row="1"
                Position="BottomRight"
                MaxItems="6"
                Margin="0,0,0,48"
                ClipToBounds="False"
                ZIndex="1000" />
        </Grid>
    </LayoutTransformControl>
</Window>