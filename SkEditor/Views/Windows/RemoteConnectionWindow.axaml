<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:fluent="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
        xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
        xmlns:viewModels="clr-namespace:SkEditor.ViewModels"
        xmlns:windows="clr-namespace:SkEditor.ViewModels.Windows"
        xmlns:converters="clr-namespace:SkEditor.Converters"
        xmlns:localization="clr-namespace:SkEditor.Utilities.Localization"
        mc:Ignorable="d"
        x:Class="SkEditor.Views.Windows.RemoteConnectionWindow" Icon="/Assets/SkEditor.ico"
        Title="{localization:Translate RemoteConnectionNewWindowTitle}" Height="500" Width="375" CanResize="False"
        DataContext="{x:Static viewModels:ViewModelLocator.RemoteConnectionViewModel}"
        x:DataType="windows:RemoteConnectionViewModel"
        WindowStartupLocation="CenterOwner" Theme="{StaticResource SmallWindowTheme}">

    <Window.Styles>
        <Style Selector="StackPanel > TextBlock">
            <Setter Property="Margin" Value="2,0,0,0" />
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="Padding" Value="12,6,0,6" />
        </Style>
    </Window.Styles>

    <Window.Resources>
        <converters:AuthMethodConverter x:Key="AuthMethodConverter" />
    </Window.Resources>

    <DockPanel Margin="20,12,20,20">

        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <Button Name="TestConnectionButton"
                    ToolTip.Tip="{localization:Translate RemoteConnectionTestConnectionTooltip}"
                    HorizontalAlignment="Left" IsEnabled="{Binding ConnectionInfo.ConnectionFieldsFilled}"
                    Command="{Binding TestConnectionCommand}">
                <fluent:SymbolIcon Symbol="Pulse" FontSize="18" />
            </Button>
            <Button Grid.Column="1" Name="AddConnectionButton" HorizontalAlignment="Stretch"
                    IsEnabled="{Binding ConnectionInfo.RequiredFieldsFilled}" Command="{Binding AddConnectionCommand}"
                    ToolTip.Tip="{localization:Translate RemoteConnectionAddConnectionMissingFields}"
                    ToolTip.ShowOnDisabled="True" ToolTip.ServiceEnabled="{Binding !ConnectionInfo.RequiredFieldsFilled}">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <fluent:SymbolIcon Symbol="Add" FontSize="18" />
                    <TextBlock Text="{localization:Translate RemoteConnectionAddButton}" FontSize="14" />
                </StackPanel>
            </Button>
        </Grid>

        <controls:InfoBar DockPanel.Dock="Bottom"
                          Theme="{DynamicResource LiteInfoBarTheme}"
                          Name="InfoBar" IsClosable="False"
                          Severity="{Binding InfoBarSeverity}"
                          IsOpen="{Binding InfoBarMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                          Message="{Binding InfoBarMessage}"
                          Margin="0,0,0,16"
                          MinHeight="32" MaxHeight="72" />

        <StackPanel Spacing="14">
            <StackPanel Spacing="4">
                <TextBlock Text="{localization:Translate RemoteConnectionFieldName}" />
                <TextBox Name="NameTextBox" Watermark="{localization:Translate RemoteConnectionFieldNamePlaceholder}"
                         Text="{Binding ConnectionInfo.Name}" />
            </StackPanel>

            <Grid ColumnDefinitions="2*,*" ColumnSpacing="8">
                <StackPanel Spacing="4">
                    <TextBlock Text="{localization:Translate RemoteConnectionFieldHost}" />
                    <TextBox Name="HostTextBox" Watermark="192.168.0.1" Text="{Binding ConnectionInfo.Host}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="{localization:Translate RemoteConnectionFieldPort}" />
                    <TextBox Name="PortTextBox" Watermark="22" Text="{Binding ConnectionInfo.Port}" />
                </StackPanel>
            </Grid>

            <StackPanel Spacing="4">
                <TextBlock Text="{localization:Translate RemoteConnectionFieldUsername}" />
                <TextBox Name="UsernameTextBox"
                         Watermark="{localization:Translate RemoteConnectionFieldUsernamePlaceholder}"
                         Text="{Binding ConnectionInfo.Username}" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="{localization:Translate RemoteConnectionFieldAuthMethod}" />
                <ComboBox HorizontalAlignment="Stretch"
                          ItemsSource="{Binding AuthMethods}" SelectedItem="{Binding ConnectionInfo.AuthMethod}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource AuthMethodConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <StackPanel Spacing="4" IsVisible="{Binding ConnectionInfo.IsPasswordAuth}">
                <TextBlock Text="{localization:Translate RemoteConnectionFieldPassword}" />
                <TextBox Name="PasswordTextBox" PasswordChar="●" Text="{Binding ConnectionInfo.Password}" />
            </StackPanel>

            <StackPanel Spacing="4" IsVisible="{Binding ConnectionInfo.IsPrivateKeyAuth}">
                <TextBlock Text="{localization:Translate RemoteConnectionFieldKeyFile}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox Name="KeyFileTextBox" Text="{Binding ConnectionInfo.KeyFilePath}" />
                    <Button Grid.Column="1" Content="{localization:Translate BrowseButton}" HorizontalAlignment="Right"
                            Command="{Binding BrowseKeyCommand}" />
                </Grid>
            </StackPanel>
        </StackPanel>

    </DockPanel>
</Window>