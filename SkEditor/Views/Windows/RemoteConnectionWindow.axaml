<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:fluent="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
        xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
        xmlns:viewModels="clr-namespace:SkEditor.ViewModels"
        xmlns:windows="clr-namespace:SkEditor.ViewModels.Windows"
        mc:Ignorable="d"
        x:Class="SkEditor.Views.Windows.RemoteConnectionWindow" Icon="/Assets/SkEditor.ico"
        Title="New Remote Connection" Height="500" Width="375" CanResize="False"
        DataContext="{x:Static viewModels:ViewModelLocator.RemoteConnectionViewModel}"
        x:DataType="windows:RemoteConnectionViewModel"
        WindowStartupLocation="CenterOwner" Theme="{StaticResource SmallWindowTheme}">

    <Window.Styles>
        <Style Selector="StackPanel > TextBlock">
            <Setter Property="Margin" Value="2,0,0,0" />
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="Padding" Value="12,6,0,6" />
        </Style>
    </Window.Styles>

    <Grid Margin="20,16,20,20">
        <StackPanel Spacing="16" Margin="0,0,0,50">
            <StackPanel Spacing="5">
                <TextBlock Text="Name" />
                <TextBox Name="NameTextBox" Watermark="Survival" />
            </StackPanel>
            <Grid ColumnDefinitions="2*,*" ColumnSpacing="8">
                <StackPanel Spacing="5">
                    <TextBlock Text="Host" />
                    <TextBox Name="HostTextBox" Watermark="192.168.0.1" Text="{Binding Host}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="5">
                    <TextBlock Text="Port" />
                    <TextBox Name="PortTextBox" Watermark="22" Text="{Binding Port}" />
                </StackPanel>
            </Grid>
            <StackPanel Spacing="5">
                <TextBlock Text="Username" />
                <TextBox Name="UsernameTextBox" Watermark="myusername" Text="{Binding Username}" />
            </StackPanel>
            <StackPanel Spacing="5">
                <TextBlock Text="Authorization Method" />
                <ComboBox HorizontalAlignment="Stretch" SelectedIndex="0">
                    <ComboBoxItem Content="Password" />
                    <ComboBoxItem Content="Public Key" />
                </ComboBox>
            </StackPanel>
            <StackPanel Spacing="5">
                <TextBlock Text="Password" />
                <TextBox Name="PasswordTextBox" PasswordChar="●" Text="{Binding Password}" />
            </StackPanel>
            
            <controls:InfoBar Name="InfoBar"
                              Severity="Error"
                              IsOpen="True"
                              IsClosable="True"
                              Message="Couldn't connect to the server"
                              VerticalAlignment="Bottom"
                              MinHeight="32">
            </controls:InfoBar>
        </StackPanel>

        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalAlignment="Bottom">
            <Button Name="TestConnectionButton"
                    ToolTip.Tip="Test the connection settings"
                    HorizontalAlignment="Left"
                    IsEnabled="{Binding RequiredFieldsFilled}">
                <fluent:SymbolIcon Symbol="Pulse" FontSize="18" />
            </Button>

            <Button Grid.Column="1" Name="AddConnectionButton" HorizontalAlignment="Stretch" IsEnabled="{Binding RequiredFieldsFilled}">
                <StackPanel Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center">
                    <fluent:SymbolIcon Symbol="Add" FontSize="18" />
                    <TextBlock Text="Add Connection" FontSize="14" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>