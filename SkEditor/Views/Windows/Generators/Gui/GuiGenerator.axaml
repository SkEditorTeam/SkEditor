<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vms="clr-namespace:SkEditor.ViewModels"
        xmlns:configs="clr-namespace:SkEditor.Utilities.Settings.Configs"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="SkEditor.Views.Windows.Generators.Gui.GuiGenerator" Icon="/Assets/SkEditor.ico"
        x:CompileBindings="True"
        x:DataType="configs:StateConfig"
        DataContext="{x:Static vms:ViewModelLocator.StateConfig}"
        Title="{DynamicResource WindowTitleGuiGenerator}" Height="500" Width="900" CanResize="False"
        WindowStartupLocation="CenterOwner" Theme="{StaticResource SmallWindowTheme}">

    <Grid RowDefinitions="auto, *, auto">
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
            <StackPanel Spacing="4" Margin="10">
                <TextBlock Text="{DynamicResource GuiGeneratorTitle}" />
                <TextBox Name="TitleTextBox" Width="175" />
            </StackPanel>
            <StackPanel Spacing="4" Margin="10">
                <TextBlock Text="{DynamicResource GuiGeneratorFunctionName}" />
                <TextBox Name="FunctionNameTextBox" Width="175" />
            </StackPanel>
            <StackPanel Spacing="4" Margin="10">
                <TextBlock Text="{DynamicResource GuiGeneratorRowQuantity}" />
                <TextBox Name="RowQuantityTextBox" Width="175" Text="6" />
            </StackPanel>
            <StackPanel Spacing="4" Margin="10">
                <TextBlock Text="{DynamicResource GuiGeneratorBackgroundItem}" />
                <Button Name="BackgroundItemButton" Width="175" Content="{DynamicResource SelectButton}" />
            </StackPanel>
        </StackPanel>
        <Grid x:Name="ItemGrid" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="1"
              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
              ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" />

        <CheckBox Grid.Row="2" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                  Name="UseSkriptGuiCheckBox" Content="{DynamicResource GuiGeneratorSkriptGui}" Margin="20,0,0,10"
                  IsChecked="{Binding GuiGeneratorSkriptGuiAddonUsed}" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12" Spacing="12">
            <Button Name="PreviewButton" Width="100" Content="{DynamicResource GuiGeneratorPreviewButton}"
                    HorizontalAlignment="Center" />
            <Button Name="GenerateButton" Width="100" Content="{DynamicResource GuiGeneratorGenerateButton}"
                    HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>