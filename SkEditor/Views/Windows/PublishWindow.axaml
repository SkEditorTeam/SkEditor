<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:localization="clr-namespace:SkEditor.Utilities.Localization"
        xmlns:windows="clr-namespace:SkEditor.ViewModels.Windows"
        mc:Ignorable="d"
        x:Class="SkEditor.Views.Windows.PublishWindow" Icon="/Assets/SkEditor.ico"
        Title="{localization:Translate WindowTitlePublish}" Height="400" Width="350" CanResize="False"
        x:DataType="windows:PublishWindowViewModel"
        WindowStartupLocation="CenterOwner" Theme="{StaticResource SmallWindowTheme}">

    <DockPanel Margin="20" VerticalSpacing="12">
        <ComboBox HorizontalAlignment="Stretch" DockPanel.Dock="Top"
                  ItemsSource="{Binding PublishTypes}" SelectedItem="{Binding SelectedType, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <ComboBox IsVisible="{Binding AreExtraFlagsSupported}" HorizontalAlignment="Stretch" DockPanel.Dock="Top"
                  ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" />

        <CheckBox IsVisible="{Binding AreExtraFlagsSupported}"
                  Content="{localization:Translate PublishWindowAnonymously}"
                  DockPanel.Dock="Top" />

        <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Spacing="12">
            <Grid ColumnDefinitions="*,auto" VerticalAlignment="Bottom" ColumnSpacing="6">
                <TextBox Name="ResultTextBox" IsReadOnly="True" Focusable="False"
                         Watermark="{localization:Translate PublishWindowResultLink}"
                         Grid.Column="0" />
                <Button Name="CopyButton" Width="35" Height="35" HorizontalAlignment="Right" Grid.Column="1"
                        FontSize="18">
                    <Button.Content>
                        <ui:SymbolIcon Symbol="Copy" />
                    </Button.Content>
                </Button>
            </Grid>
            <Button Name="PublishButton" Content="{localization:Translate PublishWindowPublishButton}"
                    HorizontalAlignment="Stretch" />
        </StackPanel>
    </DockPanel>
</Window>