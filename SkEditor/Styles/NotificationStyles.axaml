<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:icons="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
                    xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
                    x:CompileBindings="True">
    <Design.PreviewWith>
        <Border Padding="32" Background="#1f1f1f">
            <Border.DataTemplates>
                <DataTemplate DataType="INotification">
                    <StackPanel
                        Margin="12"
                        Spacing="8"
                        TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                        <StackPanel Spacing="8">
                            <Border CornerRadius="100" Height="32" Width="32" Background="#9656FF20">
                                <icons:SymbolIcon Symbol="Checkmark" Foreground="#56FF20" VerticalAlignment="Center"
                                                  HorizontalAlignment="Center" />
                            </Border>
                            <TextBlock FontWeight="DemiBold" Text="{Binding Title}" />
                        </StackPanel>
                        <TextBlock
                            MaxHeight="80"
                            Margin="0,0,12,0"
                            Text="{Binding Message}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </DataTemplate>
            </Border.DataTemplates>
            <NotificationCard NotificationType="Success">
                <NotificationCard.Content>
                    <Notification Title="Saved" Message="Your changes have been saved successfully." />
                </NotificationCard.Content>
            </NotificationCard>
        </Border>
    </Design.PreviewWith>

    <ControlTheme x:Key="{x:Type WindowNotificationManager}" TargetType="WindowNotificationManager">
        <Setter Property="Margin" Value="0 0" />
        <Setter Property="Template">
            <ControlTemplate>
                <ReversibleStackPanel Name="PART_Items">
                    <ReversibleStackPanel.DataTemplates>
                        <DataTemplate DataType="INotification">
                            <StackPanel Margin="0"
                                        TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        VerticalAlignment="Center">
                                <TextBlock FontWeight="DemiBold" Text="{Binding Title}" TextWrapping="Wrap" />
                                <TextBlock MaxHeight="80" Text="{Binding Message}" TextWrapping="Wrap" Opacity="0.8" />
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="x:String">
                            <TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding}"
                                       VerticalAlignment="Center" />
                        </DataTemplate>
                    </ReversibleStackPanel.DataTemplates>
                </ReversibleStackPanel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:topleft /template/ ReversibleStackPanel#PART_Items">
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <Style Selector="^:topright /template/ ReversibleStackPanel#PART_Items">
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

        <Style Selector="^:topcenter /template/ ReversibleStackPanel#PART_Items">
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <Style Selector="^:bottomleft /template/ ReversibleStackPanel#PART_Items">
            <Setter Property="ReverseOrder" Value="True" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <Style Selector="^:bottomright /template/ ReversibleStackPanel#PART_Items">
            <Setter Property="ReverseOrder" Value="True" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

        <Style Selector="^:bottomcenter /template/ ReversibleStackPanel#PART_Items">
            <Setter Property="ReverseOrder" Value="True" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type NotificationCard}" TargetType="NotificationCard">
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Width" Value="375" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="RenderTransformOrigin" Value="50%,75%" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource MenuFlyoutPresenterBorderBrush}" />
        <Setter Property="Background" Value="{DynamicResource MenuFlyoutPresenterBackground}" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="RenderTransform">
            <TransformGroup>
                <ScaleTransform />
                <TranslateTransform />
            </TransformGroup>
        </Setter>

        <Setter Property="Template">
            <ControlTemplate>
                <LayoutTransformControl Name="PART_LayoutTransformControl" UseRenderTransform="True">
                    <Border CornerRadius="{TemplateBinding CornerRadius}" BoxShadow="0 4 12 0 #64000000"
                            Margin="5 5 5 10">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                ClipToBounds="True"
                                Padding="12">

                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">
                                <Border Name="PART_IconBorder" Grid.Column="0" CornerRadius="100"
                                        Height="24" Width="24"
                                        VerticalAlignment="Center">
                                    <Viewbox Height="12" Width="12">
                                        <controls:IconSourceElement Name="PART_Icon" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Viewbox>
                                </Border>

                                <ContentControl Name="PART_Content" Grid.Column="1"
                                                Content="{TemplateBinding Content}"
                                                MinHeight="40" VerticalContentAlignment="Center" />
                            </Grid>

                        </Border>
                    </Border>
                </LayoutTransformControl>
            </ControlTemplate>
        </Setter>

        <ControlTheme.Animations>
            <Animation Duration="0:0:0.3" FillMode="Forward">
                <Animation.Easing>
                    <SplineEasing X1="0.175" Y1="0.885" X2="0.32" Y2="1.275" />
                </Animation.Easing>
                <KeyFrame Cue="0%">
                    <Setter Property="TranslateTransform.Y" Value="40" />
                    <Setter Property="ScaleTransform.ScaleX" Value="0.85" />
                    <Setter Property="ScaleTransform.ScaleY" Value="0.85" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="TranslateTransform.Y" Value="0" />
                    <Setter Property="ScaleTransform.ScaleX" Value="1" />
                    <Setter Property="ScaleTransform.ScaleY" Value="1" />
                </KeyFrame>
            </Animation>

            <Animation Duration="0:0:0.25" Easing="QuadraticEaseOut" FillMode="Forward">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1" />
                </KeyFrame>
            </Animation>
        </ControlTheme.Animations>

        <Style Selector="^[IsClosing=true] /template/ LayoutTransformControl#PART_LayoutTransformControl">
            <Setter Property="RenderTransformOrigin" Value="100%,50%" />
            <Style.Animations>
                <Animation Duration="0:0:0.4" Easing="CubicEaseIn" FillMode="Forward">
                    <KeyFrame Cue="0%">
                        <Setter Property="TranslateTransform.X" Value="0" />
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1" />
                    </KeyFrame>
                    <KeyFrame Cue="60%">
                        <Setter Property="TranslateTransform.X" Value="150" />
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="TranslateTransform.X" Value="150" />
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="ScaleTransform.ScaleY" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="^[IsClosing=true]">
            <Style.Animations>
                <Animation Duration="0:0:0.4" FillMode="Forward">
                    <KeyFrame Cue="100%">
                        <Setter Property="IsClosed" Value="True" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="^:information /template/ Border#PART_IconBorder">
            <Setter Property="Background" Value="#20325AFF" />
        </Style>
        <Style Selector="^:information /template/ controls|IconSourceElement#PART_Icon">
            <Setter Property="IconSource" Value="{StaticResource InfoNoCircleIcon}"/>
            <Setter Property="Foreground" Value="#29AEFF" />
            <Setter Property="RenderTransform">
                <TranslateTransform X="0.5" />
            </Setter>
        </Style>
        
        <Style Selector="^:success /template/ Border#PART_IconBorder">
            <Setter Property="Background" Value="#2056FF20" />
        </Style>
        <Style Selector="^:success /template/ controls|IconSourceElement#PART_Icon">
            <Setter Property="IconSource">
                <icons:SymbolIconSource Symbol="Checkmark" IconVariant="Filled"/>
            </Setter>
            <Setter Property="Foreground" Value="#56FF20" />
        </Style>

        <Style Selector="^:warning /template/ Border#PART_IconBorder">
            <Setter Property="Background" Value="#20FF6A3D" />
        </Style>
        <Style Selector="^:warning /template/ controls|IconSourceElement#PART_Icon">
            <Setter Property="IconSource">
                <icons:SymbolIconSource Symbol="Important"/>
            </Setter>
            <Setter Property="Foreground" Value="#FF7B34" />
            <Setter Property="RenderTransform">
                <TranslateTransform X="-1" />
            </Setter>
        </Style>

        <Style Selector="^:error /template/ Border#PART_IconBorder">
            <Setter Property="Background" Value="#20FF1B3E" />
        </Style>
        <Style Selector="^:error /template/ controls|IconSourceElement#PART_Icon">
            <Setter Property="IconSource">
                <icons:SymbolIconSource Symbol="Dismiss" IconVariant="Filled"/>
            </Setter>
            <Setter Property="Foreground" Value="#FF1B3E" />
            <Setter Property="RenderTransform">
                <TranslateTransform X="-1" />
            </Setter>
        </Style>
    </ControlTheme>
</ResourceDictionary>