<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avaloniaedit="https://github.com/avaloniaui/avaloniaedit"
        xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
        xmlns:uip="clr-namespace:FluentAvalonia.UI.Controls.Primitives;assembly=FluentAvalonia">
    <Style Selector="avaloniaedit|TextEditor /template/ Border">
        <Setter Property="CornerRadius" Value="0,7,7,7" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="ui|FATabView /template/ ContentPresenter#TabContentPresenter">
        <Setter Property="CornerRadius" Value="0,7,7,7" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="ui|FATabView /template/ uip|FATabViewListView#TabListView">
        <Setter Property="Margin" Value="-10,0,0,0" />
    </Style>
    <Style Selector="ui|FATabViewItem">
        <Setter Property="BorderThickness" Value="1,1,1,0" />
    </Style>
    <Style Selector="ui|FATabViewItem /template/ Canvas#SelectedBackgroundPathHost">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ui|FATabViewItem:icon /template/ Viewbox#IconBox">
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
    </Style>
</Styles>