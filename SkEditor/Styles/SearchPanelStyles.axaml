<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:search="https://github.com/avaloniaui/avaloniaedit"
                    xmlns:fluent="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
                    xmlns:localization1="clr-namespace:SkEditor.Core.Localization"
                    x:CompileBindings="True">
    <Design.PreviewWith>
        <Border Padding="20">
            <search:SearchPanel />
        </Border>
    </Design.PreviewWith>

    <ControlTheme x:Key="SearchPanelExpanderToggle" TargetType="ToggleButton"
                  BasedOn="{StaticResource {x:Type ToggleButton}}">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="Transparent" Padding="5">
                    <Viewbox Height="16" Width="16">
                        <fluent:SymbolIcon Symbol="ChevronRight" Foreground="{TemplateBinding Foreground}" />
                    </Viewbox>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:checked /template/ Viewbox fluent|SymbolIcon">
            <Setter Property="Symbol" Value="ChevronDown" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="SearchPanelTextBoxButton" TargetType="ToggleButton"
                  BasedOn="{StaticResource {x:Type ToggleButton}}">
        <Setter Property="Padding" Value="4" />
        <Setter Property="MinWidth" Value="22" />
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="CornerRadius" Value="4" />

        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#C5FFFFFF" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />

        <Style Selector="^:pointerover">
            <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="#0DFFFFFF" />
                <Setter Property="Foreground" Value="#FFFFFFFF" />
                <Setter Property="BorderBrush" Value="#15FFFFFF" />
            </Style>
        </Style>

        <Style Selector="^:pressed">
            <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="#08FFFFFF" />
                <Setter Property="Foreground" Value="#C5FFFFFF" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Style>
        </Style>

        <Style Selector="^:disabled">
            <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="#5DFFFFFF" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Style>
        </Style>

        <Style Selector="^:checked">
            <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="#1AFFFFFF" />
                <Setter Property="Foreground" Value="#FFFFFFFF" />
                <Setter Property="BorderBrush" Value="#2BFFFFFF" />
            </Style>

            <Style Selector="^:pointerover">
                <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="#24FFFFFF" />
                    <Setter Property="Foreground" Value="#FFFFFFFF" />
                    <Setter Property="BorderBrush" Value="#3AFFFFFF" />
                </Style>
            </Style>

            <Style Selector="^:pressed">
                <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="#15FFFFFF" />
                    <Setter Property="Foreground" Value="#C5FFFFFF" />
                    <Setter Property="BorderBrush" Value="#20FFFFFF" />
                </Style>
            </Style>

            <Style Selector="^:disabled">
                <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="#0DFFFFFF" />
                    <Setter Property="Foreground" Value="#5DFFFFFF" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                </Style>
            </Style>
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type search:SearchPanel}" TargetType="search:SearchPanel">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="BorderBrush" Value="{DynamicResource SearchPanelBorderBrush}" />
        <Setter Property="Background" Value="{DynamicResource SearchPanelBackgroundBrush}" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Margin" Value="0 8 16 0" />
        <Setter Property="FontSize" Value="{DynamicResource SearchPanelFontSize}" />
        <Setter Property="FontFamily" Value="{DynamicResource SearchPanelFontFamily}" />
        <Setter Property="NoMatchesFoundText" Value="{localization1:Translate SearchPanelNoMatchesFound}" />
        <Setter Property="MatchesFoundFormat" Value="{localization1:Translate SearchPanelMatchesFound}" />
        <Setter Property="SingleMatchText" Value="{localization1:Translate SearchPanelSingleMatch}" />
        <Setter Property="MatchOfFormat" Value="{localization1:Translate SearchPanelMatchOf}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Border"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        Background="{TemplateBinding Background}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Padding="10">
                    <Grid ColumnDefinitions="Auto,Auto,Auto"
                          RowDefinitions="Auto,Auto,Auto">
                        <ToggleButton Name="Expander"
                                      Theme="{StaticResource SearchPanelExpanderToggle}"
                                      VerticalAlignment="Center"
                                      IsVisible="{Binding !TextEditor.IsReadOnly, RelativeSource={RelativeSource TemplatedParent}}"
                                      IsChecked="{Binding IsReplaceMode, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      Grid.Column="0"
                                      Grid.Row="0"
                                      Width="16"
                                      Margin="0,0,8,0">
                            <ToolTip.Tip>
                                <TextBlock Text="{localization1:Translate SearchPanelToggleReplace}" />
                            </ToolTip.Tip>
                        </ToggleButton>
                        <StackPanel Orientation="Horizontal"
                                    Grid.Column="2"
                                    Grid.Row="0">
                            <TextBox PlaceholderText="{localization1:Translate SearchPanelFindLabel}"
                                     Theme="{StaticResource SearchBoxTheme}"
                                     Name="PART_searchTextBox"
                                     Width="265"
                                     Margin="0,0,0,0"
                                     Text="{Binding SearchPattern, RelativeSource={RelativeSource TemplatedParent}}">
                                <TextBox.InnerRightContent>
                                    <StackPanel Orientation="Horizontal">
                                        <ToggleButton Theme="{StaticResource SearchPanelTextBoxButton}"
                                                      IsChecked="{Binding $parent[search:SearchPanel].MatchCase, Mode=TwoWay}"
                                                      ToolTip.Tip="{localization1:Translate SearchPanelMatchCase}"
                                                      VerticalAlignment="Center">
                                            <Viewbox Height="12" Width="12">
                                                <fluent:SymbolIcon Symbol="TextCaseTitle"
                                                                   Foreground="{Binding $parent[ToggleButton].Foreground}" />
                                            </Viewbox>
                                        </ToggleButton>
                                        <ToggleButton Theme="{StaticResource SearchPanelTextBoxButton}"
                                                      IsChecked="{Binding $parent[search:SearchPanel].WholeWords, Mode=TwoWay}"
                                                      ToolTip.Tip="{localization1:Translate SearchPanelMatchWholeWords}"
                                                      Margin="3,0,0,0"
                                                      VerticalAlignment="Center">
                                            <Viewbox Height="12" Width="12">
                                                <fluent:SymbolIcon Symbol="TextWholeWord"
                                                                   Foreground="{Binding $parent[ToggleButton].Foreground}" />
                                            </Viewbox>
                                        </ToggleButton>
                                        <ToggleButton Theme="{StaticResource SearchPanelTextBoxButton}"
                                                      IsChecked="{Binding $parent[search:SearchPanel].UseRegex, Mode=TwoWay}"
                                                      ToolTip.Tip="{localization1:Translate SearchPanelUseRegex}"
                                                      Margin="3,0,5,0"
                                                      VerticalAlignment="Center">
                                            <Viewbox Height="12" Width="12">
                                                <fluent:SymbolIcon Symbol="TextPeriodAsterisk"
                                                                   Foreground="{Binding $parent[ToggleButton].Foreground}" />
                                            </Viewbox>
                                        </ToggleButton>
                                    </StackPanel>
                                </TextBox.InnerRightContent>
                            </TextBox>
                            <Button Margin="5,0,0,0"
                                    Width="34" Height="34"
                                    VerticalAlignment="Stretch"
                                    Command="{x:Static search:SearchCommands.FindPrevious}">
                                <ToolTip.Tip>
                                    <TextBlock Text="{localization1:Translate SearchPanelFindPrevious}" />
                                </ToolTip.Tip>
                                <Viewbox Height="16" Width="16">
                                    <fluent:SymbolIcon Symbol="ChevronUp"
                                                       Foreground="{Binding $parent[Button].Foreground}" />
                                </Viewbox>
                            </Button>
                            <Button Margin="3,0,0,0"
                                    VerticalAlignment="Stretch"
                                    Width="34" Height="34"
                                    Command="{x:Static search:SearchCommands.FindNext}">
                                <ToolTip.Tip>
                                    <TextBlock Text="{localization1:Translate SearchPanelFindNext}" />
                                </ToolTip.Tip>
                                <Viewbox Height="16" Width="16">
                                    <fluent:SymbolIcon Symbol="ChevronDown"
                                                       Foreground="{Binding $parent[Button].Foreground}" />
                                </Viewbox>
                            </Button>
                            <Button Margin="3,0,0,0"
                                    VerticalAlignment="Stretch"
                                    Width="34" Height="34"
                                    Command="{x:Static search:SearchCommands.CloseSearchPanel}"
                                    Focusable="True">
                                <Viewbox Height="16" Width="16">
                                    <fluent:SymbolIcon Symbol="Dismiss"
                                                       Foreground="{Binding $parent[Button].Foreground}" />
                                </Viewbox>
                            </Button>
                        </StackPanel>
                        <StackPanel Name="ReplaceButtons"
                                    IsVisible="{Binding #Expander.IsChecked}"
                                    Orientation="Horizontal"
                                    Margin="0 5 0 0 "
                                    Grid.Column="2"
                                    Grid.Row="1">
                            <TextBox PlaceholderText="{localization1:Translate SearchPanelReplaceLabel}"
                                     Theme="{StaticResource SearchBoxTheme}"
                                     Name="PART_replaceTextBox"
                                     IsVisible="{Binding IsReplaceMode, RelativeSource={RelativeSource TemplatedParent}}"
                                     Width="265"
                                     Margin="0 0 0 0"
                                     Text="{Binding ReplacePattern, RelativeSource={RelativeSource TemplatedParent}}">
                                <TextBox.InnerLeftContent>
                                    <fluent:SymbolIcon Symbol="ArrowSwap"
                                                       FontSize="{DynamicResource SearchBoxIconSize}"
                                                       Margin="{DynamicResource SearchBoxIconMargin}"
                                                       VerticalAlignment="Center" />
                                </TextBox.InnerLeftContent>
                            </TextBox>
                            <Button Margin="5, 0, 0, 0"
                                    VerticalAlignment="Stretch"
                                    Width="34" Height="34"
                                    Command="{x:Static search:SearchCommands.ReplaceNext}">
                                <ToolTip.Tip>
                                    <TextBlock Text="{localization1:Translate SearchPanelReplaceNext}" />
                                </ToolTip.Tip>
                                <Viewbox Height="16" Width="16">
                                    <fluent:SymbolIcon Symbol="ArrowForward"
                                                       Foreground="{Binding $parent[Button].Foreground}" />
                                </Viewbox>
                            </Button>
                            <Button Margin="3, 0, 0, 0"
                                    VerticalAlignment="Stretch"
                                    Width="34" Height="34"
                                    Command="{x:Static search:SearchCommands.ReplaceAll}">
                                <ToolTip.Tip>
                                    <TextBlock Text="{localization1:Translate SearchPanelReplaceAll}" />
                                </ToolTip.Tip>
                                <Viewbox Height="16" Width="16">
                                    <fluent:SymbolIcon Symbol="ArrowRepeatAll"
                                                       Foreground="{Binding $parent[Button].Foreground}" />
                                </Viewbox>
                            </Button>
                        </StackPanel>
                        <StackPanel Name="PART_MessageView"
                                    IsVisible="False"
                                    Orientation="Horizontal"
                                    Margin="0,6,0,0"
                                    Grid.Column="2"
                                    Grid.Row="2">
                            <TextBlock Name="PART_MessageContent"
                                       FontSize="11" />
                        </StackPanel>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^/template/ Button">
            <Setter Property="BorderThickness" Value="0" />
        </Style>

    </ControlTheme>
</ResourceDictionary>