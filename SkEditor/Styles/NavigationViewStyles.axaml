<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:uip="using:FluentAvalonia.UI.Controls.Primitives"
                    xmlns:icons="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
                    xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
                    xmlns:behaviors="clr-namespace:SkEditor.Behaviors"
                    x:CompileBindings="True">

    <Design.PreviewWith>
        <Border Padding="50">
            <StackPanel Spacing="4">
                <uip:FANavigationViewItemPresenter Content="Hello" IconSource="Save" />
            </StackPanel>
        </Border>
    </Design.PreviewWith>

    <ControlTheme x:Key="{x:Type ui:FANavigationView}" TargetType="ui:FANavigationView">
        <!--<Setter Property="KeyboardNavigation.IsTabStop" Value="False" />-->
        <Setter Property="CompactPaneLength" Value="{DynamicResource NavigationViewCompactPaneLength}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Name="RootGrid">

                    <!--Button grid-->
                    <Grid Name="PaneToggleButtonGrid"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top"
                          ZIndex="100"
                          RowDefinitions="Auto,Auto">

                        <Rectangle Name="TogglePaneTopPadding"
                                   Height="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.TopPadding}" />

                        <Panel Name="ButtonHolderGrid"
                               Margin="{DynamicResource NavigationViewButtonHolderGridMargin}" Grid.Row="1">

                            <Button Name="NavigationViewBackButton"
                                    Theme="{StaticResource NavigationBackButtonNormalStyle}"
                                    VerticalAlignment="Top"
                                    IsVisible="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.BackButtonVisibility}"
                                    IsEnabled="{TemplateBinding IsBackEnabled}"
                                    ToolTip.Tip="Go Back" />

                            <Button Name="NavigationViewCloseButton"
                                    Theme="{StaticResource NavigationBackButtonNormalStyle}"
                                    VerticalAlignment="Top"
                                    ToolTip.Tip="Close Navigation" />

                            <Button Name="TogglePaneButton"
                                    Theme="{StaticResource PaneToggleButtonStyle}"
                                    HorizontalAlignment="Center"
                                    IsVisible="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.PaneToggleButtonVisibility}"
                                    MinWidth="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.SmallerPaneToggleButtonWidth}">
                                <TextBlock Name="PaneTitleTextBlock"
                                           Margin="0 -2 0 0"
                                           Text="{TemplateBinding PaneTitle}"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           FontFamily="{DynamicResource ContentControlThemeFontFamily}"
                                           Theme="{StaticResource NavigationViewItemHeaderTextStyle}" />
                            </Button>
                            <Panel Name="PaneTitleHolder" IsVisible="False" Height="40">
                                <ContentControl Name="PaneTitlePresenter"
                                                Margin="{DynamicResource NavigationViewPaneTitlePresenterMargin}"
                                                KeyboardNavigation.IsTabStop="True"
                                                HorizontalContentAlignment="Stretch"
                                                VerticalContentAlignment="Stretch" />
                            </Panel>

                        </Panel>

                    </Grid>

                    <!--Content layouts-->
                    <Grid RowDefinitions="Auto,*">

                        <!--DisplayMode top-->
                        <StackPanel Name="TopNavArea"
                                    Background="{DynamicResource NavigationViewTopPaneBackground}"
                                    Grid.Row="0"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Top"
                                    ZIndex="1">
                            <Rectangle Name="TopNavTopPadding"
                                       Height="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.TopPadding}"
                                       IsVisible="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.TopPaneVisibility}" />

                            <Border BorderBrush="{DynamicResource NavigationViewItemSeparatorForeground}"
                                    Margin="{DynamicResource TopNavigationViewTopNavGridMargin}">
                                <Grid Name="TopNavGrid"
                                      Height="{DynamicResource NavigationViewTopPaneHeight}"
                                      IsVisible="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.TopPaneVisibility}">

                                    <Grid.ColumnDefinitions>
                                        <!--x:Name="BackButtonPlaceholderOnTopNav"-->
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*"
                                                          MinWidth="{DynamicResource TopNavigationViewPaneCustomContentMinWidth}" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- In Avalonia, we can't change Grid ColumnDefinition in styles,
                                    which we need to do for TopNav BackButtonPlaceHolder. As alternative,
                                    we'll place a rectangle here, and set the column to Auto, and adjust
                                    the rect's width as needed -->
                                    <Rectangle Name="BackButtonPlaceholderOnTopNav"
                                               IsHitTestVisible="False"
                                               Width="{DynamicResource NavigationBackButtonWidth}" />

                                    <Rectangle Name="TopNavLeftPadding"
                                               Grid.Column="1"
                                               Width="0" />

                                    <ContentControl Name="PaneHeaderOnTopPane"
                                                    KeyboardNavigation.IsTabStop="True"
                                                    VerticalContentAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch"
                                                    Grid.Column="2" Width="0" />

                                    <ContentControl Name="PaneTitleOnTopPane"
                                                    KeyboardNavigation.IsTabStop="True"
                                                    VerticalContentAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch"
                                                    Grid.Column="2"
                                                    Margin="{DynamicResource NavigationViewItemInnerHeaderMargin}"
                                                    IsVisible="{Binding $self.Content, Converter={x:Static ObjectConverters.IsNotNull}}" />

                                    <ScrollViewer Grid.Column="3"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Disabled">
                                        <Interaction.Behaviors>
                                            <behaviors:VerticalScrollViewerAnimatedBehavior />
                                        </Interaction.Behaviors>
                                        <ui:FAItemsRepeater Name="TopNavMenuItemsHost">
                                            <ui:FAItemsRepeater.Layout>
                                                <ui:FAStackLayout Orientation="Horizontal" />
                                            </ui:FAItemsRepeater.Layout>
                                        </ui:FAItemsRepeater>
                                    </ScrollViewer>

                                    <Button Name="TopNavOverflowButton"
                                            Grid.Column="4"
                                            Content="More"
                                            Margin="{DynamicResource TopNavigationViewOverflowButtonMargin}"
                                            Theme="{StaticResource NavigationViewOverflowButtonStyleWhenPaneOnTop}"
                                            IsVisible="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.OverflowButtonVisibility}">
                                        <Button.Styles>
                                            <Style Selector="FlyoutPresenter">
                                                <Setter Property="Theme" Value="{StaticResource NavViewFlyoutStyle}" />
                                            </Style>
                                        </Button.Styles>
                                        <Button.Flyout>
                                            <Flyout Placement="BottomEdgeAlignedRight"
                                                    FlyoutPresenterClasses="NavViewFlyoutStyle">
                                                <ui:FAItemsRepeater Name="TopNavMenuItemsOverflowHost">
                                                    <ui:FAItemsRepeater.Layout>
                                                        <ui:FAStackLayout />
                                                    </ui:FAItemsRepeater.Layout>
                                                </ui:FAItemsRepeater>
                                            </Flyout>
                                        </Button.Flyout>

                                    </Button>

                                    <ContentControl Name="PaneCustomContentOnTopPane"
                                                    KeyboardNavigation.IsTabStop="True"
                                                    VerticalContentAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch"
                                                    Grid.Column="5" />

                                    <Panel Name="TopPaneAutoSuggestArea"
                                           Height="{DynamicResource NavigationViewTopPaneHeight}"
                                           Grid.Column="6">
                                        <ContentControl Name="TopPaneAutoSuggestBoxPresenter"
                                                        Margin="{DynamicResource TopNavigationViewAutoSuggestBoxMargin}"
                                                        MinWidth="216"
                                                        KeyboardNavigation.IsTabStop="True"
                                                        HorizontalContentAlignment="Stretch"
                                                        VerticalContentAlignment="Center" />
                                    </Panel>

                                    <ContentControl Name="PaneFooterOnTopPane"
                                                    KeyboardNavigation.IsTabStop="True"
                                                    VerticalContentAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch"
                                                    Grid.Column="7" />

                                    <ui:FAItemsRepeater Grid.Column="8"
                                                        Name="TopFooterMenuItemsHost">
                                        <ui:FAItemsRepeater.Layout>
                                            <ui:FAStackLayout Orientation="Horizontal" />
                                        </ui:FAItemsRepeater.Layout>
                                    </ui:FAItemsRepeater>
                                </Grid>
                            </Border>

                            <Border Name="TopNavContentOverlayAreaGrid"
                                    Child="{TemplateBinding ContentOverlay}" />
                        </StackPanel>

                        <!--Displaymode (compact/minimal/normal) left-->
                        <SplitView Name="RootSplitView"
                                   Background="{TemplateBinding Background}"
                                   CompactPaneLength="{TemplateBinding CompactPaneLength}"
                                   DisplayMode="Inline"
                                   IsPaneOpen="{TemplateBinding IsPaneOpen, Mode=TwoWay}"
                                   KeyboardNavigation.IsTabStop="False"
                                   OpenPaneLength="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.OpenPaneWidth}"
                                   Grid.Row="1"
                                   PaneBackground="{DynamicResource NavigationViewDefaultPaneBackground}"
                                   BorderBrush="{DynamicResource NavigationViewItemSeparatorForeground}"
                                   BorderThickness="{DynamicResource NavigationViewBorderThickness}"
                                   CornerRadius="{Binding Source={StaticResource OverlayCornerRadius}, Converter={StaticResource RightCornerRadiusFilterConverter}}">

                            <SplitView.Pane>
                                <Grid Name="PaneContentGrid"
                                      Margin="{DynamicResource NavigationViewPaneContentGridMargin}"
                                      HorizontalAlignment="Left"
                                      IsVisible="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.LeftPaneVisibility}">

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="0" />
                                        <!--above button margin + back button space-->
                                        <!--x:Name="PaneContentGridToggleButtonRow"
                                             Removed & set only in TogglePaneButtonVisible VisualState...TODO
                                             MinHeight="{StaticResource NavigationViewPaneHeaderRowMinHeight}"-->
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="0" />
                                        <!--above list margin-->
                                        <!--x:Name="ItemsContainerRow"-->
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Rectangle Name="ContentPaneTopPadding"
                                               Height="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.TopPadding}" />

                                    <Grid Grid.Row="2" Name="PlaceholderGrid">
                                        <Grid.ColumnDefinitions>
                                            <!--x:Name="PaneHeaderCloseButtonColumn"-->
                                            <ColumnDefinition />
                                            <!--x:Name="PaneHeaderToggleButtonColumn"-->
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <ContentControl Name="PaneHeaderContentBorder"
                                                        KeyboardNavigation.IsTabStop="True"
                                                        VerticalContentAlignment="Stretch"
                                                        HorizontalContentAlignment="Stretch"
                                                        Grid.Column="2" />
                                    </Grid>

                                    <Panel Name="AutoSuggestArea"
                                           Grid.Row="3"
                                           Height="{DynamicResource NavigationViewAutoSuggestAreaHeight}"
                                           Margin="0 0 0 8"
                                           VerticalAlignment="Center">
                                        <ContentControl Name="PaneAutoSuggestBoxPresenter"
                                                        Margin="{DynamicResource NavigationViewAutoSuggestBoxMargin}"
                                                        KeyboardNavigation.IsTabStop="True"
                                                        HorizontalContentAlignment="Stretch"
                                                        VerticalContentAlignment="Center" />

                                        <Button Name="PaneAutoSuggestButton"
                                                Theme="{StaticResource NavigationViewPaneSearchButtonStyle}"
                                                IsVisible="False"
                                                Width="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.SmallerPaneToggleButtonWidth}" />
                                    </Panel>

                                    <ContentControl Name="PaneCustomContentBorder"
                                                    KeyboardNavigation.IsTabStop="True"
                                                    VerticalContentAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch"
                                                    Grid.Row="4" />

                                    <Rectangle IsHitTestVisible="False"
                                               Height="{DynamicResource NavigationViewPaneHeaderRowMinHeight}"
                                               Grid.Row="2"
                                               Name="PaneContentGridToggleButtonRowHack"
                                               IsVisible="{Binding #TogglePaneButton.IsVisible}" />

                                    <!--"Non header" content-->
                                    <Grid Name="ItemsContainerGrid" Grid.Row="6"
                                          Margin="0 0 0 8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <!-- MenuItems -->
                                            <RowDefinition Height="Auto" />
                                            <!-- Separator if overflow -->
                                            <RowDefinition Height="Auto" />
                                            <!-- PaneFooter -->
                                            <RowDefinition Height="Auto" />
                                            <!-- FooterItems -->
                                        </Grid.RowDefinitions>

                                        <!--MenuItems-->
                                        <ScrollViewer Name="MenuItemsScrollViewer"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Stretch"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      VerticalScrollBarVisibility="Auto">
                                            <Interaction.Behaviors>
                                                <behaviors:VerticalScrollViewerAnimatedBehavior />
                                            </Interaction.Behaviors>
                                            <ui:FAItemsRepeater Name="MenuItemsHost">
                                                <ui:FAItemsRepeater.Layout>
                                                    <ui:FAStackLayout />
                                                </ui:FAItemsRepeater.Layout>
                                            </ui:FAItemsRepeater>
                                        </ScrollViewer>

                                        <ui:FANavigationViewItemSeparator Name="VisualItemsSeparator"
                                                                          Grid.Row="1"
                                                                          Margin="0 0 0 2"
                                                                          VerticalAlignment="Center"
                                                                          HorizontalAlignment="Stretch"
                                                                          IsVisible="False" />

                                        <!--PaneFooter-->
                                        <ContentControl Name="FooterContentBorder"
                                                        KeyboardNavigation.IsTabStop="True"
                                                        VerticalContentAlignment="Stretch"
                                                        HorizontalContentAlignment="Stretch"
                                                        Margin="0 0 0 4"
                                                        Grid.Row="2" />

                                        <!--FooterItems-->
                                        <ScrollViewer Name="FooterItemsScrollViewer"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      Grid.Row="3">
                                            <Interaction.Behaviors>
                                                <behaviors:VerticalScrollViewerAnimatedBehavior />
                                            </Interaction.Behaviors>
                                            <ui:FAItemsRepeater Name="FooterMenuItemsHost">
                                                <ui:FAItemsRepeater.Layout>
                                                    <ui:FAStackLayout />
                                                </ui:FAItemsRepeater.Layout>
                                            </ui:FAItemsRepeater>
                                        </ScrollViewer>

                                    </Grid>
                                </Grid>
                            </SplitView.Pane>

                            <SplitView.Content>

                                <Border Name="ContentGridBorder"
                                        ClipToBounds="True"
                                        Background="{DynamicResource NavigationViewContentBackground}"
                                        BorderBrush="{DynamicResource NavigationViewContentGridBorderBrush}"
                                        BorderThickness="{DynamicResource NavigationViewContentGridBorderThickness}"
                                        Margin="{DynamicResource NavigationViewContentMargin}"
                                        CornerRadius="{DynamicResource NavigationViewContentGridCornerRadius}">
                                    <Grid Name="ContentGrid"
                                          RowDefinitions="Auto,Auto,*"
                                          ColumnDefinitions="Auto,*">

                                        <Rectangle Name="ContentTopPadding"
                                                   Grid.ColumnSpan="2"
                                                   Height="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.TopPadding}"
                                                   IsVisible="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.LeftPaneVisibility}" />

                                        <Rectangle Name="ContentLeftPadding" Grid.Row="1" />

                                        <ContentControl Name="HeaderContent"
                                                        Grid.Row="1"
                                                        Grid.Column="1"
                                                        MinHeight="{StaticResource PaneToggleButtonHeight}"
                                                        KeyboardNavigation.IsTabStop="True"
                                                        Content="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Header}"
                                                        ContentTemplate="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=HeaderTemplate}"
                                                        VerticalContentAlignment="Stretch"
                                                        HorizontalContentAlignment="Stretch"
                                                        Theme="{StaticResource NavigationViewTitleHeaderContentControlTextStyle}" />

                                        <ContentPresenter Grid.Row="2"
                                                          Grid.ColumnSpan="2"
                                                          Content="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Content}"
                                                          ContentTemplate="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ContentTemplate}"
                                                          Margin="{DynamicResource NavigationViewContentPresenterMargin}"
                                                          Name="ContentPresenter" />

                                    </Grid>
                                </Border>


                            </SplitView.Content>

                        </SplitView>

                        <Border Name="ShadowCaster"
                                Grid.RowSpan="2"
                                Width="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.OpenPaneWidth}"
                                HorizontalAlignment="Left"
                                BoxShadow="0 16 32 #17000000">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="00:00:00.35" />
                                </Transitions>
                            </Border.Transitions>
                        </Border>

                    </Grid>

                </Panel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^ /template/ Button#NavigationViewBackButton">
            <Setter Property="Width"
                    Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.SmallerPaneToggleButtonWidth}" />
        </Style>

        <Style Selector="^:minimal">
            <Style Selector="^ /template/ SplitView ContentControl#HeaderContent">
                <Setter Property="Margin" Value="{DynamicResource NavigationViewMinimalHeaderMargin}" />
            </Style>
            <Style Selector="^ /template/ SplitView Border#ContentGridBorder">
                <Setter Property="BorderThickness"
                        Value="{DynamicResource NavigationViewMinimalContentGridBorderThickness}" />
                <Setter Property="CornerRadius" Value="{DynamicResource NavigationViewMinimalContentGridCornerRadius}" />
                <Setter Property="Margin" Value="{DynamicResource NavigationViewMinimalContentMargin}" />
            </Style>
            <Style Selector="^ /template/ Button#NavigationViewBackButton">
                <Setter Property="Theme" Value="{StaticResource NavigationBackButtonSmallStyle}" />
            </Style>
        </Style>

        <Style Selector="^:minimalwithback">
            <Style Selector="^ /template/ SplitView ContentControl#HeaderContent">
                <Setter Property="Margin" Value="{DynamicResource NavigationViewMinimalHeaderMargin}" />
            </Style>
            <Style Selector="^ /template/ SplitView Border#ContentGridBorder">
                <Setter Property="BorderThickness"
                        Value="{DynamicResource NavigationViewMinimalContentGridBorderThickness}" />
                <Setter Property="CornerRadius" Value="{DynamicResource NavigationViewMinimalContentGridCornerRadius}" />
                <Setter Property="Margin" Value="{DynamicResource NavigationViewMinimalContentMargin}" />
            </Style>
            <Style Selector="^ /template/ Button#NavigationViewBackButton">
                <Setter Property="Theme" Value="{StaticResource NavigationBackButtonSmallStyle}" />
            </Style>
        </Style>

        <Style Selector="^:topnavminimal  /template/ SplitView Border#ContentGridBorder">
            <Setter Property="BorderThickness" Value="{DynamicResource TopNavigationViewContentGridBorderThickness}" />
            <Setter Property="CornerRadius" Value="{DynamicResource TopNavigationViewContentGridCornerRadius}" />
            <Setter Property="Margin" Value="{DynamicResource TopNavigationViewContentMargin}" />
        </Style>

        <Style Selector="^:headercollapsed /template/ SplitView ContentControl#HeaderContent">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <Style Selector="^:autosuggestcollapsed">
            <Style Selector="^ /template/ SplitView Panel#AutoSuggestArea">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector="^ /template/ Panel#TopPaneAutoSuggestArea">
                <Setter Property="IsVisible" Value="False" />
            </Style>
        </Style>

        <Style Selector="^:closedcompact">
            <Style Selector="^ /template/ SplitView ContentControl#PaneAutoSuggestBoxPresenter">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector="^ /template/ SplitView Button#PaneAutoSuggestButton">
                <Setter Property="IsVisible" Value="True" />
            </Style>
        </Style>

        <Style Selector="^:listsizecompact">
            <Style Selector="^ /template/ SplitView Grid#PaneContentGrid">
                <Setter Property="Width"
                        Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=CompactPaneLength}" />
            </Style>
            <Style Selector="^ /template/ Button TextBlock#PaneTitleTextBlock">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector="^ /template/ SplitView ContentControl#PaneHeaderContentBorder">
                <Setter Property="IsVisible" Value="False" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>
            <Style Selector="^ /template/ SplitView ContentControl#FooterContentBorder">
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>
        </Style>

        <!-- BackButtonCollapsed...TODO -->
        <Style Selector="^:backbuttoncollapsed /template/ Rectangle#BackButtonPlaceholderOnTopNav">
            <Setter Property="Width" Value="0" />
        </Style>

        <Style Selector="^:panecollapsed">
            <Style Selector="^ /template/ SplitView#RootSplitView">
                <Setter Property="CompactPaneLength" Value="0" />
            </Style>
            <Style Selector="^ /template/ Grid#PaneToggleButtonGrid">
                <Setter Property="IsVisible" Value="False" />
            </Style>
        </Style>

        <Style Selector="^:panenotoverlaying">
            <Style Selector="^ /template/ SplitView#RootSplitView">
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="PaneBackground" Value="{DynamicResource NavigationViewExpandedPaneBackground}" />
            </Style>
            <Style Selector="^ /template/ Border#ShadowCaster">
                <Setter Property="Transitions">
                    <Transitions>
                        <!-- Speed up transition on fade out -->
                        <DoubleTransition Property="Opacity" Duration="00:00:00.12" />
                    </Transitions>
                </Setter>
            </Style>
            <Style Selector="^ /template/ Border#ShadowCaster">
                <Setter Property="Opacity" Value="0" />
            </Style>
        </Style>

        <Style Selector="^:separator /template/ ui|FANavigationViewItemSeparator#VisualItemsSeparator">
            <Setter Property="IsVisible" Value="True" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type uip:FANavigationViewItemPresenter}"
                  TargetType="uip:FANavigationViewItemPresenter">
        <Setter Property="Background" Value="{DynamicResource NavigationViewItemBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NavigationViewItemBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource NavigationViewItemBorderThickness}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="LayoutRoot"
                        MinHeight="{DynamicResource NavigationViewItemOnLeftMinHeight}"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Margin="4,2,4,2"
                        TemplatedControl.IsTemplateFocusTarget="True">

                    <Panel Name="PresenterContentRootGrid">

                        <Panel HorizontalAlignment="Left"
                               VerticalAlignment="Center">

                            <Border Name="SelectionIndicator"
                                    Background="{DynamicResource NavigationViewSelectionIndicatorForeground}"
                                    Opacity="0"
                                    RenderOptions.BitmapInterpolationMode="HighQuality"
                                    RenderOptions.EdgeMode="Aliased"
                                    ClipToBounds="True"
                                    Width="{DynamicResource NavigationViewSelectionIndicatorWidth}"
                                    Height="{DynamicResource NavigationViewSelectionIndicatorHeight}"
                                    CornerRadius="{DynamicResource NavigationViewSelectionIndicatorRadius}" />
                        </Panel>

                        <Grid Name="ContentGrid"
                              MinHeight="{DynamicResource NavigationViewItemOnLeftMinHeight}"
                              HorizontalAlignment="Stretch"
                              ColumnDefinitions="Auto,*,Auto,Auto"
                              Margin="0 0 14 0">
                            <Border Name="IconColumn">
                                <Viewbox Name="IconBox"
                                         Height="{DynamicResource NavigationViewItemOnLeftIconBoxHeight}"
                                         HorizontalAlignment="Center"
                                         Margin="{DynamicResource NavigationViewItemOnLeftIconBoxMargin}">
                                    <ContentPresenter Name="Icon"
                                                      Width="24"
                                                      Content="{Binding TemplateSettings.Icon, RelativeSource={RelativeSource TemplatedParent}}"
                                                      Foreground="{DynamicResource NavigationViewItemForeground}" />
                                </Viewbox>
                            </Border>

                            <ContentPresenter Name="ContentPresenter"
                                              Grid.Column="1"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Content="{TemplateBinding Content}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Padding="{TemplateBinding Padding}"
                                              Margin="{DynamicResource NavigationViewItemContentPresenterMargin}"
                                              Foreground="{DynamicResource NavigationViewItemForeground}" />

                            <Panel Name="ExpandCollapseChevron"
                                   Grid.Column="3"
                                   HorizontalAlignment="Right"
                                   Width="14"
                                   Margin="{DynamicResource NavigationViewItemExpandedChevronMargin}"
                                   Background="Transparent"
                                   IsVisible="False">
                                <Panel.Transitions>
                                    <Transitions>
                                        <TransformOperationsTransition Property="RenderTransform" Duration="00:00:00.1" />
                                    </Transitions>
                                </Panel.Transitions>

                                <icons:SymbolIcon Symbol="ChevronDown"
                                                  FontSize="14"
                                                  Foreground="{DynamicResource NavigationViewItemForeground}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Panel>

                            <ContentPresenter Name="InfoBadgePresenter"
                                              Content="{TemplateBinding InfoBadge}"
                                              IsVisible="False"
                                              Grid.Column="2"
                                              VerticalAlignment="Center" />

                        </Grid>


                    </Panel>

                </Border>
            </ControlTemplate>
        </Setter>

        <!-- Bindings in control templates still apply with local value -->
        <Style Selector="^ /template/ Border#IconColumn">
            <Setter Property="Width"
                    Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.SmallerIconWidth}" />
        </Style>

        <Style Selector="^:pointerover">
            <Style Selector="^ /template/ Border#LayoutRoot">
                <Setter Property="Background" Value="{DynamicResource NavigationViewItemBackgroundPointerOver}" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#Icon">
                <Setter Property="Foreground" Value="{DynamicResource NavigationViewItemForegroundPointerOver}" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#ContentPresenter">
                <Setter Property="Foreground" Value="{DynamicResource NavigationViewItemForegroundPointerOver}" />
            </Style>
        </Style>

        <Style Selector="^:pressed">
            <Style Selector="^ /template/ Border#LayoutRoot">
                <Setter Property="Background" Value="{DynamicResource NavigationViewItemBackgroundPressed}" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#Icon">
                <Setter Property="Foreground" Value="{DynamicResource NavigationViewItemForegroundPressed}" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#ContentPresenter">
                <Setter Property="Foreground" Value="{DynamicResource NavigationViewItemForegroundPressed}" />
            </Style>
        </Style>

        <Style Selector="^:selected">
            <Style Selector="^ /template/ Border#LayoutRoot">
                <Setter Property="Background" Value="{DynamicResource NavigationViewItemBackgroundSelected}" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#Icon">
                <Setter Property="Foreground" Value="{DynamicResource NavigationViewItemForegroundSelected}" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#ContentPresenter">
                <Setter Property="Foreground" Value="{DynamicResource NavigationViewItemForegroundSelected}" />
            </Style>

            <Style Selector="^:pointerover">
                <Style Selector="^ /template/ Border#LayoutRoot">
                    <Setter Property="Background"
                            Value="{DynamicResource NavigationViewItemBackgroundSelectedPointerOver}" />
                </Style>
                <Style Selector="^ /template/ ContentPresenter#Icon">
                    <Setter Property="Foreground"
                            Value="{DynamicResource NavigationViewItemForegroundSelectedPointerOver}" />
                </Style>
                <Style Selector="^ /template/ ContentPresenter#ContentPresenter">
                    <Setter Property="Foreground"
                            Value="{DynamicResource NavigationViewItemForegroundSelectedPointerOver}" />
                </Style>
            </Style>

            <Style Selector="^:pressed">
                <Style Selector="^ /template/ Border#LayoutRoot">
                    <Setter Property="Background" Value="{DynamicResource NavigationViewItemBackgroundSelectedPressed}" />
                </Style>
                <Style Selector="^ /template/ ContentPresenter#Icon">
                    <Setter Property="Foreground" Value="{DynamicResource NavigationViewItemForegroundSelectedPressed}" />
                </Style>
                <Style Selector="^ /template/ ContentPresenter#ContentPresenter">
                    <Setter Property="Foreground" Value="{DynamicResource NavigationViewItemForegroundSelectedPressed}" />
                </Style>
            </Style>
        </Style>

        <Style Selector="^:disabled /template/ Border#LayoutRoot">
            <Setter Property="Opacity" Value="{DynamicResource ListViewItemDisabledThemeOpacity}" />
        </Style>

        <Style Selector="^:iconcollapsed">
            <Style Selector="^ /template/ Viewbox#IconBox">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector="^ /template/ Border#IconColumn">
                <Setter Property="Width" Value="16" />
            </Style>
        </Style>

        <Style Selector="^:chevronopen /template/ Panel#ExpandCollapseChevron">
            <Setter Property="IsVisible" Value="True" />
            <Setter Property="RenderTransform" Value="rotate(180deg)" />
        </Style>

        <!-- :chevronclosed-->
        <Style Selector="^:chevronclosed /template/ Panel#ExpandCollapseChevron">
            <Setter Property="IsVisible" Value="True" />
            <Setter Property="RenderTransform" Value="rotate(0deg)" />
        </Style>

        <Style Selector="^:closedcompacttop">
            <Style Selector="^ /template/ ContentPresenter#ContentPresenter">
                <Setter Property="Margin" Value="{DynamicResource NavigationViewCompactItemContentPresenterMargin}" />
            </Style>
            <Style Selector="^:infobadge /template/ ContentPresenter#InfoBadgePresenter">
                <Setter Property="Grid.Column" Value="0" />
                <Setter Property="Grid.ColumnSpan" Value="4" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="Margin" Value="0 2 2 0" />
            </Style>
        </Style>

        <Style Selector="^:infobadge /template/ ContentPresenter#InfoBadgePresenter">
            <Setter Property="IsVisible" Value="True" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="NavigationViewItemPresenterWhenOnTopPane"
                  TargetType="uip:FANavigationViewItemPresenter"
                  BasedOn="{StaticResource {x:Type uip:FANavigationViewItemPresenter}}">
        <Setter Property="Foreground" Value="{DynamicResource TopNavigationViewItemForeground}" />
        <Setter Property="Template">
            <ControlTemplate>

                <Border Name="LayoutRoot"
                        Background="{TemplateBinding Background}"
                        TemplatedControl.IsTemplateFocusTarget="True">

                    <Panel>
                        <Rectangle Name="PointerRectangle"
                                   Fill="Transparent"
                                   IsVisible="False" />

                        <Grid Name="ContentGrid" ColumnDefinitions="Auto,*,Auto,Auto"
                              Margin="0">
                            <Viewbox Name="IconBox"
                                     Height="18"
                                     Margin="16 0 0 0"
                                     VerticalAlignment="Center"
                                     HorizontalAlignment="Center">
                                <ContentPresenter Name="Icon"
                                                  Width="24"
                                                  Content="{Binding TemplateSettings.Icon, RelativeSource={RelativeSource TemplatedParent}}"
                                                  Foreground="{DynamicResource TopNavigationViewItemForeground}" />
                            </Viewbox>

                            <ContentPresenter Name="ContentPresenter"
                                              Grid.Column="1"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Content="{TemplateBinding Content}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              Margin="{DynamicResource TopNavigationViewItemContentPresenterMargin}"
                                              Foreground="{DynamicResource TopNavigationViewItemForeground}" />

                            <Panel Name="ExpandCollapseChevron"
                                   Grid.Column="2"
                                   HorizontalAlignment="Right"
                                   Width="14"
                                   Background="Transparent"
                                   Margin="{DynamicResource NavigationViewItemExpandedChevronMargin}"
                                   IsVisible="False">
                                <icons:SymbolIcon Symbol="ChevronDown"
                                                  FontSize="14"
                                                  Foreground="{DynamicResource NavigationViewItemForeground}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Panel>

                            <ContentPresenter Name="InfoBadgePresenter"
                                              Content="{TemplateBinding InfoBadge}"
                                              Grid.Column="3"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              Margin="-16 0 2 13" />

                        </Grid>


                        <Panel Name="SelectionIndicatorGrid"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Bottom"
                               Margin="16 0 16 4">

                            <Border Name="SelectionIndicator"
                                    Width="16"
                                    Height="3"
                                    Background="{DynamicResource NavigationViewSelectionIndicatorForeground}"
                                    Opacity="0"
                                    CornerRadius="2" />
                        </Panel>

                    </Panel>

                </Border>

            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover">
            <Style Selector="^ /template/ Rectangle#PointerRectangle">
                <Setter Property="Fill" Value="{DynamicResource NavigationViewItemBackgroundPointerOver}" />
            </Style>
            <Style Selector="^ /template/ Border#LayoutRoot">
                <Setter Property="Background" Value="{DynamicResource TopNavigationViewItemBackgroundPointerOver}" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#Icon">
                <Setter Property="Foreground" Value="{DynamicResource TopNavigationViewItemForegroundPointerOver}" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#ContentPresenter">
                <Setter Property="Foreground" Value="{DynamicResource TopNavigationViewItemForegroundPointerOver}" />
            </Style>
        </Style>
        <Style Selector="^:pressed">
            <Style Selector="^ /template/ Rectangle#PointerRectangle">
                <Setter Property="Fill" Value="{DynamicResource NavigationViewItemBackgroundPressed}" />
            </Style>
            <Style Selector="^ /template/ Border#LayoutRoot">
                <Setter Property="Background" Value="{DynamicResource TopNavigationViewItemBackgroundPressed}" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#Icon">
                <Setter Property="Foreground" Value="{DynamicResource TopNavigationViewItemForegroundPressed}" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#ContentPresenter">
                <Setter Property="Foreground" Value="{DynamicResource TopNavigationViewItemForegroundPressed}" />
            </Style>
        </Style>

        <Style Selector="^:selected">
            <Style Selector="^ /template/ Rectangle#PointerRectangle">
                <Setter Property="Fill" Value="{DynamicResource NavigationViewItemBackgroundSelected}" />
            </Style>
            <Style Selector="^ /template/ Border#LayoutRoot">
                <Setter Property="Background" Value="{DynamicResource TopNavigationViewItemBackgroundSelected}" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#Icon">
                <Setter Property="Foreground" Value="{DynamicResource TopNavigationViewItemForegroundSelected}" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#ContentPresenter">
                <Setter Property="Foreground" Value="{DynamicResource TopNavigationViewItemForegroundSelected}" />
            </Style>

            <Style Selector="^:pointerover">
                <Style Selector="^ /template/ Rectangle#PointerRectangle">
                    <Setter Property="Fill" Value="{DynamicResource NavigationViewItemBackgroundSelectedPointerOver}" />
                </Style>
                <Style Selector="^ /template/ Border#LayoutRoot">
                    <Setter Property="Background" Value="{DynamicResource TopNavigationViewItemBackgroundPointerOver}" />
                </Style>
                <Style Selector="^ /template/ ContentPresenter#Icon">
                    <Setter Property="Foreground"
                            Value="{DynamicResource TopNavigationViewItemForegroundSelectedPointerOver}" />
                </Style>
                <Style Selector="^ /template/ ContentPresenter#ContentPresenter">
                    <Setter Property="Foreground"
                            Value="{DynamicResource TopNavigationViewItemForegroundSelectedPointerOver}" />
                </Style>
            </Style>

            <Style Selector="^:pressed">
                <Style Selector="^ /template/ Rectangle#PointerRectangle">
                    <Setter Property="Fill" Value="{DynamicResource NavigationViewItemBackgroundSelectedPressed}" />
                </Style>
                <Style Selector="^ /template/ Border#LayoutRoot">
                    <Setter Property="Background" Value="{DynamicResource TopNavigationViewItemBackgroundPressed}" />
                </Style>
                <Style Selector="^ /template/ ContentPresenter#Icon">
                    <Setter Property="Foreground"
                            Value="{DynamicResource TopNavigationViewItemForegroundSelectedPressed}" />
                </Style>
                <Style Selector="^ /template/ ContentPresenter#ContentPresenter">
                    <Setter Property="Foreground"
                            Value="{DynamicResource TopNavigationViewItemForegroundSelectedPressed}" />
                </Style>
            </Style>
        </Style>

        <Style Selector="^:disabled">
            <Style Selector="^ /template/ ContentPresenter#Icon">
                <Setter Property="Foreground" Value="{DynamicResource TopNavigationViewItemForegroundDisabled}" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#ContentPresenter">
                <Setter Property="Foreground" Value="{DynamicResource TopNavigationViewItemForegroundDisabled}" />
            </Style>
        </Style>

        <!-- :icononleft -->

        <Style Selector="^:icononly">
            <Style Selector="^ /template/ Border#LayoutRoot">
                <Setter Property="MinWidth" Value="48" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#ContentPresenter">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector="^ /template/ Panel#SelectionIndicatorGrid">
                <Setter Property="Margin" Value="4 0 4 4" />
            </Style>
            <Style Selector="^ /template/ Panel#ExpandCollapseChevron">
                <Setter Property="Margin" Value="{DynamicResource TopNavigationViewItemIconOnlyExpandChevronMargin}" />
            </Style>
        </Style>

        <Style Selector="^:contentonly">
            <Style Selector="^ /template/ Viewbox#IconBox">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#ContentPresenter">
                <Setter Property="Margin"
                        Value="{DynamicResource TopNavigationViewItemContentOnlyContentPresenterMargin}" />
            </Style>
            <Style Selector="^ /template/ Panel#SelectionIndicatorGrid">
                <Setter Property="Margin" Value="12 0 12 4" />
            </Style>
            <Style Selector="^ /template/ Panel#ExpandCollapseChevron">
                <Setter Property="Margin" Value="{DynamicResource TopNavigationViewItemContentOnlyExpandChevronMargin}" />
            </Style>
        </Style>

    </ControlTheme>

    <ControlTheme x:Key="NavigationViewItemPresenterWhenOnTopPaneOverflow"
                  TargetType="uip:FANavigationViewItemPresenter"
                  BasedOn="{StaticResource {x:Type uip:FANavigationViewItemPresenter}}">
        <Setter Property="Foreground" Value="{DynamicResource TopNavigationViewItemForeground}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="LayoutRoot"
                        Height="36"
                        Background="{TemplateBinding Background}"
                        TemplatedControl.IsTemplateFocusTarget="True">

                    <Panel Name="PresenterContentRootGrid">

                        <Panel Margin="4,0,0,0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center">

                            <Border Name="SelectionIndicator"
                                    Width="2"
                                    Height="24"
                                    Background="{DynamicResource NavigationViewSelectionIndicatorForeground}"
                                    Opacity="0"
                                    CornerRadius="{DynamicResource ControlCornerRadius}" />
                        </Panel>

                        <Grid Name="ContentGrid"
                              ColumnDefinitions="Auto,*,Auto,Auto"
                              Margin="0 0 14 0">
                            <Viewbox Name="IconBox"
                                     Height="16"
                                     Width="16"
                                     Margin="16,0,0,0"
                                     VerticalAlignment="Center"
                                     HorizontalAlignment="Center">
                                <ContentPresenter Name="Icon"
                                                  Width="24"
                                                  Content="{Binding TemplateSettings.Icon, RelativeSource={RelativeSource TemplatedParent}}"
                                                  Foreground="{DynamicResource TopNavigationViewItemForeground}" />
                            </Viewbox>

                            <ContentPresenter Name="ContentPresenter"
                                              Grid.Column="1"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Content="{TemplateBinding Content}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              Padding="{TemplateBinding Padding}"
                                              Margin="{DynamicResource TopNavigationViewItemOnOverflowContentPresenterMargin}"
                                              Foreground="{DynamicResource TopNavigationViewItemForeground}" />

                            <Panel Name="ExpandCollapseChevron"
                                   Grid.Column="3"
                                   HorizontalAlignment="Right"
                                   Width="14"
                                   Margin="{DynamicResource TopNavigationViewItemOnOverflowExpandChevronMargin}"
                                   Background="Transparent"
                                   IsVisible="False">
                                <icons:SymbolIcon Symbol="ChevronDown"
                                                  FontSize="14"
                                                  Foreground="{DynamicResource NavigationViewItemForeground}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Panel>

                            <ContentPresenter Name="InfoBadgePresenter"
                                              Grid.Column="2"
                                              VerticalAlignment="Center" />

                        </Grid>
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover">
            <Style Selector="^ /template/ Border#LayoutRoot">
                <Setter Property="Background" Value="{DynamicResource NavigationViewItemBackgroundPointerOver}" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#Icon">
                <Setter Property="Foreground" Value="{DynamicResource NavigationViewItemForegroundPointerOver}" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#ContentPresenter">
                <Setter Property="Foreground" Value="{DynamicResource NavigationViewItemForegroundPointerOver}" />
            </Style>
        </Style>

        <Style Selector="^:pressed">
            <Style Selector="^ /template/ Border#LayoutRoot">
                <Setter Property="Background" Value="{DynamicResource NavigationViewItemBackgroundPressed}" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#Icon">
                <Setter Property="Foreground" Value="{DynamicResource NavigationViewItemForegroundPressed}" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#ContentPresenter">
                <Setter Property="Foreground" Value="{DynamicResource NavigationViewItemForegroundPressed}" />
            </Style>
        </Style>

        <Style Selector="^:selected">
            <Style Selector="^ /template/ Border#LayoutRoot">
                <Setter Property="Background" Value="{DynamicResource NavigationViewItemBackgroundSelected}" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#Icon">
                <Setter Property="Foreground" Value="{DynamicResource NavigationViewItemForegroundSelected}" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#ContentPresenter">
                <Setter Property="Foreground" Value="{DynamicResource NavigationViewItemForegroundSelected}" />
            </Style>

            <Style Selector="^:pointerover">
                <Style Selector="^ /template/ Border#LayoutRoot">
                    <Setter Property="Background"
                            Value="{DynamicResource NavigationViewItemBackgroundSelectedPointerOver}" />
                </Style>
                <Style Selector="^ /template/ ContentPresenter#Icon">
                    <Setter Property="Foreground"
                            Value="{DynamicResource NavigationViewItemForegroundSelectedPointerOver}" />
                </Style>
                <Style Selector="^ /template/ ContentPresenter#ContentPresenter">
                    <Setter Property="Foreground"
                            Value="{DynamicResource NavigationViewItemForegroundSelectedPointerOver}" />
                </Style>
            </Style>

            <Style Selector="^:pressed">
                <Style Selector="^ /template/ Border#LayoutRoot">
                    <Setter Property="Background" Value="{DynamicResource NavigationViewItemBackgroundSelectedPressed}" />
                </Style>
                <Style Selector="^ /template/ ContentPresenter#Icon">
                    <Setter Property="Foreground" Value="{DynamicResource NavigationViewItemForegroundSelectedPressed}" />
                </Style>
                <Style Selector="^ /template/ ContentPresenter#ContentPresenter">
                    <Setter Property="Foreground" Value="{DynamicResource NavigationViewItemForegroundSelectedPressed}" />
                </Style>
            </Style>
        </Style>

        <Style Selector="^:disabled">
            <Style Selector="^ /template/ ContentPresenter#Icon">
                <Setter Property="Foreground" Value="{DynamicResource TopNavigationViewItemForegroundDisabled}" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#ContentPresenter">
                <Setter Property="Foreground" Value="{DynamicResource TopNavigationViewItemForegroundDisabled}" />
            </Style>
        </Style>

        <Style Selector="^:contentonly">
            <Style Selector="^ /template/ Viewbox#IconBox">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#ContentPresenter">
                <Setter Property="Margin"
                        Value="{DynamicResource TopNavigationViewItemOnOverflowNoIconContentPresenterMargin}" />
            </Style>
        </Style>
    </ControlTheme>

</ResourceDictionary>