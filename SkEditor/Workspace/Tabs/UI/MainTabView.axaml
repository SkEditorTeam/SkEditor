<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:iconsMarkup="clr-namespace:FluentIcons.Avalonia.Fluent.Markup;assembly=FluentIcons.Avalonia.Fluent"
             xmlns:aConverters="clr-namespace:SkEditor.Appearance.Converters"
             xmlns:localization="clr-namespace:SkEditor.Core.Localization"
             xmlns:common="clr-namespace:SkEditor.Core.Common"
             xmlns:welcome="clr-namespace:SkEditor.Welcome.UI"
             xmlns:vms="clr-namespace:SkEditor.Windowing.UI"
             xmlns:tConverters="clr-namespace:SkEditor.Workspace.Tabs.Converters"
             xmlns:tabs="clr-namespace:SkEditor.Workspace.Tabs"
             xmlns:capabilities="clr-namespace:SkEditor.Workspace.Tabs.Capabilities"
             x:Class="SkEditor.Workspace.Tabs.UI.MainTabView"
             Name="Root"
             x:DataType="vms:MainWindowViewModel">

    <UserControl.Resources>
        <aConverters:BoolToOpacityConverter x:Key="BoolToOpacityConverter" />
        <tConverters:SymbolIconSourceConverter x:Key="SymbolIconSourceConverter" />
        <tConverters:TabIconConverter x:Key="TabIconConverter" />

        <DataTemplate x:Key="SharedTabItemTemplate" x:DataType="tabs:TabViewModelBase">
            <ui:FATabViewItem Content="{Binding .}">
                <ui:FATabViewItem.IconSource>
                    <MultiBinding Converter="{StaticResource TabIconConverter}">
                        <Binding Path="Icon" Converter="{StaticResource SymbolIconSourceConverter}" />
                        <Binding Path="IsLoading" />
                    </MultiBinding>
                </ui:FATabViewItem.IconSource>
                <ui:FATabViewItem.ContextFlyout>
                    <MenuFlyout>
                        <MenuItem Icon="{iconsMarkup:SymbolIcon Symbol=Dismiss}"
                                  Header="{localization:Translate MenuHeaderClose}"
                                  Command="{Binding #Root.((vms:MainWindowViewModel)DataContext)?.CloseTabCommand}"
                                  CommandParameter="{Binding .}" />

                        <Separator IsVisible="{Binding HasPath, FallbackValue=False}"
                                   x:DataType="capabilities:IFileTab" />

                        <MenuItem Icon="{iconsMarkup:SymbolIcon Symbol=FolderOpen}"
                                  IsVisible="{Binding HasPath, FallbackValue=False}"
                                  Header="{localization:Translate MenuHeaderOpenInExplorer}"
                                  x:DataType="capabilities:IFileTab"
                                  Command="{Binding OpenInExplorerRelayCommand}" />

                        <Separator IsVisible="{Binding ., Converter={common:IsType capabilities:IFileTab}}" />

                        <MenuItem Icon="{iconsMarkup:SymbolIcon Symbol=Clipboard}"
                                  IsVisible="{Binding ., Converter={common:IsType capabilities:IFileTab}}"
                                  Header="{localization:Translate MenuHeaderCopyFileName}"
                                  x:DataType="capabilities:IFileTab"
                                  Command="{Binding CopyNameRelayCommand}" />

                        <MenuItem Icon="{iconsMarkup:SymbolIcon Symbol=ClipboardLink}"
                                  IsVisible="{Binding HasPath, FallbackValue=False}"
                                  Header="{localization:Translate MenuHeaderCopyAbsolutePath}"
                                  x:DataType="capabilities:IFileTab"
                                  Command="{Binding CopyPathRelayCommand}" />
                    </MenuFlyout>
                </ui:FATabViewItem.ContextFlyout>
                <ui:FATabViewItem.Header>
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Panel Grid.Column="0"
                               IsVisible="{Binding IsLoading}"
                               Width="16" Height="16"
                               Margin="0,0,8,0">
                            <ui:FAProgressRing Width="14" Height="14"
                                               IsIndeterminate="True"
                                               BorderThickness="1.5"
                                               Foreground="{Binding $parent[ContentPresenter].Foreground}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                        </Panel>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding Header.Value}"
                                   ToolTip.ServiceEnabled="{Binding ToolTip, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0">
                            <ToolTip.Tip>
                                <ToolTip MaxWidth="1000">
                                    <TextBlock Text="{Binding ToolTip}" FontWeight="Normal" TextWrapping="NoWrap"
                                               TextTrimming="None"
                                               ClipToBounds="False" />
                                </ToolTip>
                            </ToolTip.Tip>
                        </TextBlock>

                        <Ellipse Grid.Column="2"
                                 Classes.unsaved="{Binding !IsSaved}"
                                 Width="4" Height="4"
                                 Fill="{Binding $parent[ContentPresenter].Foreground}"
                                 VerticalAlignment="Center"
                                 RenderTransformOrigin="50%,50%">
                            <Ellipse.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut" />
                                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18"
                                                                   Easing="BackEaseOut" />
                                </Transitions>
                            </Ellipse.Transitions>

                            <Ellipse.Styles>
                                <Style Selector="Ellipse">
                                    <Setter Property="Opacity" Value="0" />
                                    <Setter Property="RenderTransform" Value="scale(0)" />
                                </Style>

                                <Style Selector="Ellipse.unsaved">
                                    <Setter Property="Opacity" Value="1" />
                                    <Setter Property="RenderTransform" Value="scale(1)" />
                                </Style>
                            </Ellipse.Styles>
                        </Ellipse>
                    </Grid>
                </ui:FATabViewItem.Header>
                <Interaction.Behaviors>
                    <ui:FATabViewItemCloseRequestedEventCommandTrigger
                        Command="{Binding #Root.((vms:MainWindowViewModel)DataContext)?.CloseTabCommand}"
                        Parameter="{Binding .}" />
                </Interaction.Behaviors>
            </ui:FATabViewItem>
        </DataTemplate>
    </UserControl.Resources>

    <Panel VerticalAlignment="Stretch">
        <Grid Name="TabGrid" IsVisible="{Binding !!MainTabs.Count}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition MinWidth="300" Width="*" />
                <ColumnDefinition Width="0" />
                <ColumnDefinition MinWidth="0" Width="0" />
            </Grid.ColumnDefinitions>

            <ui:FATabView Grid.Column="0"
                          Name="TabView"
                          Opacity="{Binding !!MainTabs.Count, Converter={StaticResource BoolToOpacityConverter}}"
                          IsHitTestVisible="{Binding !!MainTabs.Count}"
                          Margin="0,-10,0,0" CanDragTabs="True" AllowDropTabs="True"
                          CanReorderTabs="True" VerticalAlignment="Stretch"
                          TabItemsSource="{Binding MainTabs}"
                          SelectedItem="{Binding SelectedMainTab, Mode=TwoWay}"
                          TabItemTemplate="{StaticResource SharedTabItemTemplate}"
                          CornerRadius="7" ClipToBounds="True"
                          AddTabButtonCommand="{Binding NewTabCommand}" />

            <GridSplitter Name="Splitter" Grid.Column="1" Width="8" Background="Transparent"
                          ResizeDirection="Columns" Margin="8,0"
                          IsVisible="{Binding IsSplitActive}" />

            <Border IsHitTestVisible="False" Grid.Column="1" Width="1" Margin="0,8" VerticalAlignment="Stretch"
                    Background="{DynamicResource SkEditorBorderBackground}" IsVisible="{Binding IsSplitActive}" />

            <ui:FATabView Grid.Column="2"
                          Name="SplitTabView"
                          IsVisible="{Binding IsSplitActive}"
                          Margin="0,-10,0,0" CanDragTabs="True" AllowDropTabs="True"
                          CanReorderTabs="True" VerticalAlignment="Stretch"
                          TabItemsSource="{Binding SplitTabs}"
                          SelectedItem="{Binding SelectedSplitTab, Mode=TwoWay}"
                          TabItemTemplate="{StaticResource SharedTabItemTemplate}"
                          CornerRadius="7" ClipToBounds="True"
                          AddTabButtonCommand="{Binding NewTabCommand}" />
        </Grid>

        <welcome:WelcomePage VerticalAlignment="Stretch" DataContext="{Binding WelcomePage}"
                           IsVisible="{Binding !$parent[vms:MainWindow].((vms:MainWindowViewModel)DataContext)?.AnyTabsOpen, TargetNullValue=True}" />
    </Panel>
</UserControl>