<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sty="using:FluentAvalonia.Styling"
             xmlns:localization="clr-namespace:SkEditor.Utilities.Localization"
             xmlns:converters="clr-namespace:SkEditor.Converters"
             xmlns:assets="clr-namespace:SkEditor.Assets"
             xmlns:dialogs="clr-namespace:SkEditor.Models.Dialogs.Elements"
             x:Class="SkEditor.App"
             x:CompileBindings="True"
             RequestedThemeVariant="Dark">

    <Application.Styles>
        <sty:FluentAvaloniaTheme />
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
        <StyleInclude Source="/Styles/ButtonStyles.axaml" />
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://SkEditor/Styles/CustomMenuItemStyle.axaml" />
                <ResourceInclude Source="avares://SkEditor/Styles/ToggleSwitchStyle.axaml" />
                <ResourceInclude Source="avares://SkEditor/Styles/OnlyCloseButtonWindow.axaml" />
                <ResourceInclude Source="avares://SkEditor/Styles/SearchBoxStyles.axaml" />
                <ResourceInclude Source="avares://SkEditor/Styles/DialogStyles.axaml" />
                <ResourceInclude Source="avares://SkEditor/Styles/SearchPanelStyles.axaml" />
                <ResourceInclude Source="avares://SkEditor/Styles/FileTreeViewStyles.axaml" />
                <ResourceInclude Source="avares://SkEditor/Styles/NotificationStyles.axaml" />
                <ResourceInclude Source="avares://SkEditor/Styles/InfoBarStyles.axaml" />
                <ResourceInclude Source="avares://SkEditor/Styles/TabViewItemStyles.axaml" />
                <ResourceInclude Source="avares://SkEditor/Styles/TaskDialogStyles.axaml" />
                <ResourceInclude Source="avares://SkEditor/Styles/LiteComboBoxStyles.axaml" />
                <ResourceInclude Source="avares://SkEditor/Styles/ComboBoxStyles.axaml" />
                <ResourceInclude Source="avares://SkEditor/Styles/NumericUpDownStyles.axaml" />
                <ResourceInclude Source="avares://SkEditor/Styles/NavigationViewStyles.axaml" />
                <ResourceInclude Source="avares://SkEditor/Styles/SettingsExpanderItemStyles.axaml" />
                <ResourceInclude Source="avares://SkEditor/Assets/Icons.axaml" />
                <ResourceInclude Source="avares://SkEditor/Assets/ThemeColors.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>

        <SKPictureImage x:Key="SkEditorLogo" Source="{x:Static assets:SkEditorLogo.Picture}" />

        <converters:TranslationConverter x:Key="TranslationConverter" />

        <Brush x:Key="BackgroundColor">#1f1f1f</Brush>
        <Brush x:Key="TitleBarBackground">#00000000</Brush>
        <Brush x:Key="MainWindowGridBackground">#00000000</Brush>
        <Brush x:Key="SmallWindowBackgroundColor">#1f1f1f</Brush>
        <Brush x:Key="DialogTopBackgroundColor">#121212</Brush>
        <Brush x:Key="DialogTopBorderColor">#75161616</Brush>
        <Brush x:Key="DialogBackgroundColor">#0d0d0d</Brush>
        <Brush x:Key="EditorBackgroundColor">#1b1b1b</Brush>
        <Brush x:Key="EditorTextColor">#cdcaca</Brush>
        <Brush x:Key="LineNumbersColor">#8a8a8a</Brush>
        <Brush x:Key="SelectionColor">#641a6096</Brush>
        <Brush x:Key="TabViewItemHeaderBackgroundSelected">#282828</Brush>
        <Brush x:Key="TabViewSelectedItemBorderBrush">#751c1c1c</Brush>

        <Brush x:Key="MenuFlyoutPresenterBackground">#2c2c2c</Brush>
        <Brush x:Key="MenuFlyoutPresenterBorderBrush">#75161616</Brush>
        <Brush x:Key="TextControlBackgroundFocused">#B31E1E1E</Brush>
        <Brush x:Key="TextControlPlaceholderForeground">#33FFFFFF</Brush>
        <Brush x:Key="TextControlPlaceholderForegroundPointerOver">#4DFFFFFF</Brush>

        <Brush x:Key="SkEditorBorderBackground">#0affffff</Brush>
        <Brush x:Key="MessageBoxBackground">#0d0d0d</Brush>

        <Brush x:Key="TextControlPlaceholderForegroundFocused">#26FFFFFF</Brush>
        <Brush x:Key="SearchPanelBackgroundBrush">#161616</Brush>

        <Brush x:Key="CurrentLineBackground">#05FFFFFF</Brush>
        <Brush x:Key="CurrentLineBorder">#0DFFFFFF</Brush>

        <Brush x:Key="SidebarIconForeground">#FFCCCCCC</Brush>
        <Brush x:Key="SidebarIconSelectedForeground">#FFFFB8E0</Brush>

        <Thickness x:Key="FlyoutContentPadding">10</Thickness>

        <FontFamily x:Key="JetBrainsFont">avares://SkEditor/Assets/JetBrainsMono#JetBrains Mono</FontFamily>
        <FontFamily x:Key="MinecraftFont">avares://SkEditor/Assets/MinecraftFont#Minecraft</FontFamily>
    </Application.Resources>

    <Application.DataTemplates>
        <DataTemplate DataType="localization:TranslatableString">
            <TextBlock Text="{Binding Value}" />
        </DataTemplate>
        
        <DataTemplate DataType="{x:Type dialogs:TextDialogElement}">
            <TextBox Text="{Binding Text, Mode=TwoWay}" PlaceholderText="{Binding PlaceholderText}" />
        </DataTemplate>
    </Application.DataTemplates>
</Application>