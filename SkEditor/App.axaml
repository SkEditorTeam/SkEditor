<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sty="using:FluentAvalonia.Styling"
             xmlns:assets="clr-namespace:SkEditor.Assets"
             xmlns:dialogs="clr-namespace:SkEditor.Models.Dialogs.Elements"
             xmlns:behaviors="clr-namespace:SkEditor.Behaviors"
             xmlns:localization="clr-namespace:SkEditor.Utilities.Localization"
             x:Class="SkEditor.App"
             x:CompileBindings="True"
             RequestedThemeVariant="Dark">

    <Application.Styles>
        <sty:FluentAvaloniaTheme />
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
        <StyleInclude Source="avares://SkTerminal/Themes/Generic.axaml" />
        <StyleInclude Source="avares://SkEditor/Styles/MainWindowStyles.axaml" />
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://SkEditor/Styles/AppResources.axaml" />
                <ResourceInclude Source="avares://SkEditor/Styles/CustomMenuItemStyle.axaml" />
                <ResourceInclude Source="avares://SkEditor/Styles/ToggleSwitchStyle.axaml" />
                <ResourceInclude Source="avares://SkEditor/Styles/OnlyCloseButtonWindow.axaml" />
                <ResourceInclude Source="avares://SkEditor/Styles/SearchBoxStyles.axaml" />
                <ResourceInclude Source="avares://SkEditor/Styles/DialogStyles.axaml" />
                <ResourceInclude Source="avares://SkEditor/Styles/SearchPanelStyles.axaml" />
                <ResourceInclude Source="avares://SkEditor/Styles/FileTreeViewStyles.axaml" />
                <ResourceInclude Source="avares://SkEditor/Styles/NotificationStyles.axaml" />
                <ResourceInclude Source="avares://SkEditor/Styles/InfoBarStyles.axaml" />
                <ResourceInclude Source="avares://SkEditor/Styles/TabViewItemStyles.axaml" />
                <ResourceInclude Source="avares://SkEditor/Styles/TabStripStyles.axaml" />
                <ResourceInclude Source="avares://SkEditor/Styles/TaskDialogStyles.axaml" />
                <ResourceInclude Source="avares://SkEditor/Styles/LiteComboBoxStyles.axaml" />
                <ResourceInclude Source="avares://SkEditor/Styles/ComboBoxStyles.axaml" />
                <ResourceInclude Source="avares://SkEditor/Styles/NumericUpDownStyles.axaml" />
                <ResourceInclude Source="avares://SkEditor/Styles/NavigationViewStyles.axaml" />
                <ResourceInclude Source="avares://SkEditor/Styles/SettingsExpanderItemStyles.axaml" />
                <ResourceInclude Source="avares://SkEditor/Styles/TextEditorStyles.axaml" />
                <ResourceInclude Source="avares://SkEditor/Styles/AppWindowStyles.axaml" />
                <ResourceInclude Source="avares://SkEditor/Styles/WindowDrawnDecorations.axaml" />
                <ResourceInclude Source="avares://SkEditor/Styles/ScrollBarStyles.axaml" />
                <ResourceInclude Source="avares://SkEditor/Assets/Icons.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>

        <SKPictureImage x:Key="SkEditorLogo" Source="{x:Static assets:SkEditorLogo.Picture}" />

        <FontFamily x:Key="JetBrainsFont">avares://SkEditor/Assets/Fonts/JetBrainsMono#JetBrains Mono</FontFamily>
        <FontFamily x:Key="MinecraftFont">avares://SkEditor/Assets/Fonts/MinecraftFont#Minecraft</FontFamily>
    </Application.Resources>

    <Application.DataTemplates>
        <DataTemplate DataType="localization:TranslatableString">
            <TextBlock Text="{Binding Value}" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type dialogs:TextDialogElement}">
            <StackPanel Spacing="4">
                <TextBox Text="{Binding Text, Mode=TwoWay}"
                         PlaceholderText="{Binding PlaceholderText}"
                         Classes.error="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <Interaction.Behaviors>
                        <behaviors:FocusOnLoadedBehavior ShouldFocus="{Binding AutoFocus}" />
                    </Interaction.Behaviors>
                </TextBox>
                <TextBlock Text="{Binding ErrorMessage}"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           Foreground="#FFFF99A4"
                           Margin="2,0,0,0"
                           FontSize="12" />
            </StackPanel>
        </DataTemplate>
    </Application.DataTemplates>
</Application>