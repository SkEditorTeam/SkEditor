<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:localization="clr-namespace:SkEditor.Core.Localization"
        xmlns:vm="clr-namespace:SkEditor.Editor.Generators.ViewModels"
        xmlns:converters="clr-namespace:SkEditor.Editor.Generators.Converters"
        xmlns:behaviors="clr-namespace:SkEditor.Appearance.Behaviors"
        xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
        xmlns:input="clr-namespace:Avalonia.Input"
        xmlns:genBehaviors="clr-namespace:SkEditor.Editor.Generators.Behaviors"
        xmlns:ui="clr-namespace:SkEditor.Layout.StatusBar.UI"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="550"
        x:Class="SkEditor.Editor.Generators.UI.GuiGeneratorWindow" Icon="/Assets/SkEditor.ico"
        Title="{localization:Translate WindowTitleGuiGenerator}" Width="900" Height="520"
        CanResize="False" CanMinimize="False" CanMaximize="False"
        x:DataType="vm:GuiGeneratorWindowViewModel"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="Button.minecraft-slot">
            <Setter Property="Theme" Value="{DynamicResource CleanButton}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Background" Value="#10FFFFFF" />
            <Setter Property="BorderBrush" Value="#18FFFFFF" />
        </Style>

        <Style Selector="Button.minecraft-slot:pointerover">
            <Setter Property="Background" Value="#20FFFFFF" />
            <Setter Property="BorderBrush" Value="#45FFFFFF" />
        </Style>

        <Style Selector="Button.minecraft-slot:pressed">
            <Setter Property="Background" Value="#35FFFFFF" />
            <Setter Property="BorderBrush" Value="#60FFFFFF" />
        </Style>

        <Style Selector="Button.minecraft-slot.selected">
            <Setter Property="Background" Value="#20FFFFFF" />
            <Setter Property="BorderBrush">
                <SolidColorBrush Color="{DynamicResource SystemAccentColorLight2}" Opacity="0.8" />
            </Setter>
        </Style>

        <Style Selector="Button.minecraft-slot.selected:pointerover">
            <Setter Property="Background" Value="#24FFFFFF" />
            <Setter Property="BorderBrush">
                <SolidColorBrush Color="{DynamicResource SystemAccentColor}" Opacity="1.0" />
            </Setter>
        </Style>

        <Style Selector="SplitButton /template/ Border#SeparatorBorder">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <Style Selector="SplitButton /template/ Button#PART_SecondaryButton">
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="32" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
          Margin="48,32">
        <Grid RowDefinitions="Auto,*">
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
                <StackPanel Spacing="4">
                    <TextBlock Text="Title" />
                    <TextBox Width="180" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Function name" />
                    <TextBox Width="180" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Rows" />
                    <NumericUpDown Minimum="1" Maximum="6" Value="{Binding Rows}" Width="100" FormatString="0" />
                </StackPanel>
            </StackPanel>

            <ItemsControl Grid.Row="1" ItemsSource="{Binding Slots}" VerticalAlignment="Center"
                          HorizontalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding Columns}" ColumnSpacing="4" RowSpacing="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:SlotViewModel">
                        <Button Width="48"
                                Height="48"
                                Margin="1"
                                Padding="0"
                                Classes.selected="{Binding IsSelected}"
                                Classes="minecraft-slot"
                                genBehaviors:PointerActionBehavior.Command="{Binding $parent[ItemsControl].((vm:GuiGeneratorWindowViewModel)DataContext)?.SlotPointerPressedCommand}">

                            <Interaction.Behaviors>
                                <input:InputElementDoubleTappedEventCommandTrigger
                                    Command="{Binding $parent[ItemsControl].((vm:GuiGeneratorWindowViewModel)DataContext)?.HandleDoubleClickCommand}"
                                    Parameter="{Binding}" />
                            </Interaction.Behaviors>

                            <Panel>
                                <Image Source="{Binding Item?.Image}"
                                       RenderOptions.EdgeMode="Antialias"
                                       Width="32"
                                       Height="32"
                                       IsVisible="{Binding Item, Converter={x:Static ObjectConverters.IsNotNull}}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />

                                <TextBlock Text="{Binding Item?.Amount}"
                                           IsVisible="{Binding Item?.Amount, Converter={x:Static converters:ItemConverters.IsGreaterThanOne}}"
                                           FontFamily="{DynamicResource MinecraftFont}"
                                           FontSize="16"
                                           Foreground="#FFFFFF"
                                           TextOptions.TextRenderingMode="Alias"
                                           UseLayoutRounding="True"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Bottom"
                                           Margin="0,0,-2.5,-3.5">
                                    <TextBlock.Effect>
                                        <DropShadowEffect Color="#3e3e3e"
                                                          BlurRadius="0"
                                                          OffsetX="2"
                                                          OffsetY="2"
                                                          Opacity="1" />
                                    </TextBlock.Effect>
                                </TextBlock>
                            </Panel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <GroupBox Grid.Column="1" VerticalAlignment="Stretch">
            <GroupBox.Header>
                <ui:SkEditorTabStrip Margin="8,0"
                                     SelectedIndex="{Binding CurrentViewMode.Value, Converter={x:Static converters:GuiGeneratorViewConverters.ViewModeToIndex}}">
                    <ui:SkEditorTabStrip.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="16" />
                        </ItemsPanelTemplate>
                    </ui:SkEditorTabStrip.ItemsPanel>
                    <ui:SkEditorTabStrip.Resources>
                        <Thickness x:Key="TabStripContentMargin">0,0,0,8</Thickness>
                    </ui:SkEditorTabStrip.Resources>

                    <ui:SkEditorTabStripItem>
                        <TextBlock Text="Palette" FontSize="12" />
                    </ui:SkEditorTabStripItem>

                    <ui:SkEditorTabStripItem>
                        <TextBlock Text="Properties" FontSize="12" />
                    </ui:SkEditorTabStripItem>
                </ui:SkEditorTabStrip>
            </GroupBox.Header>

            <Panel VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                <Panel
                    IsVisible="{Binding CurrentViewMode.Value, Converter={x:Static converters:GuiGeneratorViewConverters.IsPaletteView}}">
                    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8" Margin="8">
                        <TextBox Grid.Row="0"
                                 PlaceholderText="Search..."
                                 Theme="{DynamicResource SearchBoxTheme}"
                                 Text="{Binding Filter.Value}"
                                 Margin="0,2,0,2" />

                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding Items}"
                                 SelectedItem="{Binding SelectedItem.Value}"
                                 SelectionMode="AlwaysSelected"
                                 Opacity="{Binding !LoadCommand.IsRunning}"
                                 IsHitTestVisible="{Binding !LoadCommand.IsRunning}"
                                 Padding="0,0,12,0" HorizontalAlignment="Stretch"
                                 IsTextSearchEnabled="True">
                            <ListBox.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity"
                                                      Duration="0:0:0.15" />
                                </Transitions>
                            </ListBox.Transitions>
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem" x:DataType="vm:ItemViewModel">
                                    <Setter Property="TextSearch.Text" Value="{Binding Name}" />
                                    <Setter Property="Height" Value="40" />
                                    <Setter Property="Theme"
                                            Value="{DynamicResource NoIndicatorAnimationListBoxItem}" />
                                </Style>

                                <Style Selector="ListBox /template/ ScrollViewer">
                                    <Setter Property="Interaction.Behaviors">
                                        <BehaviorCollection>
                                            <behaviors:SmoothScrollBehavior />
                                        </BehaviorCollection>
                                    </Setter>
                                </Style>
                            </ListBox.Styles>

                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ItemViewModel">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                        <Image Source="{Binding Image}" Width="32" Height="32"
                                               RenderOptions.BitmapInterpolationMode="HighQuality" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                   VerticalAlignment="Center"
                                                   ToolTip.Tip="{Binding Id}" ToolTip.ShowDelay="500" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="6" Margin="0,6,0,0">
                            <SplitButton Grid.Column="0"
                                         Content="Set to slot"
                                         Classes="accent"
                                         HorizontalAlignment="Stretch"
                                         Command="{Binding ApplySelectedItemCommand}">
                                <SplitButton.Flyout>
                                    <MenuFlyout>
                                        <MenuItem Header="Fill all empty slots"
                                                  Command="{Binding SetAllEmptySlotsCommand}" />

                                        <MenuItem Header="Fill background"
                                                  Command="{Binding FillBackgroundCommand}" />
                                    </MenuFlyout>
                                </SplitButton.Flyout>
                            </SplitButton>

                            <SplitButton Grid.Column="1"
                                         Content="Clear"
                                         Command="{Binding ClearSlotCommand}">
                                <SplitButton.Flyout>
                                    <MenuFlyout>
                                        <MenuItem Header="Clear all slots"
                                                  Command="{Binding ClearAllSlotsCommand}" />

                                        <MenuItem Header="Clear background"
                                                  Command="{Binding ClearBackgroundCommand}" />
                                    </MenuFlyout>
                                </SplitButton.Flyout>
                            </SplitButton>
                        </Grid>
                    </Grid>

                    <StackPanel Opacity="{Binding LoadCommand.IsRunning}"
                                IsHitTestVisible="{Binding LoadCommand.IsRunning}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Spacing="16">
                        <StackPanel.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity"
                                                  Duration="0:0:0.15" />
                            </Transitions>
                        </StackPanel.Transitions>

                        <controls:FAProgressRing IsIndeterminate="True"
                                                 Width="32" Height="32"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </StackPanel>
                </Panel>

                <Panel
                    IsVisible="{Binding CurrentViewMode.Value, Converter={x:Static converters:GuiGeneratorViewConverters.IsPropertiesView}}">

                    <StackPanel Opacity="{Binding SelectedSlot?.Item, Converter={x:Static ObjectConverters.IsNull}}"
                                IsHitTestVisible="{Binding SelectedSlot?.Item, Converter={x:Static ObjectConverters.IsNull}}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">

                        <TextBlock Text="No item selected" FontSize="16"
                                   Foreground="{DynamicResource ForegroundSecondaryColor}" />
                    </StackPanel>

                    <StackPanel Spacing="8" Margin="8"
                                Opacity="{Binding SelectedSlot?.Item, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <StackPanel Orientation="Vertical" Spacing="4">
                            <TextBlock Text="Display name" FontSize="14" />
                            <TextBox Text="{Binding SelectedSlot?.Item?.DisplayName, Mode=TwoWay}"
                                     PlaceholderText="{Binding SelectedSlot?.Item?.Name}" />
                        </StackPanel>

                        <StackPanel Orientation="Vertical" Spacing="4">
                            <TextBlock Text="Amount" FontSize="14" />
                            <NumericUpDown Minimum="1" Maximum="64"
                                           Value="{Binding SelectedSlot?.Item?.Amount, Mode=TwoWay}" FormatString="0" />
                        </StackPanel>
                    </StackPanel>
                </Panel>
            </Panel>
        </GroupBox>
    </Grid>
</Window>