<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:localization="clr-namespace:SkEditor.Core.Localization"
        xmlns:ui="clr-namespace:SkEditor.Editor.Generators.UI"
        xmlns:behaviors="clr-namespace:SkEditor.Appearance.Behaviors"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="320"
        x:Class="SkEditor.Editor.Generators.UI.GuiGeneratorWindow" Icon="/Assets/SkEditor.ico"
        Title="{localization:Translate WindowTitleGuiGenerator}" Height="500" Width="1000"
        CanResize="False" CanMinimize="False" CanMaximize="False"
        x:DataType="ui:GuiGeneratorWindowViewModel"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto,*,Auto" Margin="24" RowSpacing="20">
        <TextBox Width="360" PlaceholderText="Search..." Theme="{DynamicResource SearchBoxTheme}"
                 Text="{Binding Filter.Value}" />

        <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem.Value}"
                 SelectionMode="AlwaysSelected" Grid.Row="1" Width="360"
                 Padding="0,0,12,0" IsTextSearchEnabled="True">
            <ListBox.Styles>
                <Style Selector="ListBoxItem" x:DataType="ui:ItemViewModel">
                    <Setter Property="TextSearch.Text" Value="{Binding DisplayName}" />
                    <Setter Property="Height" Value="40" />
                    <Setter Property="Theme" Value="{DynamicResource NoIndicatorAnimationListBoxItem}" />
                </Style>
                
                <Style Selector="ListBox /template/ ScrollViewer">
                    <Setter Property="Interaction.Behaviors">
                        <BehaviorCollection>
                            <behaviors:SmoothScrollBehavior />
                        </BehaviorCollection>
                    </Setter>
                </Style>
            </ListBox.Styles>

            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="ui:ItemViewModel">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Image Source="{Binding Image}" Width="32" Height="32"
                               RenderOptions.BitmapInterpolationMode="HighQuality" />
                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Button Grid.Row="2" Content="Generate" HorizontalAlignment="Right"
                Command="{Binding LoadCommand}" />
    </Grid>
</Window>