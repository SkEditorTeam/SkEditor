<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:localization="clr-namespace:SkEditor.Core.Localization"
        xmlns:vm="clr-namespace:SkEditor.Editor.Generators.ViewModels"
        xmlns:converters="clr-namespace:SkEditor.Editor.Generators.Converters"
        xmlns:behaviors="clr-namespace:SkEditor.Appearance.Behaviors"
        xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="320"
        x:Class="SkEditor.Editor.Generators.UI.GuiGeneratorWindow" Icon="/Assets/SkEditor.ico"
        Title="{localization:Translate WindowTitleGuiGenerator}" Height="550" Width="1000"
        CanResize="False" CanMinimize="False" CanMaximize="False"
        x:DataType="vm:GuiGeneratorWindowViewModel"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="Button.minecraft-slot">
            <Setter Property="Theme" Value="{DynamicResource CleanButton}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Background" Value="#10FFFFFF" />
            <Setter Property="BorderBrush" Value="#18FFFFFF" />
        </Style>

        <Style Selector="Button.minecraft-slot:pointerover">
            <Setter Property="Background" Value="#20FFFFFF" />
            <Setter Property="BorderBrush" Value="#45FFFFFF" />
        </Style>

        <Style Selector="Button.minecraft-slot:pressed">
            <Setter Property="Background" Value="#35FFFFFF" />
            <Setter Property="BorderBrush" Value="#60FFFFFF" />
        </Style>

        <Style Selector="Button.minecraft-slot.selected">
            <Setter Property="Background" Value="#20FFFFFF" />
            <Setter Property="BorderBrush">
                <SolidColorBrush Color="{DynamicResource SystemAccentColorLight2}" Opacity="0.8" />
            </Setter>
        </Style>

        <Style Selector="Button.minecraft-slot.selected:pointerover">
            <Setter Property="Background" Value="#24FFFFFF" />
            <Setter Property="BorderBrush">
                <SolidColorBrush Color="{DynamicResource SystemAccentColor}" Opacity="1.0" />
            </Setter>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="24" RowSpacing="20" VerticalAlignment="Stretch">
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock Text="Title" />
                <TextBox Width="180" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Function name" />
                <TextBox Width="180" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Background item" />
                <Button Content="Select item" Width="180" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Rows" />
                <NumericUpDown Minimum="1" Maximum="6" Value="{Binding Rows}" Width="100" FormatString="0" />
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="32"
              HorizontalAlignment="Center" VerticalAlignment="Center">
            <ItemsControl ItemsSource="{Binding Slots}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding Columns}" ColumnSpacing="4" RowSpacing="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:SlotViewModel">
                        <Button Width="48"
                                Height="48"
                                Margin="1"
                                Padding="0"
                                Command="{Binding $parent[ItemsControl].((vm:GuiGeneratorWindowViewModel)DataContext)?.SelectSlotCommand}"
                                CommandParameter="{Binding}"
                                Classes.selected="{Binding IsSelected}"
                                Classes="minecraft-slot">

                            <Panel>
                                <Image Source="{Binding Item?.Image}"
                                       Width="32"
                                       Height="32"
                                       IsVisible="{Binding Item, Converter={x:Static ObjectConverters.IsNotNull}}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />

                                <TextBlock Text="{Binding Item?.Amount}"
                                           IsVisible="{Binding Item?.Amount, Converter={x:Static converters:ItemConverters.IsGreaterThanOne}}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Bottom"
                                           Margin="0,0,2,1">
                                </TextBlock>
                            </Panel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Grid.Column="1" RowSpacing="6" RowDefinitions="Auto,Auto,*" VerticalAlignment="Stretch">
                <GroupBox Grid.Row="2" Header="Item properties">
                    <Panel VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                        <Grid RowDefinitions="Auto,*" Width="300" Height="286" RowSpacing="4">
                            <TextBox PlaceholderText="Search..." Theme="{DynamicResource SearchBoxTheme}"
                                     Text="{Binding Filter.Value}" Margin="8" />

                            <ListBox Grid.Row="1" ItemsSource="{Binding Items}"
                                     SelectedItem="{Binding SelectedItem.Value}"
                                     SelectionMode="AlwaysSelected"
                                     Opacity="{Binding !LoadCommand.IsRunning}"
                                     IsHitTestVisible="{Binding !LoadCommand.IsRunning}"
                                     Padding="0,0,12,0" IsTextSearchEnabled="True">
                                <ListBox.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Opacity"
                                                          Duration="0:0:0.15" />
                                    </Transitions>
                                </ListBox.Transitions>
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem" x:DataType="vm:ItemViewModel">
                                        <Setter Property="TextSearch.Text" Value="{Binding DisplayName}" />
                                        <Setter Property="Height" Value="40" />
                                        <Setter Property="Theme"
                                                Value="{DynamicResource NoIndicatorAnimationListBoxItem}" />
                                    </Style>

                                    <Style Selector="ListBox /template/ ScrollViewer">
                                        <Setter Property="Interaction.Behaviors">
                                            <BehaviorCollection>
                                                <behaviors:SmoothScrollBehavior />
                                            </BehaviorCollection>
                                        </Setter>
                                    </Style>
                                </ListBox.Styles>

                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ItemViewModel">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                            <Image Source="{Binding Image}" Width="32" Height="32"
                                                   RenderOptions.BitmapInterpolationMode="HighQuality" />
                                            <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                                                       VerticalAlignment="Center"
                                                       ToolTip.Tip="{Binding Id}" ToolTip.ShowDelay="500" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <StackPanel Opacity="{Binding LoadCommand.IsRunning}"
                                    IsHitTestVisible="{Binding LoadCommand.IsRunning}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Spacing="16">

                            <StackPanel.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity"
                                                      Duration="0:0:0.15" />
                                </Transitions>
                            </StackPanel.Transitions>

                            <controls:FAProgressRing IsIndeterminate="True"
                                                     Width="32" Height="32"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </StackPanel>
                    </Panel>
                </GroupBox>
            </Grid>
        </Grid>
    </Grid>
</Window>