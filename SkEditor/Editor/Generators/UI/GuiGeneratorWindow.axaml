<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:localization="clr-namespace:SkEditor.Core.Localization"
        xmlns:vm="clr-namespace:SkEditor.Editor.Generators.ViewModels"
        xmlns:converters="clr-namespace:SkEditor.Editor.Generators.Converters"
        xmlns:behaviors="clr-namespace:SkEditor.Appearance.Behaviors"
        xmlns:layout="clr-namespace:SkEditor.Layout.StatusBar.UI"
        xmlns:ui="clr-namespace:SkEditor.Editor.Generators.UI"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="550"
        x:Class="SkEditor.Editor.Generators.UI.GuiGeneratorWindow" Icon="/Assets/SkEditor.ico"
        Title="{localization:Translate WindowTitleGuiGenerator}" Width="900" Height="540"
        CanResize="False" CanMinimize="False" CanMaximize="False"
        x:DataType="vm:GuiGeneratorViewModel"
        Name="Root"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="Button.minecraft-slot">
            <Setter Property="Theme" Value="{DynamicResource CleanButton}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Background" Value="#10FFFFFF" />
            <Setter Property="BorderBrush" Value="#18FFFFFF" />
        </Style>

        <Style Selector="Button.minecraft-slot:pointerover">
            <Setter Property="Background" Value="#20FFFFFF" />
            <Setter Property="BorderBrush" Value="#45FFFFFF" />
        </Style>

        <Style Selector="Button.minecraft-slot:pressed">
            <Setter Property="Background" Value="#35FFFFFF" />
            <Setter Property="BorderBrush" Value="#60FFFFFF" />
        </Style>

        <Style Selector="Button.minecraft-slot.selected">
            <Setter Property="Background" Value="#20FFFFFF" />
            <Setter Property="BorderBrush">
                <SolidColorBrush Color="{DynamicResource SystemAccentColorLight2}" Opacity="0.8" />
            </Setter>
        </Style>

        <Style Selector="Button.minecraft-slot.selected:pointerover">
            <Setter Property="Background" Value="#24FFFFFF" />
            <Setter Property="BorderBrush">
                <SolidColorBrush Color="{DynamicResource SystemAccentColor}" Opacity="1.0" />
            </Setter>
        </Style>

        <Style Selector="SplitButton /template/ Border#SeparatorBorder">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <Style Selector="SplitButton /template/ Button#PART_SecondaryButton">
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="ListBox /template/ ScrollViewer">
            <Setter Property="Padding" Value="0,0,12,0" />
            <Setter Property="Interaction.Behaviors">
                <BehaviorCollection>
                    <behaviors:SmoothScrollBehavior />
                </BehaviorCollection>
            </Setter>
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="32" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
          Margin="48,24">
        <Grid RowDefinitions="Auto,*,Auto">
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
                <StackPanel Spacing="4">
                    <TextBlock Text="Title" />
                    <TextBox Width="180" Text="{Binding Title.Value}" PlaceholderText="GUI" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Function name" />
                    <TextBox Width="180" Text="{Binding FunctionName.Value}" PlaceholderText="openGui" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Rows" />
                    <NumericUpDown Minimum="1" Maximum="6" Value="{Binding Grid.Rows.Value}" Width="100" FormatString="0" />
                </StackPanel>
            </StackPanel>

            <ui:ItemGridView Grid.Row="1"/>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
                <ComboBox ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}"
                          HorizontalContentAlignment="Center"
                          DisplayMemberBinding="{Binding Name}" MinWidth="100"/>
                
                <Button Content="Generate"
                        Command="{Binding GenerateCommand}" MinWidth="100" />

                <SplitButton Content="Save" Command="{Binding SaveProjectCommand}" MinWidth="100">
                    <SplitButton.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="New project" Command="{Binding NewProjectCommand}" />
                        </MenuFlyout>
                    </SplitButton.Flyout>
                </SplitButton>
            </StackPanel>
        </Grid>

        <GroupBox Grid.Column="1" VerticalAlignment="Stretch">
            <GroupBox.Header>
                <layout:SkEditorTabStrip Margin="8,0"
                                     SelectedIndex="{Binding CurrentViewMode.Value, Converter={x:Static converters:GuiGeneratorViewConverters.ViewModeToIndex}}">
                    <layout:SkEditorTabStrip.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="16" />
                        </ItemsPanelTemplate>
                    </layout:SkEditorTabStrip.ItemsPanel>
                    <layout:SkEditorTabStrip.Resources>
                        <Thickness x:Key="TabStripContentMargin">0,0,0,8</Thickness>
                    </layout:SkEditorTabStrip.Resources>

                    <layout:SkEditorTabStripItem>
                        <TextBlock Text="Palette" FontSize="12" />
                    </layout:SkEditorTabStripItem>

                    <layout:SkEditorTabStripItem>
                        <TextBlock Text="Properties" FontSize="12" />
                    </layout:SkEditorTabStripItem>
                    <layout:SkEditorTabStripItem>
                        <TextBlock Text="Projects" FontSize="12" />
                    </layout:SkEditorTabStripItem>
                </layout:SkEditorTabStrip>
            </GroupBox.Header>

            <Panel VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                <ui:ItemPaletteView DataContext="{Binding}"/>
                <ui:PropertiesView DataContext="{Binding}"/>
                <ui:ProjectsView DataContext="{Binding}"/>
            </Panel>
        </GroupBox>
    </Grid>
</Window>