<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localization="clr-namespace:SkEditor.Core.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SkEditor.Editor.Generators.ViewModels"
             xmlns:behaviors="clr-namespace:SkEditor.Appearance.Behaviors"
             xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SkEditor.Editor.Generators.UI.ItemPaletteView"
             x:DataType="vm:GuiGeneratorViewModel">
    <Panel>
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8" Margin="8">
            <TextBox Grid.Row="0"
                     PlaceholderText="{localization:Translate GuiGeneratorSearch}"
                     Theme="{DynamicResource SearchBoxTheme}"
                     Text="{Binding ItemPalette.Filter.Value}"
                     Margin="0,2,0,2" />

            <ListBox Grid.Row="1"
                     DataContext="{Binding ItemPalette}"
                     ItemsSource="{Binding Items}"
                     SelectedItem="{Binding SelectedItem.Value}"
                     SelectionMode="AlwaysSelected"
                     Opacity="{Binding IsLoaded.Value}"
                     IsHitTestVisible="{Binding IsLoaded.Value}"
                     Margin="0,0,-12,0" HorizontalAlignment="Stretch"
                     ClipToBounds="False"
                     IsTextSearchEnabled="True">
                <ListBox.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity"
                                          Duration="0:0:0.15" />
                    </Transitions>
                </ListBox.Transitions>
                <ListBox.Styles>
                    <Style Selector="ListBoxItem" x:DataType="vm:ItemViewModel">
                        <Setter Property="TextSearch.Text" Value="{Binding Name}" />
                        <Setter Property="Height" Value="40" />
                        <Setter Property="Theme"
                                Value="{DynamicResource NoIndicatorAnimationListBoxItem}" />
                    </Style>

                    <Style Selector="ListBox /template/ ScrollViewer">
                        <Setter Property="Padding" Value="0,0,12,0" />
                        <Setter Property="Interaction.Behaviors">
                            <BehaviorCollection>
                                <behaviors:SmoothScrollBehavior />
                            </BehaviorCollection>
                        </Setter>
                    </Style>
                </ListBox.Styles>

                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ItemViewModel">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Image Source="{Binding Image}" Width="32" Height="32"
                                   RenderOptions.BitmapInterpolationMode="HighQuality" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}"
                                       VerticalAlignment="Center"
                                       ToolTip.Tip="{Binding Id}" ToolTip.ShowDelay="500" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid Grid.Row="2" ColumnDefinitions="*,0.75*" ColumnSpacing="6" Margin="0,6,0,0">
                <SplitButton Grid.Column="0"
                             Content="{localization:Translate GuiGeneratorSetToSlot}"
                             HorizontalAlignment="Stretch"
                             Command="{Binding Grid.ApplySelectedItemCommand}">
                    <SplitButton.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="{localization:Translate GuiGeneratorFillAllEmptySlots}"
                                      Command="{Binding Grid.SetAllEmptySlotsCommand}" />

                            <MenuItem Header="{localization:Translate GuiGeneratorFillBackground}"
                                      Command="{Binding Grid.FillBackgroundCommand}" />
                        </MenuFlyout>
                    </SplitButton.Flyout>
                </SplitButton>

                <SplitButton Grid.Column="1"
                             HorizontalAlignment="Stretch"
                             Content="{localization:Translate ButtonClear}"
                             Command="{Binding Grid.ClearSlotCommand}">
                    <SplitButton.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="{localization:Translate GuiGeneratorClearAllSlots}"
                                      Command="{Binding Grid.ClearAllSlotsCommand}" />

                            <MenuItem Header="{localization:Translate GuiGeneratorClearBackground}"
                                      Command="{Binding Grid.ClearBackgroundCommand}" />
                        </MenuFlyout>
                    </SplitButton.Flyout>
                </SplitButton>
            </Grid>
        </Grid>

        <StackPanel DataContext="{Binding ItemPalette}"
                    Opacity="{Binding LoadCommand.IsRunning}"
                    IsHitTestVisible="{Binding LoadCommand.IsRunning}"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="16">
            
            <StackPanel.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity"
                                      Duration="0:0:0.15" />
                </Transitions>
            </StackPanel.Transitions>

            <controls:FAProgressRing IsIndeterminate="True"
                                     Width="32" Height="32"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </StackPanel>
        
        <StackPanel DataContext="{Binding ItemPalette}"
                    Opacity="{Binding FailedToLoad.Value}"
                    IsHitTestVisible="{Binding FailedToLoad.Value}"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="12">
            
            <StackPanel.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity"
                                      Duration="0:0:0.15" />
                </Transitions>
            </StackPanel.Transitions>

            <TextBlock Text="{localization:Translate GuiGeneratorResourcesDownloadFailedTitle}" FontSize="16"
                       Foreground="{DynamicResource ForegroundSecondaryColor}" TextAlignment="Center" TextWrapping="Wrap" />
            
            <Button Content="{localization:Translate ButtonRetry}" HorizontalAlignment="Center" Command="{Binding LoadCommand}" />
        </StackPanel>
    </Panel>
</UserControl>