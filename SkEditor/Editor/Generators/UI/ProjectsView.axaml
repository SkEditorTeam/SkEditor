<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:input="clr-namespace:Avalonia.Input"
             xmlns:vm="clr-namespace:SkEditor.Editor.Generators.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SkEditor.Editor.Generators.UI.ProjectsView"
             x:DataType="vm:GuiProjectsViewModel"
             Name="Root">
    <Panel>
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8" Margin="8">
            <TextBox Grid.Row="0"
                     PlaceholderText="Search..."
                     Text="{Binding Filter.Value, Mode=TwoWay}"
                     Theme="{DynamicResource SearchBoxTheme}"
                     Margin="0,2,0,2" />

            <Panel Grid.Row="1">
                <ListBox
                    Opacity="{Binding !!Projects.Count}"
                    IsHitTestVisible="{Binding !!Projects.Count}"
                    SelectionMode="AlwaysSelected"
                    ItemsSource="{Binding Projects}"
                    SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                    Margin="0,0,-12,0" HorizontalAlignment="Stretch"
                    ClipToBounds="False"
                    IsTextSearchEnabled="True">

                    <ListBox.Styles>
                        <Style Selector="ListBoxItem" x:DataType="vm:GuiProjectItemViewModel">
                            <Setter Property="TextSearch.Text" Value="{Binding Name}" />
                            <Setter Property="Height" Value="40" />
                            <Setter Property="Theme"
                                    Value="{DynamicResource NoIndicatorAnimationListBoxItem}" />
                            <Setter Property="Interaction.Behaviors">
                                <BehaviorCollectionTemplate>
                                    <BehaviorCollection>
                                        <input:InputElementDoubleTappedEventCommandTrigger
                                            Command="{Binding #Root.((vm:GuiProjectsViewModel)DataContext)?.LoadProjectCommand}"
                                            Parameter="{Binding}" />
                                    </BehaviorCollection>
                                </BehaviorCollectionTemplate>
                            </Setter>
                        </Style>
                    </ListBox.Styles>

                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:GuiProjectItemViewModel">
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Text="{Binding Name}"
                                           VerticalAlignment="Center" />

                                <Ellipse Grid.Column="1" Width="8" Height="8"
                                         Opacity="{Binding IsActive}"
                                         HorizontalAlignment="Right"
                                         Fill="{DynamicResource SystemAccentColorLight2}">
                                    <Ellipse.Transitions>
                                        <Transitions>
                                            <DoubleTransition Property="Opacity" Duration="0:0:0.2"
                                                              Easing="CubicEaseOut" />
                                        </Transitions>
                                    </Ellipse.Transitions>
                                </Ellipse>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Opacity="{Binding !Projects.Count}"
                            IsHitTestVisible="{Binding !Projects.Count}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Spacing="16">

                    <TextBlock Text="No projects found" FontSize="16"
                               Foreground="{DynamicResource ForegroundSecondaryColor}" />
                </StackPanel>
            </Panel>

            <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="6" Margin="0,6,0,0" IsEnabled="{Binding SelectedProject, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Button Grid.Column="0"
                        Content="Load"
                        HorizontalAlignment="Stretch"
                        Command="{Binding LoadProjectCommand}" />

                <SplitButton Grid.Column="1"
                             Content="Rename"
                             HorizontalAlignment="Stretch"
                             Command="{Binding RenameProjectCommand}">
                    <SplitButton.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="Delete" Command="{Binding DeleteProjectCommand}" />
                            <!-- <MenuItem Header="Export to file" /> -->
                        </MenuFlyout>
                    </SplitButton.Flyout>
                </SplitButton>
            </Grid>
        </Grid>
    </Panel>
</UserControl>