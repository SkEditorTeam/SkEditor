<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:avaloniaEdit="https://github.com/avaloniaui/avaloniaedit"
             xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:iconsMarkup="clr-namespace:FluentIcons.Avalonia.Fluent.Markup;assembly=FluentIcons.Avalonia.Fluent"
             xmlns:localization1="clr-namespace:SkEditor.Core.Localization"
             xmlns:tabs1="clr-namespace:SkEditor.Editor.UI.Tabs"
             xmlns:converters="clr-namespace:SkEditor.Editor.UI.Converters"
             xmlns:ui="clr-namespace:SkEditor.Editor.UI"
             xmlns:markers="clr-namespace:SkEditor.Editor.Markers"
             mc:Ignorable="d" d:DesignWidth="800"
             x:CompileBindings="True"
             x:DataType="tabs1:FileTabViewModel"
             x:Class="SkEditor.Editor.UI.Tabs.FileTabView">

    <UserControl.Resources>
        <converters:EditorFontFamilyConverter x:Key="EditorFontFamilyConverter" />
        <converters:EditorFontFeaturesConverter x:Key="EditorFontFeaturesConverter" />
    </UserControl.Resources>

    <Panel>
        <avaloniaEdit:TextEditor x:Name="Editor"
                                 Opacity="{Binding !IsLoading}"
                                 IsHitTestVisible="{Binding !IsLoading}"
                                 Focusable="{Binding !IsLoading}"
                                 Document="{Binding Document}"
                                 ShowLineNumbers="True"
                                 Foreground="{DynamicResource EditorTextColor}"
                                 Background="{DynamicResource EditorBackgroundColor}"
                                 LineNumbersForeground="{DynamicResource LineNumbersColor}"
                                 FontSize="{Binding FontSize}"
                                 WordWrap="{Binding WordWrap.Value}"
                                 ScrollOffset="{Binding ScrollOffset, Mode=TwoWay}"
                                 CaretOffset="{Binding CaretOffset, Mode=TwoWay}"
                                 FontFamily="{Binding AppSettings.EditorFontFamily, Converter={StaticResource EditorFontFamilyConverter}}"
                                 FontFeatures="{Binding AppSettings.IsFontLigaturesEnabled, Converter={StaticResource EditorFontFeaturesConverter}}">
            <Interaction.Behaviors>
                <ui:TextEditorLoadBehavior />
            </Interaction.Behaviors>
            <avaloniaEdit:TextEditor.ContextFlyout>
                <MenuFlyout>
                    <MenuItem Icon="{iconsMarkup:SymbolIcon Symbol=Cut}"
                              Header="{localization1:Translate MenuHeaderCut}"
                              Command="{Binding CutCommand}"
                              InputGesture="Ctrl+X" />

                    <MenuItem Icon="{iconsMarkup:SymbolIcon Symbol=Copy}"
                              Header="{localization1:Translate MenuHeaderCopy}"
                              Command="{Binding CopyCommand}"
                              InputGesture="Ctrl+C" />

                    <MenuItem Icon="{iconsMarkup:SymbolIcon Symbol=ClipboardPaste}"
                              Header="{localization1:Translate MenuHeaderPaste}"
                              Command="{Binding PasteCommand}"
                              InputGesture="Ctrl+V" />

                    <Separator />

                    <MenuItem Icon="{iconsMarkup:SymbolIcon Symbol=SelectAllOn}"
                              Header="{localization1:Translate MenuHeaderSelectAll}"
                              Command="{Binding SelectAllCommand}"
                              InputGesture="Ctrl+A" />

                    <Separator />

                    <MenuItem Icon="{iconsMarkup:SymbolIcon Symbol=Search}"
                              Header="{localization1:Translate MenuHeaderFind}"
                              Command="{Binding FindCommand}"
                              InputGesture="Ctrl+F" />

                    <MenuItem Icon="{iconsMarkup:SymbolIcon Symbol=ArrowSwap}"
                              Header="{localization1:Translate MenuHeaderReplace}"
                              Command="{Binding ReplaceCommand}"
                              InputGesture="Ctrl+H" />


                    <Separator />
                    <MenuItem Icon="{iconsMarkup:SymbolIcon Symbol=Comment}"
                              Header="{localization1:Translate MenuHeaderComment}"
                              Command="{Binding CommentCommand}"
                              InputGesture="Ctrl+OemQuestion" />
                </MenuFlyout>
            </avaloniaEdit:TextEditor.ContextFlyout>
            <avaloniaEdit:TextEditor.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity"
                                      Duration="0:0:0.2"
                                      Easing="CubicEaseOut" />
                </Transitions>
            </avaloniaEdit:TextEditor.Transitions>
            <avaloniaEdit:TextEditor.Styles>
                <Style Selector="avaloniaEdit|TextEditor[IsHitTestVisible=False]">
                    <Setter Property="RenderTransform" Value="translateY(10px)" />
                </Style>
                <Style Selector="avaloniaEdit|TextEditor[IsHitTestVisible=True]">
                    <Setter Property="RenderTransform" Value="translateY(0px)" />
                    <Setter Property="Transitions">
                        <Transitions>
                            <TransformOperationsTransition Property="RenderTransform"
                                                           Duration="0:0:0.2"
                                                           Easing="CubicEaseOut" />
                        </Transitions>
                    </Setter>
                </Style>
                <Style Selector="avaloniaEdit|TextEditor avaloniaEdit|TextArea">
                    <Setter Property="Focusable"
                            Value="{Binding IsHitTestVisible, RelativeSource={RelativeSource AncestorType=avaloniaEdit:TextEditor}}" />
                </Style>
            </avaloniaEdit:TextEditor.Styles>
        </avaloniaEdit:TextEditor>

        <markers:ErrorMarkerBar HorizontalAlignment="Right"
                               Editor="{Binding #Editor}"
                               IsHitTestVisible="False"
                               Diagnostics="{Binding Diagnostics}">
            <markers:ErrorMarkerBar.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="Experiments.AnalyzerEnabled" />
                    <Binding Path="Experiments.AnalyzerErrorScrollMarkersEnabled" />
                </MultiBinding>
            </markers:ErrorMarkerBar.IsVisible>
        </markers:ErrorMarkerBar>

        <StackPanel Opacity="{Binding IsLoading}"
                    IsHitTestVisible="{Binding IsLoading}"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="16">

            <StackPanel.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity"
                                      Duration="0:0:0.15" />
                </Transitions>
            </StackPanel.Transitions>

            <controls:FAProgressRing IsIndeterminate="True"
                                     Width="32" Height="32"
                                     HorizontalAlignment="Center" />

            <TextBlock Text="{localization1:Translate FileExplorerLoading}"
                       FontSize="18"
                       HorizontalAlignment="Center" />
        </StackPanel>
    </Panel>
</UserControl>