<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SkEditor.Editor.UI.Controls.AnalyzerTooltipView"
             IsHitTestVisible="True" Cursor="Arrow"
             Name="Root" MaxWidth="350">
    <Border Background="{DynamicResource MenuFlyoutPresenterBackground}" BorderThickness="1"
            BorderBrush="{DynamicResource MenuFlyoutPresenterBorderBrush}"
            Padding="12,8" CornerRadius="7">
        <TextBlock FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource ForegroundColor}"
                   Text="{Binding #Root.Diagnostic?.Message}" />
    </Border>
</UserControl>