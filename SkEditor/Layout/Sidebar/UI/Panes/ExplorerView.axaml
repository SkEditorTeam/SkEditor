<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:localization="clr-namespace:SkEditor.Core.Localization"
             xmlns:panes="clr-namespace:SkEditor.Layout.Sidebar.UI.Panes"
             xmlns:tree="clr-namespace:SkEditor.Workspace.UI.Tree"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="panes:ExplorerViewModel"
             x:Class="SkEditor.Layout.Sidebar.UI.Panes.ExplorerView">

    <UserControl.Styles>
        <Style Selector="tree|FileTreeView TextBlock">
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*" Margin="4,8,4,8">
        <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="12"
                    IsVisible="{Binding !FileTree.RootItems.Count}">
            <Viewbox Height="60" Opacity="0.5">
                <controls:FAIconSourceElement IconSource="{StaticResource FolderDismissIcon}"
                                              HorizontalAlignment="Center" />
            </Viewbox>
            <StackPanel Spacing="12">
                <StackPanel Spacing="4">
                    <TextBlock Text="{localization:Translate FileExplorerNoFolderOpenedTitle}"
                               HorizontalAlignment="Center" FontSize="18" Opacity="0.75" />

                    <TextBlock Text="{localization:Translate FileExplorerNoFolderOpenedMessage}"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               FontSize="13" MaxWidth="220" Opacity="0.6" Margin="0,0,0,8" />
                </StackPanel>

                <Button HorizontalAlignment="Center" Content="{localization:Translate ButtonOpenFolder}"
                        Command="{Binding OpenFolderCommand}" />
            </StackPanel>
        </StackPanel>

        <tree:FileTreeView Grid.Row="1" DataContext="{Binding FileTree}"
                               IsVisible="{Binding !!RootItems.Count}" />
    </Grid>
</UserControl>