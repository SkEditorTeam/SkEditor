<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="using:FluentIcons.Avalonia.Fluent"
             xmlns:ui="clr-namespace:SkEditor.Layout.Menu.UI"
             xmlns:converters="clr-namespace:SkEditor.Layout.Menu.Converters"
             xmlns:menu="clr-namespace:SkEditor.Layout.Menu.Models"
             x:DataType="ui:MainMenuViewModel"
             x:Class="SkEditor.Layout.Menu.UI.MainMenuControl">

    <UserControl.Styles>
        <Style Selector="icons|SymbolIcon">
            <Setter Property="FontSize" Value="18.5" />
        </Style>

        <Style Selector="Menu">
            <Setter Property="Height" Value="40" />
        </Style>
    </UserControl.Styles>

    <UserControl.Resources>
        <converters:SymbolIconConverter x:Key="SymbolIconConverter" />
        <converters:MenuHeaderConverter x:Key="MenuHeaderConverter" />
        <converters:KeyGestureConverter x:Key="KeyGestureConverter" />
    </UserControl.Resources>


    <Menu Name="MainMenu" ItemsSource="{Binding Items}">
        <Menu.Styles>
            <Style Selector="Menu MenuItem" x:DataType="menu:MainMenuItem">
                <Setter Property="IsVisible" Value="{Binding IsVisible.Value}" />
                <Setter Property="IsEnabled" Value="{Binding IsEnabled.Value}" />
                <Setter Property="Command" Value="{Binding Command}" />
                <Setter Property="ItemsSource" Value="{Binding SubItems}" />
                <Setter Property="InputGesture"
                        Value="{Binding InputGestureText, Converter={StaticResource KeyGestureConverter}}" />
                <Setter Property="Header">
                    <Setter.Value>
                        <MultiBinding Converter="{StaticResource MenuHeaderConverter}">
                            <Binding Path="Header?.Value" />
                            <Binding Path="IconSymbol" />
                            <Binding Path="IsSeparator" />
                        </MultiBinding>
                    </Setter.Value>
                </Setter>
                <Setter Property="Icon" Value="{Binding IconSymbol, Converter={StaticResource SymbolIconConverter}}" />
                <Setter Property="ToolTip.ServiceEnabled"
                        Value="{Binding Tooltip, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <Setter Property="ToolTip.Tip">
                    <Template>
                        <ToolTip MaxWidth="1000">
                            <TextBlock Text="{Binding Tooltip}" FontWeight="Normal" TextWrapping="NoWrap"
                                       TextTrimming="None"
                                       ClipToBounds="False" />
                        </ToolTip>
                    </Template>
                </Setter>

                <Setter Property="ToolTip.ShowDelay" Value="1000" />
                <Setter Property="ToolTip.Placement" Value="Right" />
            </Style>
            <Style Selector="Menu MenuItem:disabled icons|SymbolIcon">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabled}" />
            </Style>
            <Style Selector="Menu MenuItem AccessText">
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="MaxWidth" Value="250" />
            </Style>
        </Menu.Styles>
    </Menu>
</UserControl>