<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fluent="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
             xmlns:ui="clr-namespace:SkEditor.Layout.StatusBar.UI"
             xmlns:abstractions="clr-namespace:SkEditor.Layout.StatusBar.UI.Abstractions"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="ui:BottomDrawerViewModel"
             x:Class="SkEditor.Layout.StatusBar.UI.BottomDrawer">
    <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
            Background="{DynamicResource SkEditorBorderBackground}"
            CornerRadius="7" Padding="10">

        <Grid RowDefinitions="Auto,*" RowSpacing="8">
            <Border Background="{DynamicResource SkEditorBorderBackground}" CornerRadius="7" Height="36">
                <Grid ColumnDefinitions="*, Auto,Auto">
                    <ui:SkEditorTabStrip Grid.Column="0" Padding="16,8,8,0"
                                               ItemsSource="{Binding VisibleItems}"
                                               SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
                        <ui:SkEditorTabStrip.ItemTemplate>
                            <DataTemplate x:DataType="abstractions:IDrawerPaneViewModel">
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ui:SkEditorTabStrip.ItemTemplate>
                    </ui:SkEditorTabStrip>
                    <ContentControl Grid.Column="1"
                                    Content="{Binding SelectedItem?.Toolbar}"
                                    VerticalAlignment="Center" />

                    <Button Grid.Column="2" Theme="{DynamicResource ToolbarButton}" VerticalAlignment="Center"
                            Command="{Binding CloseDrawerCommand}" Margin="0,0,8,0" ToolTip.Tip="Close">
                        <Viewbox Height="14">
                            <fluent:SymbolIcon Symbol="Subtract" />
                        </Viewbox>
                    </Button>
                </Grid>
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding SelectedItem}" />
        </Grid>
    </Border>
</UserControl>