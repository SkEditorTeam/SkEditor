<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:terminal="clr-namespace:SkEditor.ViewModels.Controls.StatusBar.Panes.Terminal"
             xmlns:fluent="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
             xmlns:localization="clr-namespace:SkEditor.Utilities.Localization"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SkEditor.Views.Controls.StatusBar.Panes.TerminalToolbarView"
             x:DataType="terminal:TerminalToolbarViewModel"
             Name="Root">
    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,8,0">
        <Button Theme="{DynamicResource ToolbarButton}" VerticalAlignment="Center"
                Command="{Binding ClearCommand}"
                ToolTip.Tip="{localization:Translate BottomDrawerTerminalToolbarClear}">
            <fluent:SymbolIcon Symbol="Delete" FontSize="14" />
        </Button>
        <Button Theme="{DynamicResource ToolbarButton}" VerticalAlignment="Center"
                Command="{Binding ResetCommand}"
                ToolTip.Tip="{localization:Translate BottomDrawerTerminalToolbarRestart}">
            <fluent:SymbolIcon Symbol="ArrowClockwise" FontSize="14" />
        </Button>
    </StackPanel>
</UserControl>