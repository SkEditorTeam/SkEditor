<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:icons="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
             xmlns:behaviors1="clr-namespace:SkEditor.Appearance.Behaviors"
             xmlns:localization1="clr-namespace:SkEditor.Core.Localization"
             xmlns:logs="clr-namespace:SkEditor.Layout.StatusBar.UI.Panes.Logs"
             xmlns:converters1="clr-namespace:SkEditor.Layout.StatusBar.UI.Panes.Logs.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SkEditor.Layout.StatusBar.UI.Panes.Logs.LogsPaneView"
             x:DataType="logs:LogsPaneViewModel"
             Name="Root">

    <UserControl.Resources>
        <converters1:LogLevelColorConverter x:Key="LogLevelColorConverter" />
        <converters1:LogLevelMessageColorConverter x:Key="LogLevelMessageColorConverter" />
        <converters1:LogLevelSymbolConverter x:Key="LogLevelSymbolConverter" />
    </UserControl.Resources>

    <Border>
        <Panel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0" Padding="12,12,20,12">
                <Interaction.Behaviors>
                    <BehaviorCollection>
                        <behaviors1:SmoothScrollBehavior />
                        <AutoScrollToBottomBehavior />
                    </BehaviorCollection>
                </Interaction.Behaviors>
                <SelectableTextBlock logs:LogInlinesBehavior.Logs="{Binding FilteredLogs}"
                                     FontFeatures="-liga,-calt,-clig"
                                     FontSize="12"
                                     Foreground="{DynamicResource ForegroundSecondaryColor}"
                                     SelectionBrush="{DynamicResource SelectionColor}"
                                     FontWeight="Normal"
                                     TextWrapping="Wrap"
                                     ContextFlyout="{x:Null}"
                                     ContextMenu="{x:Null}"
                                     FontFamily="{DynamicResource JetBrainsFont}" />
            </ScrollViewer>

            <StackPanel VerticalAlignment="Center" Spacing="6" IsVisible="{Binding !FilteredLogs.Count}">
                <icons:SymbolIcon Symbol="WeatherSqualls" FontSize="32" Opacity="0.5" HorizontalAlignment="Center" />
                <TextBlock Text="{localization1:Translate BottomDrawerLogsNoLogs}"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap"
                           FontSize="12" MaxWidth="300" Opacity="0.6" />
            </StackPanel>
        </Panel>

        <Border.Styles>
            <Style Selector="Border">
                <Setter Property="Background" Value="#05FFFFFF" />
                <Setter Property="BorderBrush" Value="#10FFFFFF" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="7" />
                <Setter Property="Transitions">
                    <Transitions>
                        <BrushTransition Property="Background" Duration="0:0:0.1" />
                        <BrushTransition Property="BorderBrush" Duration="0:0:0.1" />
                    </Transitions>
                </Setter>
            </Style>
        </Border.Styles>
    </Border>
</UserControl>