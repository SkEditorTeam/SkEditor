<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:icons="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
             xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:models="clr-namespace:SkEditor.Analyzing.Models"
             xmlns:behaviors1="clr-namespace:SkEditor.Appearance.Behaviors"
             xmlns:localization1="clr-namespace:SkEditor.Core.Localization"
             xmlns:errors="clr-namespace:SkEditor.Layout.StatusBar.UI.Panes.Errors"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SkEditor.Layout.StatusBar.UI.Panes.Errors.ErrorListPaneView"
             Name="Root"
             x:DataType="errors:ErrorListPaneViewModel">
    <Grid RowDefinitions="Auto,*" Margin="8,2,0,0">
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                      Margin="0,0,-6,0">
            <Interaction.Behaviors>
                <BehaviorCollection>
                    <behaviors1:SmoothScrollBehavior />
                </BehaviorCollection>
            </Interaction.Behaviors>
            <Panel>
                <ItemsControl ItemsSource="{Binding Errors}" Margin="0,0,14,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <errors:DrawerErrorEntry x:DataType="models:AnalyzerError"
                                                        ErrorMessage="{Binding Message}"
                                                        ErrorType="{Binding Type}" ErrorLine="{Binding Line}"
                                                        ErrorSource=""
                                                        ErrorClickCommand="{Binding #Root.((errors:ErrorListPaneViewModel)DataContext)?.ErrorClickCommand}"
                                                        ErrorClickCommandParameter="{Binding .}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel VerticalAlignment="Center" Spacing="6">
                    <StackPanel.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="IsAnalyzerLoaded.Value" />
                            <Binding Path="IsFileAnalyzable.Value" />
                            <Binding Path="!Errors.Count" />
                        </MultiBinding>
                    </StackPanel.IsVisible>
                    <icons:SymbolIcon Symbol="WeatherSqualls" FontSize="32" Opacity="0.5" HorizontalAlignment="Center" />
                    <StackPanel Spacing="2">
                        <TextBlock Text="{localization1:Translate BottomDrawerErrorListNoProblems}"
                                   HorizontalAlignment="Center" FontSize="16" Opacity="0.75" />
                        <TextBlock Text="{localization1:Translate BottomDrawerErrorListNoProblemsDescription}"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   FontSize="12" MaxWidth="300" Opacity="0.6" />
                    </StackPanel>
                </StackPanel>

                <StackPanel VerticalAlignment="Center" Spacing="6">
                    <StackPanel.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="IsAnalyzerLoaded.Value" />
                            <Binding Path="!IsFileAnalyzable.Value" />
                        </MultiBinding>
                    </StackPanel.IsVisible>
                    <icons:SymbolIcon Symbol="WeatherSqualls" FontSize="32" Opacity="0.5" HorizontalAlignment="Center" />
                    <TextBlock Text="{localization1:Translate BottomDrawerErrorListNoSkriptFileOpened}"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap"
                               FontSize="12" MaxWidth="300" Opacity="0.6" />
                </StackPanel>

                <StackPanel VerticalAlignment="Center" Spacing="6"
                            IsVisible="{Binding !IsAnalyzerLoaded.Value}">
                    <ui:FAProgressRing IsIndeterminate="True"
                                       BorderThickness="1.5"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                    <TextBlock Text="{localization1:Translate BottomDrawerErrorListLoading}"
                               HorizontalAlignment="Center" FontSize="16" Opacity="0.75" />
                </StackPanel>
            </Panel>
        </ScrollViewer>
    </Grid>
</UserControl>