<Project Sdk="WixToolset.Sdk/6.0.0">
    <PropertyGroup>
        <OutputName Condition="'$(IsAot)' == 'true'">SkEditor-AOT</OutputName>
        <OutputName Condition="'$(IsAot)' != 'true'">SkEditor</OutputName>
        <DefineConstants>PublishDir=$(PublishDir)</DefineConstants>

        <PlatformTarget>x64</PlatformTarget>
        <InstallerPlatform>x64</InstallerPlatform>

        <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="Assets\Info.ico"/>
        <Content Include="Assets\Warning.ico"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="WixToolset.UI.wixext" Version="7.0.0" />
    </ItemGroup>
</Project>