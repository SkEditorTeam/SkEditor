<Project Sdk="WixToolset.Sdk/7.0.0">
    <PropertyGroup>
        <OutputName Condition="'$(IsAot)' == 'true'">SkEditor-AOT</OutputName>
        <OutputName Condition="'$(IsAot)' != 'true'">SkEditor</OutputName>

        <PublishDir Condition="'$(PublishDir)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\SkEditor\bin\Release\net10.0\win-x64\publish'))</PublishDir>

        <CleanPublishDir>$([System.String]::Copy('$(PublishDir)').TrimEnd('\'))</CleanPublishDir>
        <DefineConstants>$(DefineConstants);PublishDir=$(CleanPublishDir)</DefineConstants>

        <PlatformTarget>x64</PlatformTarget>
        <InstallerPlatform>x64</InstallerPlatform>
        <AcceptEula>wix7</AcceptEula>
        <Platform Condition="'$(Platform)' == ''">x64</Platform>
    </PropertyGroup>

    <ItemGroup>
        <BindPath Include="$(CleanPublishDir)" BindName="PublishDir" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="Assets\Info.ico"/>
        <Content Include="Assets\Warning.ico"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="WixToolset.UI.wixext" Version="7.0.0" />
    </ItemGroup>
</Project>